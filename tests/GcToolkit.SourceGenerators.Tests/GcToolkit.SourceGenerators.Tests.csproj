<Project Sdk="MSTest.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Plain reference (NOT OutputItemType=Analyzer): we instantiate ToolDiscoveryGenerator
         directly and drive it with CSharpGeneratorDriver, so it must not also run as an
         analyzer on this test project. -->
    <ProjectReference Include="..\..\src\GcToolkit.SourceGenerators\GcToolkit.SourceGenerators.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="MSTest.TestAdapter" Version="4.2.3" />
    <PackageReference Update="MSTest.TestFramework" Version="4.2.3" />
    <!-- Roslyn driver for running the generator over in-memory referenced compilations. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
  </ItemGroup>

</Project>
