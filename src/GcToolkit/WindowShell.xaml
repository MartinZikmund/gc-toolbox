<Page
    x:Class="GcToolkit.WindowShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GcToolkit.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:markup="using:GcToolkit.Markup"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:not_win="http://uno.ui/not_win"
    xmlns:toolkit="using:Uno.UI.Toolkit"
    xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d not_win">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!--  Pane identity: the selected item is a brand-tinted pill with a brand selection indicator.  -->
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="NavigationViewItemBackgroundSelected" ResourceKey="BrandPrimarySoftBrush" />
                    <StaticResource x:Key="NavigationViewItemBackgroundSelectedPointerOver" ResourceKey="BrandPrimarySoftBrush" />
                    <StaticResource x:Key="NavigationViewItemBackgroundSelectedPressed" ResourceKey="BrandPrimarySoftBrush" />
                    <StaticResource x:Key="NavigationViewItemForegroundSelected" ResourceKey="BrandOnPrimarySoftBrush" />
                    <StaticResource x:Key="NavigationViewItemForegroundSelectedPointerOver" ResourceKey="BrandOnPrimarySoftBrush" />
                    <StaticResource x:Key="NavigationViewItemForegroundSelectedPressed" ResourceKey="BrandOnPrimarySoftBrush" />
                    <StaticResource x:Key="NavigationViewSelectionIndicatorForeground" ResourceKey="BrandPrimaryBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <StaticResource x:Key="NavigationViewItemBackgroundSelected" ResourceKey="BrandPrimarySoftBrush" />
                    <StaticResource x:Key="NavigationViewItemBackgroundSelectedPointerOver" ResourceKey="BrandPrimarySoftBrush" />
                    <StaticResource x:Key="NavigationViewItemBackgroundSelectedPressed" ResourceKey="BrandPrimarySoftBrush" />
                    <StaticResource x:Key="NavigationViewItemForegroundSelected" ResourceKey="BrandOnPrimarySoftBrush" />
                    <StaticResource x:Key="NavigationViewItemForegroundSelectedPointerOver" ResourceKey="BrandOnPrimarySoftBrush" />
                    <StaticResource x:Key="NavigationViewItemForegroundSelectedPressed" ResourceKey="BrandOnPrimarySoftBrush" />
                    <StaticResource x:Key="NavigationViewSelectionIndicatorForeground" ResourceKey="BrandPrimaryBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="PaneSoonChipStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource BrandPrimarySoftBrush}" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid toolkit:VisibleBoundsPadding.PaddingMask="All">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Windows: WinUI TitleBar control hosting catalog search (FR-018). Replaces the hand-rolled title bar.  -->
        <win:TitleBar
            x:Name="AppTitleBar"
            Title="{markup:Localize Key=ApplicationName}"
            Grid.Row="0">
            <win:TitleBar.IconSource>
                <BitmapIconSource ShowAsMonochrome="False" UriSource="ms-appx:///Assets/Icons/icon_foreground.png" />
            </win:TitleBar.IconSource>
            <win:TitleBar.Content>
                <AutoSuggestBox
                    MaxWidth="520"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{markup:Localize Key=SearchPlaceholder}"
                    PlaceholderText="{markup:Localize Key=SearchPlaceholder}"
                    QueryIcon="Find"
                    Text="{x:Bind Search.Query, Mode=TwoWay}" />
            </win:TitleBar.Content>
        </win:TitleBar>

        <!--  NavigationView  -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            BackRequested="NavView_BackRequested"
            CompactModeThresholdWidth="640"
            CompactPaneLength="48"
            ExpandedModeThresholdWidth="1008"
            IsBackButtonVisible="Auto"
            IsBackEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="False"
            Loaded="NavView_Loaded"
            OpenPaneLength="280"
            PaneDisplayMode="Auto"
            SelectionChanged="NavView_SelectionChanged">

            <!--  Non-Windows heads host search in the NavigationView (FR-018). On Windows it lives in the TitleBar above.  -->
            <not_win:NavigationView.AutoSuggestBox>
                <AutoSuggestBox
                    AutomationProperties.Name="{markup:Localize Key=SearchPlaceholder}"
                    PlaceholderText="{markup:Localize Key=SearchPlaceholder}"
                    QueryIcon="Find"
                    Text="{x:Bind Search.Query, Mode=TwoWay}" />
            </not_win:NavigationView.AutoSuggestBox>

            <!--  Task-first sections. Categories and the promoted Field section are appended by BuildToolNavigation.  -->
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="HomeNavItem"
                    Content="{markup:Localize Key=Home}"
                    Tag="Home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!--  Map and Caches are placeholders: present so navigation never has to be restructured when they land.  -->
                <NavigationViewItem
                    x:Name="MapNavItem"
                    AutomationProperties.Name="{markup:Localize Key=Map}"
                    IsEnabled="False"
                    ToolTipService.ToolTip="{markup:Localize Key=ComingSoon}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </NavigationViewItem.Icon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock VerticalAlignment="Center" Text="{markup:Localize Key=Map}" />
                        <Border Style="{StaticResource PaneSoonChipStyle}">
                            <TextBlock
                                Foreground="{ThemeResource BrandOnPrimarySoftBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{markup:Localize Key=ComingSoon}" />
                        </Border>
                    </StackPanel>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="CachesNavItem"
                    AutomationProperties.Name="{markup:Localize Key=Caches}"
                    IsEnabled="False"
                    ToolTipService.ToolTip="{markup:Localize Key=ComingSoon}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D5;" />
                    </NavigationViewItem.Icon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock VerticalAlignment="Center" Text="{markup:Localize Key=Caches}" />
                        <Border Style="{StaticResource PaneSoonChipStyle}">
                            <TextBlock
                                Foreground="{ThemeResource BrandOnPrimarySoftBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{markup:Localize Key=ComingSoon}" />
                        </Border>
                    </StackPanel>
                </NavigationViewItem>

                <!--  Invoking Tools opens the unscoped catalog; the chevron reveals the categories nested under it.  -->
                <NavigationViewItem
                    x:Name="ToolsNavItem"
                    Content="{markup:Localize Key=Tools}"
                    Tag="Catalog">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItemSeparator />
                <NavigationViewItem
                    x:Name="SettingsNavItem"
                    Content="{markup:Localize Key=Settings}"
                    Tag="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="InnerFrame" />
        </NavigationView>

        <!--  Dev-channel indicator overlay. See AppEnvironment + DevChannelBadge.  -->
        <controls:DevChannelBadge Grid.RowSpan="2" />
    </Grid>
</Page>
