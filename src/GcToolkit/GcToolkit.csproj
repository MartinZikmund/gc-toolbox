<Project Sdk="Uno.Sdk">
    <PropertyGroup>
        <TargetFrameworks Condition="'$(SingleTargetFramework)' == ''">
            net10.0-android;
            net10.0-ios;
            net10.0-windows10.0.26100;
            net10.0-desktop;
            net10.0-browserwasm;
        </TargetFrameworks>
        <TargetFrameworks Condition="'$(SingleTargetFramework)' != ''">$(SingleTargetFramework)</TargetFrameworks>

        <OutputType>Exe</OutputType>
        <UnoSingleProject>true</UnoSingleProject>

        <!-- Application metadata -->
        <ApplicationPublisher>Martin Zikmund</ApplicationPublisher>
        <Description>GcToolkit by Martin Zikmund</Description>
    </PropertyGroup>

    <!-- Channel-specific identity. See docs/versioning.md. -->
    <PropertyGroup Condition="'$(AppChannel)' == 'Prod'">
        <ApplicationTitle>GC Toolkit</ApplicationTitle>
        <ApplicationId>dev.mzikmund.gctoolkit</ApplicationId>
    </PropertyGroup>

    <PropertyGroup Condition="'$(AppChannel)' == 'Dev'">
        <ApplicationTitle>GC Toolkit Dev</ApplicationTitle>
        <ApplicationId>dev.mzikmund.gctoolkit.dev</ApplicationId>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Application icon & splash screen adjustments-->
        <!-- Background is shared across channels. The app-icon resource name is derived
             from the background file (Uno maps UnoIcon.Include = UnoIconBackgroundFile),
             so the background must stay constant or Android's @mipmap/icon breaks. -->
        <UnoIconBackgroundFile>Assets/Icons/icon_transparent.svg</UnoIconBackgroundFile>
        <UnoIconBackgroundFile Condition="'$(IsIOS)' == 'true' or '$(IsAndroid)' == 'true'">Assets/Icons/icon.svg</UnoIconBackgroundFile>

        <!-- Dev channel: override only the foreground (the logo). This keeps the
             generated icon resource name stable while giving Dev a distinct look. -->
        <UnoIconForegroundFile Condition="'$(AppChannel)' == 'Dev'">Assets/Icons/icon_foreground_dev.svg</UnoIconForegroundFile>

        <UnoIconForegroundScale>1</UnoIconForegroundScale>
        <UnoIconForegroundScale Condition="'$(IsAndroid)' == 'true'">0.6</UnoIconForegroundScale>
        <UnoSplashScreenScale>0.85</UnoSplashScreenScale>
    </PropertyGroup>

    <!-- Bundled monospace, so coordinates and cipher readouts share one face on every head
         (Consolas ships with Windows only). The Uno.Sdk's implicit `Assets/**` Content glob
         is skipped when IsWinAppSdk, and the .NET SDK only globs Assets as None, so the
         Windows head needs the folder declared explicitly. Licence: Assets/Fonts/LICENSE-CascadiaMono.txt. -->
    <ItemGroup Condition="'$(IsWinAppSdk)' == 'true'">
        <None Remove="Assets\Fonts\**" />
        <Content Include="Assets\Fonts\**" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MZikmund.Toolkit.WinUI" />
        <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
        <PackageReference Include="CommunityToolkit.WinUI.Converters" />
        <PackageReference Include="sqlite-net-e" />
        <PackageReference Include="SourceGear.sqlite3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\GcToolkit.Core\GcToolkit.Core.csproj" />

        <!-- Tool auto-discovery source generator: referenced as an analyzer, not as a library. -->
        <ProjectReference Include="..\GcToolkit.SourceGenerators\GcToolkit.SourceGenerators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <!-- Surface the localization resources to the generator so it can validate
             <Id>_Name / <Id>_Tooltip keys at build time (diagnostic GCTOOL004). -->
        <AdditionalFiles Include="Strings\**\Resources.resw" />
    </ItemGroup>

    <PropertyGroup Condition="'$(IsWinAppSdk)' == 'true'">
        <!-- NETSDK1198: the packaged build resolves a per-Platform publish profile (win-$(Platform)).
             A plain `dotnet build` uses Platform=AnyCPU, for which there is no win-AnyCPU.pubxml; this
             is harmless when not publishing. Concrete arch profiles (win-x64/x86/arm64) exist under
             Properties/PublishProfiles for actual MSIX publish. -->
        <NoWarn>$(NoWarn);NETSDK1198</NoWarn>
    </PropertyGroup>

    <!-- `dotnet run` support for the packaged WinAppSDK head. See Platforms/Windows/README.md. -->
    <ItemGroup Condition="'$(IsWinAppSdk)' == 'true'">
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" PrivateAssets="all" />
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools" PrivateAssets="all" />
    </ItemGroup>
</Project>
