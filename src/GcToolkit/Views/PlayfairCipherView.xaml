<local:PlayfairCipherViewBase
    x:Class="GcToolkit.Views.PlayfairCipherView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup"
    xmlns:tools="using:GcToolkit.Core.ViewModels.Tools"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid MaxWidth="1024" HorizontalAlignment="Center">
        <ScrollViewer Padding="24" HorizontalContentAlignment="Center">
            <StackPanel HorizontalAlignment="Stretch" Spacing="16">

                <!--  Header: tool name + favorite toggle  -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock
                            Style="{ThemeResource TitleLargeTextBlockStyle}"
                            Text="{x:Bind ViewModel.ToolName, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.Tooltip, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleButton
                        Grid.Column="1"
                        Width="44"
                        Height="44"
                        Padding="0"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{markup:Localize Key=AddToFavorites}"
                        Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                        IsChecked="{x:Bind ViewModel.IsFavorite, Mode=OneWay}"
                        ToolTipService.ToolTip="{markup:Localize Key=AddToFavorites}">
                        <FontIcon FontSize="18" Glyph="&#xE734;" />
                    </ToggleButton>
                </Grid>

                <!--  Direction  -->
                <RadioButtons MaxColumns="2" SelectedIndex="{x:Bind ViewModel.DirectionIndex, Mode=TwoWay}">
                    <RadioButton Content="{markup:Localize Key=PlayfairEncrypt}" />
                    <RadioButton Content="{markup:Localize Key=PlayfairDecrypt}" />
                </RadioButtons>

                <!--  Key source + keyword / manual square  -->
                <RadioButtons MaxColumns="2" SelectedIndex="{x:Bind ViewModel.SquareSourceIndex, Mode=TwoWay}">
                    <RadioButton Content="{markup:Localize Key=PlayfairSquareSourceStandard}" />
                    <RadioButton Content="{markup:Localize Key=PlayfairSquareSourceManual}" />
                </RadioButtons>

                <TextBox
                    Header="{markup:Localize Key=PlayfairKeywordLabel}"
                    IsSpellCheckEnabled="False"
                    PlaceholderText="{markup:Localize Key=PlayfairKeywordPlaceholder}"
                    Text="{x:Bind ViewModel.Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Visibility="{x:Bind ViewModel.IsManualSquare, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />

                <TextBox
                    FontFamily="Consolas"
                    Header="{markup:Localize Key=PlayfairManualSquareLabel}"
                    IsSpellCheckEnabled="False"
                    PlaceholderText="{markup:Localize Key=PlayfairManualSquarePlaceholder}"
                    Text="{x:Bind ViewModel.ManualSquare, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Visibility="{x:Bind ViewModel.IsManualSquare, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!--  Live key square  -->
                <StackPanel Spacing="8">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=PlayfairKeySquareLabel}" />
                    <Border
                        Padding="12"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.SquareCells}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    ItemsStretch="None"
                                    MaximumRowsOrColumns="5"
                                    MinColumnSpacing="6"
                                    MinItemHeight="48"
                                    MinItemWidth="48"
                                    MinRowSpacing="6"
                                    Orientation="Horizontal" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="tools:PlayfairSquareCell">
                                    <Border
                                        Width="48"
                                        Height="48"
                                        AutomationProperties.Name="{x:Bind AutomationName}"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="6">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="22"
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Letter}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </Border>
                </StackPanel>

                <!--  Options  -->
                <Expander
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Header="{markup:Localize Key=PlayfairOptionsLabel}">
                    <StackPanel Spacing="12">
                        <!--  Alphabet fit: merge vs skip  -->
                        <RadioButtons MaxColumns="2" SelectedIndex="{x:Bind ViewModel.FitIndex, Mode=TwoWay}">
                            <RadioButton Content="{markup:Localize Key=PlayfairFitMerge}" />
                            <RadioButton Content="{markup:Localize Key=PlayfairFitSkip}" />
                        </RadioButtons>

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.IsMergeFit, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBox
                                Width="72"
                                Header="{markup:Localize Key=PlayfairMergeFromLabel}"
                                MaxLength="1"
                                Text="{x:Bind ViewModel.MergeFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Width="72"
                                Header="{markup:Localize Key=PlayfairMergeToLabel}"
                                MaxLength="1"
                                Text="{x:Bind ViewModel.MergeTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <TextBox
                            Width="120"
                            HorizontalAlignment="Left"
                            Header="{markup:Localize Key=PlayfairSkipLetterLabel}"
                            MaxLength="1"
                            Text="{x:Bind ViewModel.SkipLetter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="{x:Bind ViewModel.IsMergeFit, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox
                                Width="120"
                                Header="{markup:Localize Key=PlayfairFillerLabel}"
                                MaxLength="1"
                                Text="{x:Bind ViewModel.Filler, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!--  Fill order  -->
                        <RadioButtons MaxColumns="2" SelectedIndex="{x:Bind ViewModel.FillOrderIndex, Mode=TwoWay}">
                            <RadioButton Content="{markup:Localize Key=PlayfairFillOrderRow}" />
                            <RadioButton Content="{markup:Localize Key=PlayfairFillOrderColumn}" />
                        </RadioButtons>

                        <CheckBox Content="{markup:Localize Key=PlayfairSplitDoubles}" IsChecked="{x:Bind ViewModel.SplitDoubles, Mode=TwoWay}" />
                        <CheckBox Content="{markup:Localize Key=PlayfairGroupOutput}" IsChecked="{x:Bind ViewModel.GroupOutput, Mode=TwoWay}" />
                        <CheckBox Content="{markup:Localize Key=PlayfairBatchMode}" IsChecked="{x:Bind ViewModel.BatchMode, Mode=TwoWay}" />
                    </StackPanel>
                </Expander>

                <!--  Input  -->
                <TextBox
                    MinHeight="96"
                    AcceptsReturn="True"
                    Header="{markup:Localize Key=PlayfairInputLabel}"
                    IsSpellCheckEnabled="False"
                    PlaceholderText="{markup:Localize Key=PlayfairInputPlaceholder}"
                    Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />

                <!--  Result  -->
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=PlayfairOutputLabel}" />
                <TextBox
                    MinHeight="64"
                    AcceptsReturn="True"
                    FontFamily="Consolas"
                    FontSize="18"
                    IsReadOnly="True"
                    IsSpellCheckEnabled="False"
                    Text="{x:Bind ViewModel.OutputText, Mode=OneWay}"
                    TextWrapping="Wrap" />

                <!--  Validation / stripped notice  -->
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
                    Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
                    Severity="Warning" />

                <!--  Output actions  -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.CopyOutputCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                            <TextBlock Text="{markup:Localize Key=PlayfairCopy}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ShareOutputCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE72D;" />
                            <TextBlock Text="{markup:Localize Key=PlayfairShare}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.SwapDirectionCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8AB;" />
                            <TextBlock Text="{markup:Localize Key=PlayfairSwap}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ClearCommand}" Content="{markup:Localize Key=PlayfairClear}" />
                </StackPanel>

                <!--  Historical description  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{markup:Localize Key=PlayfairDescription}"
                        TextWrapping="Wrap" />
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:PlayfairCipherViewBase>
