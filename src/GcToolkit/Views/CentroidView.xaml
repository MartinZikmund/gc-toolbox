<local:CentroidViewBase
    x:Class="GcToolkit.Views.CentroidView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GcToolkit.Controls"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup"
    xmlns:tools="using:GcToolkit.Core.ViewModels.Tools">

    <controls:ToolPage
        ContentWidth="Wide"
        CopyCommand="{x:Bind ViewModel.CopyOutputCommand}"
        ShareCommand="{x:Bind ViewModel.ShareOutputCommand}"
        Tool="{x:Bind ViewModel}">

        <controls:ToolPage.Actions>
            <Button Command="{x:Bind ViewModel.ClearCommand}" Content="{markup:Localize Key=CentroidClear}" />
        </controls:ToolPage.Actions>

        <StackPanel Spacing="16">

            <!--  One coordinate per line, notations may be mixed  -->
            <TextBox
                MinHeight="160"
                AcceptsReturn="True"
                FontFamily="{ThemeResource AppMonoFontFamily}"
                Header="{markup:Localize Key=CentroidInputLabel}"
                IsSpellCheckEnabled="False"
                PlaceholderText="{markup:Localize Key=CentroidInputPlaceholder}"
                Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="NoWrap" />

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{markup:Localize Key=CentroidInputHint}"
                TextWrapping="Wrap" />

            <!--  Unreadable lines are named, never silently dropped  -->
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasParseErrors, Mode=OneWay}"
                Message="{x:Bind ViewModel.ParseErrorMessage, Mode=OneWay}"
                Severity="Warning" />

            <!--  Both means, on the dark result surface  -->
            <Border Style="{StaticResource ToolReadoutSurfaceStyle}" Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="16">
                    <TextBlock
                        Foreground="{ThemeResource ReadoutForegroundBrush}"
                        Opacity="0.7"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.PointCountText, Mode=OneWay}" />

                    <StackPanel Spacing="4">
                        <TextBlock
                            Foreground="{ThemeResource ReadoutForegroundBrush}"
                            Opacity="0.7"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=CentroidGeodesicMean}" />
                        <TextBlock
                            AutomationProperties.Name="{markup:Localize Key=CentroidGeodesicMean}"
                            FontSize="20"
                            Style="{StaticResource ToolReadoutTextStyle}"
                            Text="{x:Bind ViewModel.GeodesicText, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource ReadoutForegroundBrush}"
                            Opacity="0.6"
                            Style="{StaticResource MonoTextBlockStyle}"
                            Text="{x:Bind ViewModel.GeodesicDecimalText, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource ReadoutForegroundBrush}"
                            Opacity="0.6"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=CentroidGeodesicNote}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Rectangle
                        Height="1"
                        Fill="{ThemeResource ReadoutForegroundBrush}"
                        Opacity="0.2" />

                    <StackPanel Spacing="4">
                        <TextBlock
                            Foreground="{ThemeResource ReadoutForegroundBrush}"
                            Opacity="0.7"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=CentroidArithmeticMean}" />
                        <TextBlock
                            AutomationProperties.Name="{markup:Localize Key=CentroidArithmeticMean}"
                            FontSize="20"
                            Style="{StaticResource ToolReadoutTextStyle}"
                            Text="{x:Bind ViewModel.ArithmeticText, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource ReadoutForegroundBrush}"
                            Opacity="0.6"
                            Style="{StaticResource MonoTextBlockStyle}"
                            Text="{x:Bind ViewModel.ArithmeticDecimalText, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource ReadoutForegroundBrush}"
                            Opacity="0.6"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=CentroidArithmeticNote}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  The antimeridian case: the two means are nowhere near each other  -->
            <InfoBar
                Title="{markup:Localize Key=CentroidDivergenceTitle}"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasDivergence, Mode=OneWay}"
                Message="{markup:Localize Key=CentroidDivergenceNote}"
                Severity="Warning" />

            <!--  How far the set spreads around its centre  -->
            <Border
                Padding="16"
                Background="{ThemeResource AppSurfaceBrush}"
                BorderBrush="{ThemeResource AppStrokeBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=CentroidFarthest}"
                            TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource MonoTextBlockStyle}" Text="{x:Bind ViewModel.FarthestText, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=CentroidMeanDistance}"
                            TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource MonoTextBlockStyle}" Text="{x:Bind ViewModel.MeanDistanceText, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=CentroidDivergence}"
                            TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource MonoTextBlockStyle}" Text="{x:Bind ViewModel.DivergenceText, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Every point, with its offset from the centre  -->
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=CentroidPointsHeader}" />

                <Grid Padding="8,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{markup:Localize Key=CentroidColumnPoint}" />
                    <TextBlock
                        Grid.Column="1"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{markup:Localize Key=CentroidColumnCoordinate}" />
                    <TextBlock
                        Grid.Column="2"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{markup:Localize Key=CentroidColumnDistance}" />
                    <TextBlock
                        Grid.Column="3"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{markup:Localize Key=CentroidColumnBearing}" />
                </Grid>

                <ItemsControl ItemsSource="{x:Bind ViewModel.Points, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="tools:CoordinatePointRow">
                            <Grid
                                Margin="0,2"
                                Padding="8,6"
                                Background="{ThemeResource AppSurfaceBrush}"
                                ColumnSpacing="12"
                                CornerRadius="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource MonoTextBlockStyle}"
                                    Text="{x:Bind Number}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource MonoTextBlockStyle}"
                                    Text="{x:Bind Coordinate}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource MonoTextBlockStyle}"
                                    Text="{x:Bind Distance}" />
                                <TextBlock
                                    Grid.Column="3"
                                    Style="{StaticResource MonoTextBlockStyle}"
                                    Text="{x:Bind Bearing}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
    </controls:ToolPage>
</local:CentroidViewBase>
