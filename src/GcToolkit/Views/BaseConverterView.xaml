<local:BaseConverterViewBase
    x:Class="GcToolkit.Views.BaseConverterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup"
    xmlns:tools="using:GcToolkit.Core.ViewModels.Tools"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="24">
        <StackPanel
            MaxWidth="760"
            HorizontalAlignment="Stretch"
            Spacing="16">

            <!--  Header: tool name + favorite toggle  -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock
                        Style="{ThemeResource TitleLargeTextBlockStyle}"
                        Text="{x:Bind ViewModel.ToolName, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.Tooltip, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <ToggleButton
                    Grid.Column="1"
                    Width="44"
                    Height="44"
                    Padding="0"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="{markup:Localize Key=AddToFavorites}"
                    Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                    IsChecked="{x:Bind ViewModel.IsFavorite, Mode=OneWay}"
                    ToolTipService.ToolTip="{markup:Localize Key=AddToFavorites}">
                    <FontIcon FontSize="18" Glyph="&#xE734;" />
                </ToggleButton>
            </Grid>

            <!--  Input value + source base  -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="ValueTextBox"
                    Grid.Column="0"
                    FontFamily="Consolas"
                    Header="{markup:Localize Key=BaseConverterInputLabel}"
                    PlaceholderText="{markup:Localize Key=BaseConverterInputPlaceholder}"
                    Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <NumberBox
                    Grid.Column="1"
                    MinWidth="140"
                    AutomationProperties.Name="{markup:Localize Key=BaseConverterFromBase}"
                    Header="{markup:Localize Key=BaseConverterFromBase}"
                    LargeChange="2"
                    Maximum="{x:Bind ViewModel.MaxBase}"
                    Minimum="{x:Bind ViewModel.MinBase}"
                    SmallChange="1"
                    SpinButtonPlacementMode="Inline"
                    ValidationMode="InvalidInputOverwritten"
                    Value="{x:Bind ViewModel.FromBase, Mode=TwoWay}" />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Command="{x:Bind ViewModel.ClearCommand}" Content="{markup:Localize Key=BaseConverterClear}" />
            </StackPanel>

            <!--  Invalid-input notice  -->
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" />

            <!--  All common bases at once (binary / octal / decimal / hex)  -->
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasOutput, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=BaseConverterCommonLabel}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.CommonResults}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="tools:BaseResultItem">
                            <Grid
                                Margin="0,2"
                                Padding="12,8"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                ColumnSpacing="12"
                                CornerRadius="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Label}"
                                    TextWrapping="Wrap" />
                                <TextBox
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontFamily="Consolas"
                                    FontSize="16"
                                    IsReadOnly="True"
                                    IsSpellCheckEnabled="False"
                                    Text="{x:Bind Value}"
                                    TextWrapping="Wrap" />
                                <Button
                                    Grid.Column="2"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{markup:Localize Key=BaseConverterCopyRow}"
                                    Command="{x:Bind CopyCommand}"
                                    ToolTipService.ToolTip="{markup:Localize Key=BaseConverterCopyRow}">
                                    <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!--  Arbitrary target base  -->
            <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.HasOutput, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <NumberBox
                    Grid.Column="0"
                    MinWidth="140"
                    VerticalAlignment="Bottom"
                    AutomationProperties.Name="{markup:Localize Key=BaseConverterToBase}"
                    Header="{markup:Localize Key=BaseConverterToBase}"
                    LargeChange="2"
                    Maximum="{x:Bind ViewModel.MaxBase}"
                    Minimum="{x:Bind ViewModel.MinBase}"
                    SmallChange="1"
                    SpinButtonPlacementMode="Inline"
                    ValidationMode="InvalidInputOverwritten"
                    Value="{x:Bind ViewModel.ToBase, Mode=TwoWay}" />
                <TextBox
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    FontFamily="Consolas"
                    FontSize="16"
                    Header="{markup:Localize Key=BaseConverterTargetLabel}"
                    IsReadOnly="True"
                    IsSpellCheckEnabled="False"
                    Text="{x:Bind ViewModel.TargetOutput, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </Grid>

            <!--  Output actions  -->
            <StackPanel
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{x:Bind ViewModel.HasOutput, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button Command="{x:Bind ViewModel.CopyOutputCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                        <TextBlock Text="{markup:Localize Key=BaseConverterCopy}" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.ShareOutputCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE72D;" />
                        <TextBlock Text="{markup:Localize Key=BaseConverterShare}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!--  Digit reference  -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=BaseConverterDigitsLabel}" />
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="15"
                        Text="0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{markup:Localize Key=BaseConverterDigitsNote}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</local:BaseConverterViewBase>
