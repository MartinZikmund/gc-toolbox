<local:VigenereCipherViewBase
    x:Class="GcToolkit.Views.VigenereCipherView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup"
    xmlns:tools="using:GcToolkit.Core.ViewModels.Tools"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="24">
        <Grid>
            <StackPanel
                MaxWidth="760"
                HorizontalAlignment="Stretch"
                Spacing="16">

                <!--  Header: tool name + favorite toggle  -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock
                            Style="{ThemeResource TitleLargeTextBlockStyle}"
                            Text="{x:Bind ViewModel.ToolName, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.Tooltip, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleButton
                        Grid.Column="1"
                        Width="44"
                        Height="44"
                        Padding="0"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{markup:Localize Key=AddToFavorites}"
                        Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                        IsChecked="{x:Bind ViewModel.IsFavorite, Mode=OneWay}"
                        ToolTipService.ToolTip="{markup:Localize Key=AddToFavorites}">
                        <FontIcon FontSize="18" Glyph="&#xE734;" />
                    </ToggleButton>
                </Grid>

                <!--  Mode: Encode / Decode / Assisted decode  -->
                <RadioButtons
                    Header="{markup:Localize Key=VigenereMode}"
                    MaxColumns="3"
                    SelectedIndex="{x:Bind ViewModel.DirectionIndex, Mode=TwoWay}">
                    <RadioButton Content="{markup:Localize Key=VigenereEncode}" />
                    <RadioButton Content="{markup:Localize Key=VigenereDecode}" />
                    <RadioButton Content="{markup:Localize Key=VigenereAssisted}" />
                </RadioButtons>

                <!--  Key (hidden in assisted mode, where the key is recovered)  -->
                <TextBox
                    Header="{markup:Localize Key=VigenereKeyInputLabel}"
                    PlaceholderText="{markup:Localize Key=VigenereKeyPlaceholder}"
                    Text="{x:Bind ViewModel.KeyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Visibility="{x:Bind ViewModel.IsKeyedMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!--  Key validation: no A-Z letter to cycle through  -->
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasKeyError, Mode=OneWay}"
                    Message="{markup:Localize Key=VigenereKeyError}"
                    Severity="Warning"
                    Visibility="{x:Bind ViewModel.HasKeyError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!--  Assisted-mode explainer  -->
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsAssistedMode, Mode=OneWay}"
                    Message="{markup:Localize Key=VigenereAssistedExplainer}"
                    Severity="Informational"
                    Visibility="{x:Bind ViewModel.IsAssistedMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!--  Solver options: plaintext language + key-length search range (site parity)  -->
                <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.IsAssistedMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Header="{markup:Localize Key=VigenereLanguageLabel}"
                        ItemsSource="{x:Bind ViewModel.LanguageNames}"
                        SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}" />
                    <NumberBox
                        Grid.Column="1"
                        Header="{markup:Localize Key=VigenereKeyLengthFrom}"
                        LargeChange="5"
                        Maximum="50"
                        Minimum="1"
                        SmallChange="1"
                        SpinButtonPlacementMode="Inline"
                        Value="{x:Bind ViewModel.MinKeyLength, Mode=TwoWay}" />
                    <NumberBox
                        Grid.Column="2"
                        Header="{markup:Localize Key=VigenereKeyLengthTo}"
                        LargeChange="5"
                        Maximum="50"
                        Minimum="1"
                        SmallChange="1"
                        SpinButtonPlacementMode="Inline"
                        Value="{x:Bind ViewModel.MaxKeyLength, Mode=TwoWay}" />
                </Grid>

                <!--  Input  -->
                <TextBox
                    MinHeight="96"
                    AcceptsReturn="True"
                    Header="{markup:Localize Key=VigenereInputLabel}"
                    PlaceholderText="{markup:Localize Key=VigenereInputPlaceholder}"
                    Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />

                <Button
                    HorizontalAlignment="Left"
                    Command="{x:Bind ViewModel.ClearCommand}"
                    Content="{markup:Localize Key=VigenereClear}" />

                <!--  Derived key (assisted mode only)  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.HasDerivedKey, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="6">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=VigenereDerivedKeyLabel}" />
                        <TextBlock
                            FontFamily="Consolas"
                            IsTextSelectionEnabled="True"
                            Style="{ThemeResource TitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.DerivedKey, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  Assisted "not enough text" hint  -->
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.ShowAssistedHint, Mode=OneWay}"
                    Message="{markup:Localize Key=VigenereAssistedHint}"
                    Severity="Warning"
                    Visibility="{x:Bind ViewModel.ShowAssistedHint, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!--  Result  -->
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=VigenereOutputLabel}" />
                <TextBox
                    MinHeight="96"
                    AcceptsReturn="True"
                    AutomationProperties.Name="{markup:Localize Key=VigenereOutputLabel}"
                    FontFamily="Consolas"
                    FontSize="18"
                    IsReadOnly="True"
                    IsSpellCheckEnabled="False"
                    Text="{x:Bind ViewModel.OutputText, Mode=OneWay}"
                    TextWrapping="Wrap" />

                <!--  Output actions  -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.CopyOutputCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                            <TextBlock Text="{markup:Localize Key=VigenereCopy}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ShareOutputCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE72D;" />
                            <TextBlock Text="{markup:Localize Key=VigenereShare}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--  Key-length candidates (assisted mode only)  -->
                <Expander
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Header="{markup:Localize Key=VigenereKeyLengthsLabel}"
                    IsExpanded="True"
                    Visibility="{x:Bind ViewModel.IsAssistedMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=VigenereKeyLengthsNote}"
                            TextWrapping="Wrap" />
                        <!--  ListView virtualizes the ranked rows so only visible ones are realized.  -->
                        <ListView
                            MaxHeight="280"
                            ItemsSource="{x:Bind ViewModel.KeyLengthCandidates, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="tools:VigenereKeyLengthItem">
                                    <Grid
                                        Margin="0,2"
                                        Padding="8,6"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        ColumnSpacing="12"
                                        CornerRadius="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Length}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Score}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Expander>

                <!--  Running substitution key: one row per key letter (geocachingtoolbox "Key" parity)  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.ShowKeyRows, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=VigenereKeyLabel}" />
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="15"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.NormalizedKey, Mode=OneWay}"
                            TextWrapping="Wrap" />

                        <!--  A 50-letter key means 50 alphabet rows; virtualize and bound the height.  -->
                        <ListView
                            MaxHeight="320"
                            ItemsSource="{x:Bind ViewModel.KeyRows, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="tools:VigenereKeyRow">
                                    <Grid Margin="0,2" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="15"
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind KeyLetter}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="15"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Text="{x:Bind CipherAlphabet}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=VigenereKeyNote}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</local:VigenereCipherViewBase>
