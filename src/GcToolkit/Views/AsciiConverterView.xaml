<local:AsciiConverterViewBase
    x:Class="GcToolkit.Views.AsciiConverterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup"
    xmlns:text="using:GcToolkit.Core.Text"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="24">
        <Grid>
            <StackPanel
                MaxWidth="760"
                HorizontalAlignment="Stretch"
                Spacing="16">

                <!--  Header: tool name + favorite toggle  -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock
                            Style="{ThemeResource TitleLargeTextBlockStyle}"
                            Text="{x:Bind ViewModel.ToolName, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.Tooltip, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleButton
                        Grid.Column="1"
                        Width="44"
                        Height="44"
                        Padding="0"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{markup:Localize Key=AddToFavorites}"
                        Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                        IsChecked="{x:Bind ViewModel.IsFavorite, Mode=OneWay}"
                        ToolTipService.ToolTip="{markup:Localize Key=AddToFavorites}">
                        <FontIcon FontSize="18" Glyph="&#xE734;" />
                    </ToggleButton>
                </Grid>

                <!--  From / To formats + swap  -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ComboBox
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Header="{markup:Localize Key=AsciiFromLabel}"
                        SelectedIndex="{x:Bind ViewModel.FromFormatIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="{markup:Localize Key=AsciiBaseAuto}" />
                        <ComboBoxItem Content="{markup:Localize Key=AsciiFormatText}" />
                        <ComboBoxItem Content="{markup:Localize Key=AsciiBaseBinary}" />
                        <ComboBoxItem Content="{markup:Localize Key=AsciiBaseOctal}" />
                        <ComboBoxItem Content="{markup:Localize Key=AsciiBaseDecimal}" />
                        <ComboBoxItem Content="{markup:Localize Key=AsciiBaseHex}" />
                        <ComboBoxItem Content="{markup:Localize Key=AsciiFormatBase32}" />
                        <ComboBoxItem Content="{markup:Localize Key=AsciiFormatBase64}" />
                        <ComboBoxItem Content="{markup:Localize Key=AsciiFormatHtml}" />
                    </ComboBox>

                    <Button
                        Grid.Column="1"
                        Width="44"
                        Height="32"
                        Padding="0"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="{markup:Localize Key=AsciiSwap}"
                        Command="{x:Bind ViewModel.SwapCommand}"
                        ToolTipService.ToolTip="{markup:Localize Key=AsciiSwap}">
                        <FontIcon FontSize="16" Glyph="&#xE8AB;" />
                    </Button>

                    <ComboBox
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        Header="{markup:Localize Key=AsciiToLabel}"
                        SelectedIndex="{x:Bind ViewModel.ToFormatIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="{markup:Localize Key=AsciiFormatText}" />
                        <ComboBoxItem Content="{markup:Localize Key=AsciiBaseBinary}" />
                        <ComboBoxItem Content="{markup:Localize Key=AsciiBaseOctal}" />
                        <ComboBoxItem Content="{markup:Localize Key=AsciiBaseDecimal}" />
                        <ComboBoxItem Content="{markup:Localize Key=AsciiBaseHex}" />
                        <ComboBoxItem Content="{markup:Localize Key=AsciiFormatBase32}" />
                        <ComboBoxItem Content="{markup:Localize Key=AsciiFormatBase64}" />
                        <ComboBoxItem Content="{markup:Localize Key=AsciiFormatHtml}" />
                    </ComboBox>
                </Grid>

                <!--  Options: separator (grouped formats only) + strip spaces  -->
                <StackPanel Spacing="8">
                    <TextBox
                        Header="{markup:Localize Key=AsciiSeparatorLabel}"
                        PlaceholderText="{markup:Localize Key=AsciiSeparatorPlaceholder}"
                        Text="{x:Bind ViewModel.Separator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{x:Bind ViewModel.ShowSeparator, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <CheckBox Content="{markup:Localize Key=AsciiRemoveSpaces}" IsChecked="{x:Bind ViewModel.RemoveSpaces, Mode=TwoWay}" />
                </StackPanel>

                <!--  Input  -->
                <TextBox
                    MinHeight="96"
                    AcceptsReturn="True"
                    Header="{markup:Localize Key=AsciiInputLabel}"
                    IsSpellCheckEnabled="False"
                    Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />

                <Button Command="{x:Bind ViewModel.ClearCommand}" Content="{markup:Localize Key=AsciiClear}" />

                <!--  Error  -->
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error" />

                <!--  Result  -->
                <StackPanel Spacing="8">
                    <TextBox
                        MinHeight="96"
                        AcceptsReturn="True"
                        FontFamily="Consolas"
                        FontSize="18"
                        Header="{markup:Localize Key=AsciiOutputLabel}"
                        IsReadOnly="True"
                        IsSpellCheckEnabled="False"
                        Text="{x:Bind ViewModel.OutputText, Mode=OneWay}"
                        TextWrapping="Wrap" />

                    <!--  Auto-detected input format hint  -->
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="6"
                        Visibility="{x:Bind ViewModel.ShowDetectedFormat, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=AsciiDetectedBaseNote}" />
                        <TextBlock
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.DetectedFormatName, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>

                <!--  Output actions  -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.CopyOutputCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                            <TextBlock Text="{markup:Localize Key=AsciiCopy}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ShareOutputCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE72D;" />
                            <TextBlock Text="{markup:Localize Key=AsciiShare}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--  All-bases breakdown (every character in decimal, hex, octal, binary)  -->
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasBreakdown, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=AsciiBreakdownLabel}" />

                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel>
                            <!--  Column headers  -->
                            <Grid
                                Padding="12,8"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{markup:Localize Key=AsciiColumnChar}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{markup:Localize Key=AsciiColumnDecimal}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{markup:Localize Key=AsciiColumnHex}" />
                                <TextBlock
                                    Grid.Column="3"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{markup:Localize Key=AsciiColumnOctal}" />
                                <TextBlock
                                    Grid.Column="4"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{markup:Localize Key=AsciiColumnBinary}" />
                            </Grid>

                            <!--  Virtualizing: a long paste is one row per character  -->
                            <ListView
                                MaxHeight="420"
                                AutomationProperties.Name="{markup:Localize Key=AsciiBreakdownLabel}"
                                ItemsSource="{x:Bind ViewModel.Breakdown, Mode=OneWay}"
                                SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="12,2" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="text:AsciiCodeRow">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="2*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                FontFamily="Consolas"
                                                Text="{x:Bind Character}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontFamily="Consolas"
                                                Text="{x:Bind Decimal}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Grid.Column="2"
                                                FontFamily="Consolas"
                                                Text="{x:Bind Hexadecimal}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Grid.Column="3"
                                                FontFamily="Consolas"
                                                Text="{x:Bind Octal}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Grid.Column="4"
                                                FontFamily="Consolas"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind Binary}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</local:AsciiConverterViewBase>
