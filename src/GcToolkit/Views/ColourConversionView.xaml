<local:ColourConversionViewBase
    x:Class="GcToolkit.Views.ColourConversionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup"
    xmlns:tools="using:GcToolkit.Core.ViewModels.Tools"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="24">
        <Grid>
            <StackPanel
                x:Name="Root"
                MaxWidth="900"
                HorizontalAlignment="Stretch"
                Spacing="16">

                <!--  Header: tool name + favorite toggle  -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock
                            Style="{ThemeResource TitleLargeTextBlockStyle}"
                            Text="{x:Bind ViewModel.ToolName, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.Tooltip, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleButton
                        Grid.Column="1"
                        Width="44"
                        Height="44"
                        Padding="0"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{markup:Localize Key=AddToFavorites}"
                        Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                        IsChecked="{x:Bind ViewModel.IsFavorite, Mode=OneWay}"
                        ToolTipService.ToolTip="{markup:Localize Key=AddToFavorites}">
                        <FontIcon FontSize="18" Glyph="&#xE734;" />
                    </ToggleButton>
                </Grid>

                <!--  Intro help text  -->
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Text="{markup:Localize Key=ColourConversionIntro}"
                    TextWrapping="Wrap" />

                <!--  Live preview swatch + hex field + actions  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="0"
                            Width="96"
                            Height="96"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="{markup:Localize Key=ColourConversionPreview}"
                            Background="{x:Bind ViewModel.SwatchArgb, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8" />

                        <TextBox
                            Grid.Row="0"
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            FontFamily="Consolas"
                            FontSize="18"
                            Header="{markup:Localize Key=ColourConversionHexLabel}"
                            Text="{x:Bind ViewModel.HexField.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button Command="{x:Bind ViewModel.CopyHexCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                                    <TextBlock Text="{markup:Localize Key=ColourConversionCopyHex}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.CopyAllCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xF0E3;" />
                                    <TextBlock Text="{markup:Localize Key=ColourConversionCopyAll}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{x:Bind ViewModel.ShareAllCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="16" Glyph="&#xE72D;" />
                                    <TextBlock Text="{markup:Localize Key=ColourConversionShare}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Model cards (responsive wrapping grid)  -->
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Models}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MinColumnSpacing="12"
                            MinItemWidth="260"
                            MinRowSpacing="12" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="tools:ColourModelCard">
                            <Border
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind TitleKey, Converter={StaticResource LocalizationKeyConverter}}" />
                                    <ItemsControl ItemsSource="{x:Bind Fields}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="tools:ColourField">
                                                <Grid Margin="0,2" ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox
                                                        Grid.Column="0"
                                                        Header="{x:Bind Label, Converter={StaticResource LocalizationKeyConverter}}"
                                                        InputScope="Number"
                                                        Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Margin="0,0,0,8"
                                                        VerticalAlignment="Bottom"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind Unit}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!--  Device-dependent caveat (geocachingtoolbox parity)  -->
                <InfoBar
                    IsClosable="False"
                    IsOpen="True"
                    Message="{markup:Localize Key=ColourConversionDeviceNote}"
                    Severity="Informational" />

            </StackPanel>
        </Grid>
    </ScrollViewer>
</local:ColourConversionViewBase>
