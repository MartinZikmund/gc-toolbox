<local:TapCodeViewBase
    x:Class="GcToolkit.Views.TapCodeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:alphabets="using:GcToolkit.Core.Alphabets"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="24">
        <Grid>
            <StackPanel
                MaxWidth="760"
                HorizontalAlignment="Stretch"
                Spacing="16">
                <!--  Header: tool name + favorite toggle  -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock
                            Style="{ThemeResource TitleLargeTextBlockStyle}"
                            Text="{x:Bind ViewModel.ToolName, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.Tooltip, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleButton
                        Grid.Column="1"
                        Width="44"
                        Height="44"
                        Padding="0"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{markup:Localize Key=AddToFavorites}"
                        Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                        IsChecked="{x:Bind ViewModel.IsFavorite, Mode=OneWay}"
                        ToolTipService.ToolTip="{markup:Localize Key=AddToFavorites}">
                        <FontIcon FontSize="18" Glyph="&#xE734;" />
                    </ToggleButton>
                </Grid>

                <!--  Grid size selector  -->
                <RadioButtons MaxColumns="2" SelectedIndex="{x:Bind ViewModel.GridSizeIndex, Mode=TwoWay}">
                    <RadioButton Content="{markup:Localize Key=TapCodeGrid5}" />
                    <RadioButton Content="{markup:Localize Key=TapCodeGrid6}" />
                </RadioButtons>

                <!--  Three live-linked fields: edit any one, the other two re-derive  -->
                <TextBox
                    Header="{markup:Localize Key=TapCodeLettersLabel}"
                    PlaceholderText="{markup:Localize Key=TapCodeLettersPlaceholder}"
                    Text="{x:Bind ViewModel.Letters, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />

                <TextBox
                    FontFamily="Consolas"
                    Header="{markup:Localize Key=TapCodeNumbersLabel}"
                    PlaceholderText="{markup:Localize Key=TapCodeNumbersPlaceholder}"
                    Text="{x:Bind ViewModel.Numbers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />

                <TextBox
                    MinHeight="72"
                    AcceptsReturn="True"
                    FontFamily="Consolas"
                    FontSize="18"
                    Header="{markup:Localize Key=TapCodeDotsLabel}"
                    PlaceholderText="{markup:Localize Key=TapCodeDotsPlaceholder}"
                    Text="{x:Bind ViewModel.Dots, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />

                <!--  Actions  -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.CopyLettersCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                            <TextBlock Text="{markup:Localize Key=TapCodeCopyLetters}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.CopyNumbersCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                            <TextBlock Text="{markup:Localize Key=TapCodeCopyNumbers}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ShareCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE72D;" />
                            <TextBlock Text="{markup:Localize Key=TapCodeShare}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ClearCommand}" Content="{markup:Localize Key=TapCodeClear}" />
                </StackPanel>

                <!--  Polybius square — click a cell to type its letter  -->
                <StackPanel Spacing="8">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=TapCodeGridTitle}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{markup:Localize Key=TapCodeGridHint}" />
                    <Border
                        Padding="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.GridRows, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="alphabets:TapCodeCell">
                                                <Button
                                                    Width="60"
                                                    Height="56"
                                                    Margin="3"
                                                    Padding="0"
                                                    AutomationProperties.Name="{x:Bind Label}"
                                                    Click="OnGridCellClick"
                                                    Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="{x:Bind Numbers}">
                                                    <StackPanel HorizontalAlignment="Center" Spacing="2">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                            Text="{x:Bind Label}" />
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind Numbers}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!--  How it works  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=TapCodeAboutTitle}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{markup:Localize Key=TapCodeAboutBody}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</local:TapCodeViewBase>
