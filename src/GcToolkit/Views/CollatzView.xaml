<local:CollatzViewBase
    x:Class="GcToolkit.Views.CollatzView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <local:CollatzViewBase.Resources>
        <Style x:Key="CollatzStatCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style
            x:Key="CollatzStatValueStyle"
            BasedOn="{StaticResource TitleTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style
            x:Key="CollatzStatLabelStyle"
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </local:CollatzViewBase.Resources>

    <Grid MaxWidth="1024" HorizontalAlignment="Center">
        <ScrollViewer Padding="24" HorizontalContentAlignment="Center">
            <StackPanel HorizontalAlignment="Stretch" Spacing="16">

                <!--  Header: tool name + favorite toggle  -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock
                            Style="{ThemeResource TitleLargeTextBlockStyle}"
                            Text="{x:Bind ViewModel.ToolName, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.Tooltip, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleButton
                        Grid.Column="1"
                        Width="44"
                        Height="44"
                        Padding="0"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{markup:Localize Key=AddToFavorites}"
                        Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                        IsChecked="{x:Bind ViewModel.IsFavorite, Mode=OneWay}"
                        ToolTipService.ToolTip="{markup:Localize Key=AddToFavorites}">
                        <FontIcon FontSize="18" Glyph="&#xE734;" />
                    </ToggleButton>
                </Grid>

                <!--  Trace: starting number  -->
                <TextBox
                    Header="{markup:Localize Key=CollatzStartLabel}"
                    InputScope="Number"
                    PlaceholderText="{markup:Localize Key=CollatzStartPlaceholder}"
                    Text="{x:Bind ViewModel.StartInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!--  Invalid-input notice  -->
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasTraceError, Mode=OneWay}"
                    Message="{markup:Localize Key=CollatzInvalidNotice}"
                    Severity="Warning" />

                <!--  Trace: stats  -->
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="12"
                    Visibility="{x:Bind ViewModel.HasTrace, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Style="{StaticResource CollatzStatCardStyle}">
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource CollatzStatValueStyle}" Text="{x:Bind ViewModel.Steps, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource CollatzStatLabelStyle}" Text="{markup:Localize Key=CollatzStepsLabel}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CollatzStatCardStyle}">
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource CollatzStatValueStyle}" Text="{x:Bind ViewModel.Peak, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource CollatzStatLabelStyle}" Text="{markup:Localize Key=CollatzPeakLabel}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CollatzStatCardStyle}">
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource CollatzStatValueStyle}" Text="{x:Bind ViewModel.Length, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource CollatzStatLabelStyle}" Text="{markup:Localize Key=CollatzLengthLabel}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  Trace: even/odd split + parity  -->
                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasTrace, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.EvenOddSplit, Mode=OneWay}" />
                    <TextBlock
                        FontFamily="Consolas"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.ParityBits, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!--  Trace: sequence  -->
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasTrace, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=CollatzSequenceLabel}" />
                    <TextBox
                        MaxHeight="220"
                        FontFamily="Consolas"
                        IsReadOnly="True"
                        IsSpellCheckEnabled="False"
                        Text="{x:Bind ViewModel.SequenceText, Mode=OneWay}"
                        TextWrapping="Wrap" />

                    <!--  Output actions  -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{x:Bind ViewModel.CopyTraceCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                                <TextBlock Text="{markup:Localize Key=CollatzCopy}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.ShareTraceCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE72D;" />
                                <TextBlock Text="{markup:Localize Key=CollatzShare}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!--  Most-stubborn search  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=CollatzSearchTitle}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=CollatzSearchHint}"
                            TextWrapping="Wrap" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                Grid.Column="0"
                                VerticalAlignment="Bottom"
                                Header="{markup:Localize Key=CollatzLimitLabel}"
                                InputScope="Number"
                                PlaceholderText="{markup:Localize Key=CollatzLimitPlaceholder}"
                                Text="{x:Bind ViewModel.LimitInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.SearchCommand}"
                                Content="{markup:Localize Key=CollatzSearchButton}"
                                Style="{ThemeResource AccentButtonStyle}" />
                        </Grid>

                        <ProgressRing
                            HorizontalAlignment="Left"
                            IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <InfoBar
                            IsClosable="False"
                            IsOpen="{x:Bind ViewModel.HasSearchError, Mode=OneWay}"
                            Message="{markup:Localize Key=CollatzSearchInvalidNotice}"
                            Severity="Warning" />

                        <TextBlock
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind ViewModel.SearchResult, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasSearchResult, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </Border>

                <!--  About the conjecture  -->
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{markup:Localize Key=CollatzAbout}"
                    TextWrapping="Wrap" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:CollatzViewBase>
