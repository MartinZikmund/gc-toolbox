<local:OneTimePadViewBase
    x:Class="GcToolkit.Views.OneTimePadView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GcToolkit.Controls"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup">

    <controls:ToolPage Tool="{x:Bind ViewModel}">
        <StackPanel Spacing="16">


            <!--  Direction  -->
            <RadioButtons MaxColumns="2" SelectedIndex="{x:Bind ViewModel.DirectionIndex, Mode=TwoWay}">
                <RadioButton Content="{markup:Localize Key=OneTimePadEncrypt}" />
                <RadioButton Content="{markup:Localize Key=OneTimePadDecrypt}" />
            </RadioButtons>

            <!--  Variant (Vigenère / Beaufort / variant Beaufort)  -->
            <RadioButtons
                Header="{markup:Localize Key=OneTimePadVariant}"
                MaxColumns="3"
                SelectedIndex="{x:Bind ViewModel.VariantIndex, Mode=TwoWay}">
                <RadioButton Content="{markup:Localize Key=OneTimePadVariantVigenere}" />
                <RadioButton Content="{markup:Localize Key=OneTimePadVariantBeaufort}" />
                <RadioButton Content="{markup:Localize Key=OneTimePadVariantVariantBeaufort}" />
            </RadioButtons>

            <!--  Charset (mod 26 / 36 / 95)  -->
            <RadioButtons
                Header="{markup:Localize Key=OneTimePadCharset}"
                MaxColumns="3"
                SelectedIndex="{x:Bind ViewModel.CharsetIndex, Mode=TwoWay}">
                <RadioButton Content="{markup:Localize Key=OneTimePadCharsetLetters}" />
                <RadioButton Content="{markup:Localize Key=OneTimePadCharsetLettersDigits}" />
                <RadioButton Content="{markup:Localize Key=OneTimePadCharsetAscii}" />
            </RadioButtons>

            <!--  Key + generate pad  -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    Grid.Column="0"
                    MinHeight="60"
                    AcceptsReturn="False"
                    FontFamily="{ThemeResource AppMonoFontFamily}"
                    Header="{markup:Localize Key=OneTimePadKeyLabel}"
                    IsSpellCheckEnabled="False"
                    PlaceholderText="{markup:Localize Key=OneTimePadKeyPlaceholder}"
                    Text="{x:Bind ViewModel.KeyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.GeneratePadCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8D6;" />
                        <TextBlock Text="{markup:Localize Key=OneTimePadGeneratePad}" />
                    </StackPanel>
                </Button>
            </Grid>

            <!--  Key-too-short warning  -->
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.KeyTooShort, Mode=OneWay}"
                Message="{markup:Localize Key=OneTimePadKeyTooShort}"
                Severity="Warning" />

            <!--  Input  -->
            <TextBox
                MinHeight="96"
                AcceptsReturn="True"
                Header="{markup:Localize Key=OneTimePadInputLabel}"
                PlaceholderText="{markup:Localize Key=OneTimePadInputPlaceholder}"
                Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Command="{x:Bind ViewModel.ClearCommand}" Content="{markup:Localize Key=OneTimePadClear}" />
                <ToggleSwitch
                    VerticalAlignment="Center"
                    Header="{markup:Localize Key=OneTimePadPreserve}"
                    IsOn="{x:Bind ViewModel.PreserveNonLetters, Mode=TwoWay}" />
            </StackPanel>

            <!--  Result  -->
            <StackPanel Spacing="8">
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=OneTimePadOutputLabel}" />
                <TextBox
                    MinHeight="96"
                    AcceptsReturn="True"
                    FontFamily="{ThemeResource AppMonoFontFamily}"
                    FontSize="18"
                    IsReadOnly="True"
                    IsSpellCheckEnabled="False"
                    Text="{x:Bind ViewModel.OutputText, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!--  Output actions  -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.CopyOutputCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                        <TextBlock Text="{markup:Localize Key=OneTimePadCopy}" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.ShareOutputCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE72D;" />
                        <TextBlock Text="{markup:Localize Key=OneTimePadShare}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!--  Explainer (one-time pad security note)  -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{markup:Localize Key=OneTimePadNote}"
                    TextWrapping="Wrap" />
            </Border>

        </StackPanel>
    </controls:ToolPage>
</local:OneTimePadViewBase>
