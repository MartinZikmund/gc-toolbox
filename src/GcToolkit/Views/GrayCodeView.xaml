<local:GrayCodeViewBase
    x:Class="GcToolkit.Views.GrayCodeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup"
    xmlns:tools="using:GcToolkit.Core.ViewModels.Tools"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <local:GrayCodeViewBase.Resources>
        <Style x:Key="GrayCellTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style
            x:Key="GrayHeaderTextStyle"
            BasedOn="{StaticResource CaptionTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </local:GrayCodeViewBase.Resources>

    <Grid MaxWidth="1024" HorizontalAlignment="Center">
        <ScrollViewer Padding="24" HorizontalContentAlignment="Center">
            <StackPanel HorizontalAlignment="Stretch" Spacing="16">

                <!--  Header: tool name + favorite toggle  -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock
                            Style="{ThemeResource TitleLargeTextBlockStyle}"
                            Text="{x:Bind ViewModel.ToolName, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.Tooltip, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleButton
                        Grid.Column="1"
                        Width="44"
                        Height="44"
                        Padding="0"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{markup:Localize Key=AddToFavorites}"
                        Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                        IsChecked="{x:Bind ViewModel.IsFavorite, Mode=OneWay}"
                        ToolTipService.ToolTip="{markup:Localize Key=AddToFavorites}">
                        <FontIcon FontSize="18" Glyph="&#xE734;" />
                    </ToggleButton>
                </Grid>

                <!--  Direction  -->
                <RadioButtons MaxColumns="2" SelectedIndex="{x:Bind ViewModel.DirectionIndex, Mode=TwoWay}">
                    <RadioButton Content="{markup:Localize Key=GrayValueToGray}" />
                    <RadioButton Content="{markup:Localize Key=GrayGrayToValue}" />
                </RadioButtons>

                <!--  Options: input/output base + bit width + letter mode  -->
                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ComboBox
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Header="{markup:Localize Key=GrayInputBaseLabel}"
                        IsEnabled="{x:Bind ViewModel.LetterMode, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                        SelectedIndex="{x:Bind ViewModel.InputRadixIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="{markup:Localize Key=GrayBaseDecimal}" />
                        <ComboBoxItem Content="{markup:Localize Key=GrayBaseBinary}" />
                        <ComboBoxItem Content="{markup:Localize Key=GrayBaseOctal}" />
                        <ComboBoxItem Content="{markup:Localize Key=GrayBaseHex}" />
                    </ComboBox>

                    <ComboBox
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Header="{markup:Localize Key=GrayOutputBaseLabel}"
                        IsEnabled="{x:Bind ViewModel.LetterMode, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                        SelectedIndex="{x:Bind ViewModel.OutputRadixIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="{markup:Localize Key=GrayBaseDecimal}" />
                        <ComboBoxItem Content="{markup:Localize Key=GrayBaseBinary}" />
                        <ComboBoxItem Content="{markup:Localize Key=GrayBaseOctal}" />
                        <ComboBoxItem Content="{markup:Localize Key=GrayBaseHex}" />
                    </ComboBox>

                    <ComboBox
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        Header="{markup:Localize Key=GrayBitWidthLabel}"
                        IsEnabled="{x:Bind ViewModel.LetterMode, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                        SelectedIndex="{x:Bind ViewModel.BitWidthIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="{markup:Localize Key=GrayWidthAuto}" />
                        <ComboBoxItem Content="4" />
                        <ComboBoxItem Content="5" />
                        <ComboBoxItem Content="8" />
                        <ComboBoxItem Content="16" />
                    </ComboBox>
                </Grid>

                <ToggleSwitch
                    Header="{markup:Localize Key=GrayLetterMode}"
                    IsOn="{x:Bind ViewModel.LetterMode, Mode=TwoWay}"
                    OffContent=""
                    OnContent="" />

                <!--  Input  -->
                <TextBox
                    MinHeight="96"
                    AcceptsReturn="True"
                    FontFamily="Consolas"
                    Header="{markup:Localize Key=GrayInputLabel}"
                    IsSpellCheckEnabled="False"
                    PlaceholderText="{markup:Localize Key=GrayInputPlaceholder}"
                    Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.LoadExampleCommand}" Content="{markup:Localize Key=GrayExample}" />
                    <Button Command="{x:Bind ViewModel.ClearCommand}" Content="{markup:Localize Key=GrayClear}" />
                </StackPanel>

                <!--  Result  -->
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.ResultLabel, Mode=OneWay}" />
                <TextBox
                    MinHeight="96"
                    AcceptsReturn="True"
                    FontFamily="Consolas"
                    FontSize="18"
                    IsReadOnly="True"
                    IsSpellCheckEnabled="False"
                    Text="{x:Bind ViewModel.OutputText, Mode=OneWay}"
                    TextWrapping="Wrap" />

                <!--  Validation notice  -->
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasWarning, Mode=OneWay}"
                    Message="{x:Bind ViewModel.WarningMessage, Mode=OneWay}"
                    Severity="Warning" />

                <!--  Output actions  -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.CopyOutputCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                            <TextBlock Text="{markup:Localize Key=GrayCopy}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ShareOutputCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE72D;" />
                            <TextBlock Text="{markup:Localize Key=GrayShare}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--  XOR cascade (single value only)  -->
                <Expander
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Header="{markup:Localize Key=GrayCascadeLabel}"
                    IsExpanded="True"
                    Visibility="{x:Bind ViewModel.ShowCascade, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.CascadeLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock
                                    Margin="0,2"
                                    FontFamily="Consolas"
                                    FontSize="16"
                                    Text="{x:Bind}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <!--  Inline reference table (first 16 Gray codes)  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=GrayReferenceLabel}" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Style="{StaticResource GrayHeaderTextStyle}"
                                Text="{markup:Localize Key=GrayReferenceDecimal}" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource GrayHeaderTextStyle}"
                                Text="{markup:Localize Key=GrayReferenceBinary}" />
                            <TextBlock
                                Grid.Column="2"
                                Style="{StaticResource GrayHeaderTextStyle}"
                                Text="{markup:Localize Key=GrayReferenceGray}" />
                        </Grid>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.ReferenceRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="tools:GrayReferenceRow">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Style="{StaticResource GrayCellTextStyle}"
                                            Text="{x:Bind Decimal}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource GrayCellTextStyle}"
                                            Text="{x:Bind Binary}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Style="{StaticResource GrayCellTextStyle}"
                                            Text="{x:Bind Gray}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!--  About  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=GrayAboutLabel}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{markup:Localize Key=GrayAboutText}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:GrayCodeViewBase>
