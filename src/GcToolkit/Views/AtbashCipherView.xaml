<local:AtbashCipherViewBase
    x:Class="GcToolkit.Views.AtbashCipherView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GcToolkit.Controls"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup">

    <controls:ToolPage Tool="{x:Bind ViewModel}">
        <StackPanel Spacing="16">


            <!--  Self-inverse hint: one transform both encodes and decodes  -->
            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="{markup:Localize Key=AtbashSelfInverseNote}"
                Severity="Informational" />

            <!--  Input  -->
            <TextBox
                MinHeight="96"
                AcceptsReturn="True"
                Header="{markup:Localize Key=AtbashInputLabel}"
                PlaceholderText="{markup:Localize Key=AtbashInputPlaceholder}"
                Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />

            <Button Command="{x:Bind ViewModel.ClearCommand}" Content="{markup:Localize Key=AtbashClear}" />

            <!--  Result  -->
            <StackPanel Spacing="8">
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=AtbashOutputLabel}" />
                <TextBox
                    MinHeight="96"
                    AcceptsReturn="True"
                    AutomationProperties.Name="{markup:Localize Key=AtbashOutputLabel}"
                    FontFamily="{ThemeResource AppMonoFontFamily}"
                    FontSize="18"
                    IsReadOnly="True"
                    IsSpellCheckEnabled="False"
                    Text="{x:Bind ViewModel.OutputText, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!--  Output actions  -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.CopyOutputCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                        <TextBlock Text="{markup:Localize Key=AtbashCopy}" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.ShareOutputCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE72D;" />
                        <TextBlock Text="{markup:Localize Key=AtbashShare}" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.UseOutputAsInputCommand}" ToolTipService.ToolTip="{markup:Localize Key=AtbashUseOutputAsInput}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8AB;" />
                        <TextBlock Text="{markup:Localize Key=AtbashUseOutputAsInput}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!--  Substitution key (geocachingtoolbox "Key" parity)  -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=AtbashKeyLabel}" />
                    <TextBlock
                        FontFamily="{ThemeResource AppMonoFontFamily}"
                        FontSize="15"
                        Text="{x:Bind ViewModel.KeyPlain}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontFamily="{ThemeResource AppMonoFontFamily}"
                        FontSize="15"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Text="{x:Bind ViewModel.KeyCipher}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{markup:Localize Key=AtbashKeyNote}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </controls:ToolPage>
</local:AtbashCipherViewBase>
