<local:SubstitutionCipherViewBase
    x:Class="GcToolkit.Views.SubstitutionCipherView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="24">
        <StackPanel
            MaxWidth="760"
            HorizontalAlignment="Center"
            Spacing="16">

            <!--  Header: tool name + favorite toggle  -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock
                        Style="{ThemeResource TitleLargeTextBlockStyle}"
                        Text="{x:Bind ViewModel.ToolName, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.Tooltip, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <ToggleButton
                    Grid.Column="1"
                    Width="44"
                    Height="44"
                    Padding="0"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="{markup:Localize Key=AddToFavorites}"
                    Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                    IsChecked="{x:Bind ViewModel.IsFavorite, Mode=OneWay}"
                    ToolTipService.ToolTip="{markup:Localize Key=AddToFavorites}">
                    <FontIcon FontSize="18" Glyph="&#xE734;" />
                </ToggleButton>
            </Grid>

            <!--  Direction  -->
            <RadioButtons MaxColumns="2" SelectedIndex="{x:Bind ViewModel.DirectionIndex, Mode=TwoWay}">
                <RadioButton Content="{markup:Localize Key=SubstitutionCipherEncode}" />
                <RadioButton Content="{markup:Localize Key=SubstitutionCipherDecode}" />
            </RadioButtons>

            <!--  Substitution key  -->
            <StackPanel Spacing="8">
                <TextBox
                    FontFamily="Consolas"
                    FontSize="16"
                    Header="{markup:Localize Key=SubstitutionCipherKeyLabel}"
                    IsSpellCheckEnabled="False"
                    PlaceholderText="{markup:Localize Key=SubstitutionCipherKeyPlaceholder}"
                    Text="{x:Bind ViewModel.Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasKeyError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.KeyErrorMessage, Mode=OneWay}"
                    Severity="Warning" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.AutoCompleteKeyCommand}" Content="{markup:Localize Key=SubstitutionCipherAutoComplete}" />
                    <Button Command="{x:Bind ViewModel.InvertKeyCommand}" Content="{markup:Localize Key=SubstitutionCipherInvert}" />
                    <Button Command="{x:Bind ViewModel.ResetKeyCommand}" Content="{markup:Localize Key=SubstitutionCipherResetKey}" />
                </StackPanel>
            </StackPanel>

            <!--  Keyword → alphabet generator  -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    Grid.Column="0"
                    VerticalAlignment="Bottom"
                    Header="{markup:Localize Key=SubstitutionCipherKeyword}"
                    PlaceholderText="{markup:Localize Key=SubstitutionCipherKeywordPlaceholder}"
                    Text="{x:Bind ViewModel.Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.GenerateFromKeywordCommand}"
                    Content="{markup:Localize Key=SubstitutionCipherGenerate}" />
            </Grid>

            <!--  Options  -->
            <StackPanel Orientation="Horizontal" Spacing="16">
                <ToggleSwitch
                    VerticalAlignment="Center"
                    Header="{markup:Localize Key=SubstitutionCipherCaseSensitive}"
                    IsOn="{x:Bind ViewModel.CaseSensitive, Mode=TwoWay}" />
            </StackPanel>

            <RadioButtons
                Header="{markup:Localize Key=SubstitutionCipherUnknownLabel}"
                MaxColumns="3"
                SelectedIndex="{x:Bind ViewModel.UnknownHandlingIndex, Mode=TwoWay}">
                <RadioButton Content="{markup:Localize Key=SubstitutionCipherUnknownPreserve}" />
                <RadioButton Content="{markup:Localize Key=SubstitutionCipherUnknownRemove}" />
                <RadioButton Content="{markup:Localize Key=SubstitutionCipherUnknownReplace}" />
            </RadioButtons>

            <!--  Input  -->
            <TextBox
                MinHeight="96"
                AcceptsReturn="True"
                Header="{markup:Localize Key=SubstitutionCipherInputLabel}"
                PlaceholderText="{markup:Localize Key=SubstitutionCipherInputPlaceholder}"
                Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />

            <Button Command="{x:Bind ViewModel.ClearCommand}" Content="{markup:Localize Key=SubstitutionCipherClear}" />

            <!--  Result  -->
            <StackPanel Spacing="8">
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=SubstitutionCipherOutputLabel}" />
                <TextBox
                    MinHeight="96"
                    AcceptsReturn="True"
                    FontFamily="Consolas"
                    FontSize="18"
                    IsReadOnly="True"
                    IsSpellCheckEnabled="False"
                    Text="{x:Bind ViewModel.OutputText, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!--  Output actions  -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.CopyOutputCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                        <TextBlock Text="{markup:Localize Key=SubstitutionCipherCopy}" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.ShareOutputCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE72D;" />
                        <TextBlock Text="{markup:Localize Key=SubstitutionCipherShare}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!--  Substitution key display (aligned plain ↔ key rows)  -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=SubstitutionCipherKeyMapLabel}" />
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="15"
                        Text="{x:Bind ViewModel.KeyPlain, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="15"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Text="{x:Bind ViewModel.KeyCipher, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{markup:Localize Key=SubstitutionCipherKeyNote}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</local:SubstitutionCipherViewBase>
