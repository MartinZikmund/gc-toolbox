<local:ColumnarTranspositionViewBase
    x:Class="GcToolkit.Views.ColumnarTranspositionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup"
    xmlns:tools="using:GcToolkit.Core.ViewModels.Tools"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <local:ColumnarTranspositionViewBase.Resources>

        <!--  One column header: keyword letter + resolved read order  -->
        <DataTemplate x:Key="ColumnarHeaderTemplate" x:DataType="tools:ColumnarHeaderCell">
            <Border
                Margin="2"
                Padding="6,4"
                Background="{ThemeResource AccentControlElevationBorderBrush}"
                CornerRadius="6">
                <StackPanel>
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="Consolas"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Letter}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind OrderText}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--  One grid cell: a single character (empty for unfilled trailing cells)  -->
        <DataTemplate x:Key="ColumnarCellTemplate" x:DataType="tools:ColumnarGridCell">
            <Border
                MinWidth="32"
                MinHeight="32"
                Margin="2"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="4">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="16"
                    Text="{x:Bind Glyph}" />
            </Border>
        </DataTemplate>

    </local:ColumnarTranspositionViewBase.Resources>

    <Grid MaxWidth="1024" HorizontalAlignment="Center">
        <ScrollViewer Padding="24" HorizontalContentAlignment="Center">
            <StackPanel HorizontalAlignment="Stretch" Spacing="16">

                <!--  Header: tool name + favorite toggle  -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock
                            Style="{ThemeResource TitleLargeTextBlockStyle}"
                            Text="{x:Bind ViewModel.ToolName, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.Tooltip, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleButton
                        Grid.Column="1"
                        Width="44"
                        Height="44"
                        Padding="0"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{markup:Localize Key=AddToFavorites}"
                        Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                        IsChecked="{x:Bind ViewModel.IsFavorite, Mode=OneWay}"
                        ToolTipService.ToolTip="{markup:Localize Key=AddToFavorites}">
                        <FontIcon FontSize="18" Glyph="&#xE734;" />
                    </ToggleButton>
                </Grid>

                <!--  Direction  -->
                <RadioButtons MaxColumns="2" SelectedIndex="{x:Bind ViewModel.DirectionIndex, Mode=TwoWay}">
                    <RadioButton Content="{markup:Localize Key=ColumnarEncrypt}" />
                    <RadioButton Content="{markup:Localize Key=ColumnarDecrypt}" />
                </RadioButtons>

                <!--  Key  -->
                <TextBox
                    FontFamily="Consolas"
                    Header="{markup:Localize Key=ColumnarKeyLabel}"
                    PlaceholderText="{markup:Localize Key=ColumnarKeyPlaceholder}"
                    Text="{x:Bind ViewModel.KeyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{markup:Localize Key=ColumnarKeyHelp}"
                    TextWrapping="Wrap" />

                <!--  Input  -->
                <TextBox
                    MinHeight="96"
                    AcceptsReturn="True"
                    Header="{markup:Localize Key=ColumnarInputLabel}"
                    PlaceholderText="{markup:Localize Key=ColumnarInputPlaceholder}"
                    Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />

                <!--  Input actions  -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.SwapDirectionCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8AB;" />
                            <TextBlock Text="{markup:Localize Key=ColumnarSwap}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ClearCommand}" Content="{markup:Localize Key=ColumnarClear}" />
                </StackPanel>

                <!--  Options  -->
                <Expander
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Header="{markup:Localize Key=ColumnarOptionsLabel}">
                    <StackPanel Spacing="12">
                        <CheckBox Content="{markup:Localize Key=ColumnarPadToRectangle}" IsChecked="{x:Bind ViewModel.PadToRectangle, Mode=TwoWay}" />
                        <TextBox
                            MaxWidth="160"
                            HorizontalAlignment="Left"
                            FontFamily="Consolas"
                            Header="{markup:Localize Key=ColumnarPadCharLabel}"
                            MaxLength="1"
                            Text="{x:Bind ViewModel.PadCharText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox Content="{markup:Localize Key=ColumnarStripPadding}" IsChecked="{x:Bind ViewModel.StripPaddingOnDecode, Mode=TwoWay}" />

                        <CheckBox Content="{markup:Localize Key=ColumnarDoubleTransposition}" IsChecked="{x:Bind ViewModel.UseDoubleTransposition, Mode=TwoWay}" />
                        <TextBox
                            FontFamily="Consolas"
                            Header="{markup:Localize Key=ColumnarSecondKeyLabel}"
                            IsEnabled="{x:Bind ViewModel.UseDoubleTransposition, Mode=OneWay}"
                            PlaceholderText="{markup:Localize Key=ColumnarSecondKeyPlaceholder}"
                            Text="{x:Bind ViewModel.SecondKeyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Expander>

                <!--  Validation  -->
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error" />

                <!--  Result  -->
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=ColumnarOutputLabel}" />
                <TextBox
                    FontFamily="Consolas"
                    FontSize="18"
                    IsReadOnly="True"
                    IsSpellCheckEnabled="False"
                    Text="{x:Bind ViewModel.OutputText, Mode=OneWay}"
                    TextWrapping="Wrap" />

                <!--  Output actions  -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.CopyOutputCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                            <TextBlock Text="{markup:Localize Key=ColumnarCopy}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ShareOutputCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE72D;" />
                            <TextBlock Text="{markup:Localize Key=ColumnarShare}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--  Live grid preview  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.HasGrid, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=ColumnarGridLabel}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=ColumnarGridHint}"
                            TextWrapping="Wrap" />

                        <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto">
                            <StackPanel Spacing="4">
                                <!--  Column headers (letter + read order)  -->
                                <ItemsRepeater ItemTemplate="{StaticResource ColumnarHeaderTemplate}" ItemsSource="{x:Bind ViewModel.Headers}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout
                                            ItemsStretch="Fill"
                                            MaximumRowsOrColumns="{x:Bind ViewModel.ColumnCount, Mode=OneWay}"
                                            MinColumnSpacing="0"
                                            MinItemWidth="36"
                                            MinRowSpacing="0"
                                            Orientation="Horizontal" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>

                                <!--  Grid cells, row-major  -->
                                <ItemsRepeater ItemTemplate="{StaticResource ColumnarCellTemplate}" ItemsSource="{x:Bind ViewModel.GridCells}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout
                                            ItemsStretch="Fill"
                                            MaximumRowsOrColumns="{x:Bind ViewModel.ColumnCount, Mode=OneWay}"
                                            MinColumnSpacing="0"
                                            MinItemWidth="36"
                                            MinRowSpacing="0"
                                            Orientation="Horizontal" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:ColumnarTranspositionViewBase>
