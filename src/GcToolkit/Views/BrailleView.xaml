<local:BrailleViewBase
    x:Class="GcToolkit.Views.BrailleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:alphabets="using:GcToolkit.Core.Alphabets"
    xmlns:controls="using:GcToolkit.Controls"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup">

    <controls:ToolPage Tool="{x:Bind ViewModel}">
        <StackPanel Spacing="16">

            <!--  Direction  -->
            <RadioButtons MaxColumns="2" SelectedIndex="{x:Bind ViewModel.DirectionIndex, Mode=TwoWay}">
                <RadioButton Content="{markup:Localize Key=BrailleTextToBraille}" />
                <RadioButton Content="{markup:Localize Key=BrailleBrailleToText}" />
            </RadioButtons>

            <!--  Input  -->
            <TextBox
                MinHeight="96"
                AcceptsReturn="True"
                Header="{markup:Localize Key=BrailleInputLabel}"
                PlaceholderText="{markup:Localize Key=BrailleInputPlaceholder}"
                Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />

            <Button Command="{x:Bind ViewModel.ClearCommand}" Content="{markup:Localize Key=BrailleClear}" />

            <!--  Clickable braille reference chart — click a cell to "type" it  -->
            <Expander
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsExpanded="True">
                <Expander.Header>
                    <StackPanel Spacing="2">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=BrailleAlphabetTitle}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=BrailleAlphabetHint}" />
                    </StackPanel>
                </Expander.Header>
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Alphabet}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="None"
                            MinColumnSpacing="8"
                            MinItemWidth="78"
                            MinRowSpacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="alphabets:BraillePaletteEntry">
                            <Button
                                Padding="6,8"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                AutomationProperties.Name="{x:Bind Label}"
                                Click="OnAlphabetItemClick"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="{x:Bind DotNumbers}">
                                <StackPanel HorizontalAlignment="Center" Spacing="6">
                                    <controls:BrailleCell
                                        HorizontalAlignment="Center"
                                        Dot1="{x:Bind Dots.Dot1}"
                                        Dot2="{x:Bind Dots.Dot2}"
                                        Dot3="{x:Bind Dots.Dot3}"
                                        Dot4="{x:Bind Dots.Dot4}"
                                        Dot5="{x:Bind Dots.Dot5}"
                                        Dot6="{x:Bind Dots.Dot6}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Label}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Expander>

            <!--  Braille shown as dot grids (filled vs. hollow circles)  -->
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasGlyphs, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=BrailleVisualLabel}" />
                <Border
                    Padding="16"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="8">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Glyphs}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                ItemsStretch="None"
                                MinColumnSpacing="10"
                                MinItemWidth="40"
                                MinRowSpacing="10" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="alphabets:BrailleGlyph">
                                <controls:BrailleCell
                                    HorizontalAlignment="Center"
                                    Dot1="{x:Bind Dots.Dot1}"
                                    Dot2="{x:Bind Dots.Dot2}"
                                    Dot3="{x:Bind Dots.Dot3}"
                                    Dot4="{x:Bind Dots.Dot4}"
                                    Dot5="{x:Bind Dots.Dot5}"
                                    Dot6="{x:Bind Dots.Dot6}"
                                    ToolTipService.ToolTip="{x:Bind DotNumbers}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Border>
            </StackPanel>

            <!--  Result as selectable, copy-pasteable text (real Unicode braille when encoding)  -->
            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=BrailleOutputLabel}" />
            <TextBox
                MinHeight="72"
                AcceptsReturn="True"
                AutomationProperties.Name="{markup:Localize Key=BrailleOutputLabel}"
                FontFamily="{ThemeResource AppMonoFontFamily}"
                FontSize="18"
                IsReadOnly="True"
                IsSpellCheckEnabled="False"
                Text="{x:Bind ViewModel.OutputText, Mode=OneWay}"
                TextWrapping="Wrap" />

            <!--  Output actions  -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.CopyOutputCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                        <TextBlock Text="{markup:Localize Key=BrailleCopy}" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.ShareOutputCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE72D;" />
                        <TextBlock Text="{markup:Localize Key=BrailleShare}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!--  How it works  -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=BrailleAboutTitle}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Text="{markup:Localize Key=BrailleAboutBody}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </controls:ToolPage>
</local:BrailleViewBase>
