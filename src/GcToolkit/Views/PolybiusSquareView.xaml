<local:PolybiusSquareViewBase
    x:Class="GcToolkit.Views.PolybiusSquareView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup"
    xmlns:tools="using:GcToolkit.Core.ViewModels.Tools"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid MaxWidth="1100" HorizontalAlignment="Center">
        <ScrollViewer Padding="24" HorizontalContentAlignment="Center">
            <StackPanel HorizontalAlignment="Stretch" Spacing="16">

                <!--  Header: tool name + favorite toggle  -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock
                            Style="{ThemeResource TitleLargeTextBlockStyle}"
                            Text="{x:Bind ViewModel.ToolName, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.Tooltip, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleButton
                        Grid.Column="1"
                        Width="44"
                        Height="44"
                        Padding="0"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{markup:Localize Key=AddToFavorites}"
                        Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                        IsChecked="{x:Bind ViewModel.IsFavorite, Mode=OneWay}"
                        ToolTipService.ToolTip="{markup:Localize Key=AddToFavorites}">
                        <FontIcon FontSize="18" Glyph="&#xE734;" />
                    </ToggleButton>
                </Grid>

                <!--  Two-pane live editor: plaintext / ciphertext  -->
                <Grid ColumnSpacing="16" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Grid.Column="0"
                        MinHeight="120"
                        AcceptsReturn="True"
                        Header="{markup:Localize Key=PolybiusPlaintextLabel}"
                        IsSpellCheckEnabled="False"
                        PlaceholderText="{markup:Localize Key=PolybiusPlaintextPlaceholder}"
                        Text="{x:Bind ViewModel.PlainText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />

                    <TextBox
                        Grid.Column="1"
                        MinHeight="120"
                        AcceptsReturn="True"
                        FontFamily="Consolas"
                        Header="{markup:Localize Key=PolybiusCiphertextLabel}"
                        IsSpellCheckEnabled="False"
                        PlaceholderText="{markup:Localize Key=PolybiusCiphertextPlaceholder}"
                        Text="{x:Bind ViewModel.CipherText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />
                </Grid>

                <!--  Build error (bad labels / merge)  -->
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error" />

                <!--  Forgiving-decode warning (invalid / leftover pairs)  -->
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasWarning, Mode=OneWay}"
                    Message="{x:Bind ViewModel.WarningMessage, Mode=OneWay}"
                    Severity="Warning" />

                <!--  Output actions  -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.CopyCipherCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                            <TextBlock Text="{markup:Localize Key=PolybiusCopy}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ShareCipherCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE72D;" />
                            <TextBlock Text="{markup:Localize Key=PolybiusShare}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ExampleCommand}" Content="{markup:Localize Key=PolybiusExample}" />
                    <Button Command="{x:Bind ViewModel.ClearCommand}" Content="{markup:Localize Key=PolybiusClear}" />
                    <Button Command="{x:Bind ViewModel.ResetCommand}" Content="{markup:Localize Key=PolybiusReset}" />
                </StackPanel>

                <!--  Rendered, tappable square  -->
                <Border
                    Padding="16"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="{markup:Localize Key=PolybiusSquareLabel}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Cells}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    ItemsStretch="None"
                                    MaximumRowsOrColumns="{x:Bind ViewModel.Side, Mode=OneWay}"
                                    MinColumnSpacing="6"
                                    MinItemHeight="60"
                                    MinItemWidth="60"
                                    MinRowSpacing="6"
                                    Orientation="Horizontal" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="tools:PolybiusCellItem">
                                    <Button
                                        Width="60"
                                        Height="60"
                                        Padding="0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        AutomationProperties.Name="{x:Bind Letter}"
                                        Command="{x:Bind TapCommand}"
                                        ToolTipService.ToolTip="{x:Bind Coordinate}">
                                        <Grid>
                                            <Border
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="4"
                                                Opacity="0.85"
                                                Visibility="{x:Bind IsHighlighted, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="0">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                    Text="{x:Bind Letter}" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontFamily="Consolas"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Coordinate}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=PolybiusTapHint}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  Square options  -->
                <Expander
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Header="{markup:Localize Key=PolybiusOptionsLabel}"
                    IsExpanded="True">
                    <StackPanel Spacing="16">

                        <!--  Grid size + label scheme  -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ComboBox
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Header="{markup:Localize Key=PolybiusGridSizeLabel}"
                                SelectedIndex="{x:Bind ViewModel.GridSizeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="{markup:Localize Key=PolybiusGrid5}" />
                                <ComboBoxItem Content="{markup:Localize Key=PolybiusGrid6}" />
                            </ComboBox>

                            <ComboBox
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Header="{markup:Localize Key=PolybiusLabelsLabel}"
                                SelectedIndex="{x:Bind ViewModel.LabelSchemeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="{markup:Localize Key=PolybiusLabelsDigits}" />
                                <ComboBoxItem Content="{markup:Localize Key=PolybiusLabelsAdfgx}" />
                                <ComboBoxItem Content="{markup:Localize Key=PolybiusLabelsCustom}" />
                            </ComboBox>
                        </Grid>

                        <!--  Custom labels (only for custom scheme)  -->
                        <TextBox
                            Header="{markup:Localize Key=PolybiusCustomLabelsLabel}"
                            MaxLength="6"
                            PlaceholderText="12345"
                            Text="{x:Bind ViewModel.CustomLabels, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="{x:Bind ViewModel.IsCustomLabels, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <!--  Keyword + modifiers  -->
                        <TextBox
                            Header="{markup:Localize Key=PolybiusKeywordLabel}"
                            PlaceholderText="{markup:Localize Key=PolybiusKeywordPlaceholder}"
                            Text="{x:Bind ViewModel.Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <CheckBox Content="{markup:Localize Key=PolybiusReverseKeyword}" IsChecked="{x:Bind ViewModel.ReverseKeyword, Mode=TwoWay}" />
                            <CheckBox Content="{markup:Localize Key=PolybiusUseLastInstance}" IsChecked="{x:Bind ViewModel.UseLastInstance, Mode=TwoWay}" />
                        </StackPanel>

                        <!--  Merge pair (5x5 only)  -->
                        <TextBox
                            Header="{markup:Localize Key=PolybiusMergePairLabel}"
                            MaxLength="2"
                            PlaceholderText="IJ"
                            Text="{x:Bind ViewModel.MergePair, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="{x:Bind ViewModel.IsFiveByFive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                        <!--  Separator + read order  -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ComboBox
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Header="{markup:Localize Key=PolybiusSeparatorLabel}"
                                SelectedIndex="{x:Bind ViewModel.SeparatorIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="{markup:Localize Key=PolybiusSeparatorSpace}" />
                                <ComboBoxItem Content="{markup:Localize Key=PolybiusSeparatorComma}" />
                                <ComboBoxItem Content="{markup:Localize Key=PolybiusSeparatorNone}" />
                                <ComboBoxItem Content="{markup:Localize Key=PolybiusSeparatorCustom}" />
                            </ComboBox>

                            <TextBox
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Header="{markup:Localize Key=PolybiusCustomSeparatorLabel}"
                                MaxLength="4"
                                Text="{x:Bind ViewModel.CustomSeparator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{x:Bind ViewModel.IsCustomSeparator, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>

                        <CheckBox Content="{markup:Localize Key=PolybiusColumnThenRow}" IsChecked="{x:Bind ViewModel.ColumnThenRow, Mode=TwoWay}" />
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:PolybiusSquareViewBase>
