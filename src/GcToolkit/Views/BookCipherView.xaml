<local:BookCipherViewBase
    x:Class="GcToolkit.Views.BookCipherView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid MaxWidth="1024" HorizontalAlignment="Center">
        <ScrollViewer Padding="24" HorizontalContentAlignment="Center">
            <StackPanel HorizontalAlignment="Stretch" Spacing="16">

                <!--  Header: tool name + favorite toggle  -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock
                            Style="{ThemeResource TitleLargeTextBlockStyle}"
                            Text="{x:Bind ViewModel.ToolName, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.Tooltip, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleButton
                        Grid.Column="1"
                        Width="44"
                        Height="44"
                        Padding="0"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{markup:Localize Key=AddToFavorites}"
                        Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                        IsChecked="{x:Bind ViewModel.IsFavorite, Mode=OneWay}"
                        ToolTipService.ToolTip="{markup:Localize Key=AddToFavorites}">
                        <FontIcon FontSize="18" Glyph="&#xE734;" />
                    </ToggleButton>
                </Grid>

                <!--  Direction  -->
                <RadioButtons MaxColumns="2" SelectedIndex="{x:Bind ViewModel.DirectionIndex, Mode=TwoWay}">
                    <RadioButton Content="{markup:Localize Key=BookCipherDecode}" />
                    <RadioButton Content="{markup:Localize Key=BookCipherEncode}" />
                </RadioButtons>

                <!--  Book / source text  -->
                <TextBox
                    MinHeight="120"
                    AcceptsReturn="True"
                    FontFamily="Consolas"
                    Header="{markup:Localize Key=BookCipherBookLabel}"
                    PlaceholderText="{markup:Localize Key=BookCipherBookPlaceholder}"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    Text="{x:Bind ViewModel.BookText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />

                <!--  Codes (decode) / plaintext (encode) — same bound field, label switches  -->
                <TextBox
                    MinHeight="80"
                    AcceptsReturn="True"
                    FontFamily="Consolas"
                    Header="{markup:Localize Key=BookCipherCodesLabel}"
                    PlaceholderText="{markup:Localize Key=BookCipherCodesPlaceholder}"
                    Text="{x:Bind ViewModel.CodesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.IsEncoding, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
                <TextBox
                    MinHeight="80"
                    AcceptsReturn="True"
                    Header="{markup:Localize Key=BookCipherPlaintextLabel}"
                    PlaceholderText="{markup:Localize Key=BookCipherPlaintextPlaceholder}"
                    Text="{x:Bind ViewModel.CodesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.IsEncoding, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!--  Reference format  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=BookCipherFormatHeader}" />

                        <!--  Three ordered parts  -->
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ComboBox
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Header="{markup:Localize Key=BookCipherPart1}"
                                SelectedIndex="{x:Bind ViewModel.Part1Index, Mode=TwoWay}">
                                <ComboBoxItem Content="{markup:Localize Key=BookCipherPartNone}" />
                                <ComboBoxItem Content="{markup:Localize Key=BookCipherPartPage}" />
                                <ComboBoxItem Content="{markup:Localize Key=BookCipherPartLine}" />
                                <ComboBoxItem Content="{markup:Localize Key=BookCipherPartWord}" />
                                <ComboBoxItem Content="{markup:Localize Key=BookCipherPartCharacter}" />
                            </ComboBox>

                            <ComboBox
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Header="{markup:Localize Key=BookCipherPart2}"
                                SelectedIndex="{x:Bind ViewModel.Part2Index, Mode=TwoWay}">
                                <ComboBoxItem Content="{markup:Localize Key=BookCipherPartNone}" />
                                <ComboBoxItem Content="{markup:Localize Key=BookCipherPartPage}" />
                                <ComboBoxItem Content="{markup:Localize Key=BookCipherPartLine}" />
                                <ComboBoxItem Content="{markup:Localize Key=BookCipherPartWord}" />
                                <ComboBoxItem Content="{markup:Localize Key=BookCipherPartCharacter}" />
                            </ComboBox>

                            <ComboBox
                                Grid.Column="2"
                                HorizontalAlignment="Stretch"
                                Header="{markup:Localize Key=BookCipherPart3}"
                                SelectedIndex="{x:Bind ViewModel.Part3Index, Mode=TwoWay}">
                                <ComboBoxItem Content="{markup:Localize Key=BookCipherPartNone}" />
                                <ComboBoxItem Content="{markup:Localize Key=BookCipherPartPage}" />
                                <ComboBoxItem Content="{markup:Localize Key=BookCipherPartLine}" />
                                <ComboBoxItem Content="{markup:Localize Key=BookCipherPartWord}" />
                                <ComboBoxItem Content="{markup:Localize Key=BookCipherPartCharacter}" />
                            </ComboBox>
                        </Grid>

                        <!--  Numbering base + extraction  -->
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ComboBox
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Header="{markup:Localize Key=BookCipherNumberingLabel}"
                                SelectedIndex="{x:Bind ViewModel.NumberingBaseIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="{markup:Localize Key=BookCipherNumbering1}" />
                                <ComboBoxItem Content="{markup:Localize Key=BookCipherNumbering0}" />
                            </ComboBox>

                            <ComboBox
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Header="{markup:Localize Key=BookCipherExtractionLabel}"
                                SelectedIndex="{x:Bind ViewModel.ExtractionIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="{markup:Localize Key=BookCipherExtractionWhole}" />
                                <ComboBoxItem Content="{markup:Localize Key=BookCipherExtractionFirst}" />
                                <ComboBoxItem Content="{markup:Localize Key=BookCipherExtractionNth}" />
                            </ComboBox>
                        </Grid>

                        <!--  Nth-letter index (only in Nth-letter mode)  -->
                        <NumberBox
                            MaxWidth="200"
                            HorizontalAlignment="Left"
                            Header="{markup:Localize Key=BookCipherLetterIndexLabel}"
                            Minimum="1"
                            SpinButtonPlacementMode="Inline"
                            Visibility="{x:Bind ViewModel.ShowLetterIndex, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            Value="{x:Bind ViewModel.LetterIndex, Mode=TwoWay}" />

                        <!--  Ignore symbols + spaces  -->
                        <TextBox
                            Header="{markup:Localize Key=BookCipherIgnoreSymbolsLabel}"
                            PlaceholderText="{markup:Localize Key=BookCipherIgnoreSymbolsPlaceholder}"
                            Text="{x:Bind ViewModel.IgnoreSymbols, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <CheckBox Content="{markup:Localize Key=BookCipherIgnoreSpaces}" IsChecked="{x:Bind ViewModel.IgnoreSpaces, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <!--  Actions  -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.SwapDirectionCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8AB;" />
                            <TextBlock Text="{markup:Localize Key=BookCipherSwap}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ClearCommand}" Content="{markup:Localize Key=BookCipherClear}" />
                </StackPanel>

                <!--  Result  -->
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=BookCipherOutputLabel}" />
                <TextBox
                    MinHeight="64"
                    AcceptsReturn="True"
                    FontFamily="Consolas"
                    FontSize="18"
                    IsReadOnly="True"
                    IsSpellCheckEnabled="False"
                    Text="{x:Bind ViewModel.OutputText, Mode=OneWay}"
                    TextWrapping="Wrap" />

                <!--  Validation / warning notice  -->
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasWarning, Mode=OneWay}"
                    Message="{x:Bind ViewModel.WarningMessage, Mode=OneWay}"
                    Severity="Warning" />

                <!--  Output actions  -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.CopyOutputCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                            <TextBlock Text="{markup:Localize Key=BookCipherCopy}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ShareOutputCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE72D;" />
                            <TextBlock Text="{markup:Localize Key=BookCipherShare}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--  Help  -->
                <Expander
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Header="{markup:Localize Key=BookCipherHelpHeader}">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Text="{markup:Localize Key=BookCipherHelpText}"
                        TextWrapping="Wrap" />
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:BookCipherViewBase>
