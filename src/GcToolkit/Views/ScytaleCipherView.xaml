<local:ScytaleCipherViewBase
    x:Class="GcToolkit.Views.ScytaleCipherView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GcToolkit.Controls"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup"
    xmlns:tools="using:GcToolkit.Core.ViewModels.Tools">

    <controls:ToolPage Tool="{x:Bind ViewModel}">
        <StackPanel Spacing="16">


            <!--  Direction  -->
            <RadioButtons MaxColumns="2" SelectedIndex="{x:Bind ViewModel.DirectionIndex, Mode=TwoWay}">
                <RadioButton Content="{markup:Localize Key=ScytaleEncrypt}" />
                <RadioButton Content="{markup:Localize Key=ScytaleDecrypt}" />
            </RadioButtons>

            <!--  Columns (rod diameter) + random  -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <NumberBox
                    Grid.Column="0"
                    Header="{markup:Localize Key=ScytaleColumns}"
                    LargeChange="2"
                    Minimum="2"
                    SmallChange="1"
                    SpinButtonPlacementMode="Inline"
                    Value="{x:Bind ViewModel.Columns, Mode=TwoWay}" />
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.RandomizeColumnsCommand}"
                    Content="{markup:Localize Key=ScytaleRandomColumns}" />
            </Grid>

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasColumnError, Mode=OneWay}"
                Message="{markup:Localize Key=ScytaleColumnError}"
                Severity="Error" />

            <!--  Options: ignore spaces + extra/pad character  -->
            <StackPanel Orientation="Horizontal" Spacing="16">
                <ToggleSwitch
                    VerticalAlignment="Center"
                    Header="{markup:Localize Key=ScytaleIgnoreSpaces}"
                    IsOn="{x:Bind ViewModel.IgnoreSpaces, Mode=TwoWay}" />
                <ToggleSwitch
                    VerticalAlignment="Center"
                    Header="{markup:Localize Key=ScytaleUsePadCharacter}"
                    IsOn="{x:Bind ViewModel.UsePadCharacter, Mode=TwoWay}" />
                <TextBox
                    Width="64"
                    VerticalAlignment="Bottom"
                    Header="{markup:Localize Key=ScytalePadCharacter}"
                    IsEnabled="{x:Bind ViewModel.UsePadCharacter, Mode=OneWay}"
                    MaxLength="1"
                    Text="{x:Bind ViewModel.PadCharacter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!--  Input  -->
            <TextBox
                MinHeight="96"
                AcceptsReturn="True"
                Header="{markup:Localize Key=ScytaleInputLabel}"
                PlaceholderText="{markup:Localize Key=ScytaleInputPlaceholder}"
                Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Command="{x:Bind ViewModel.ClearCommand}" Content="{markup:Localize Key=ScytaleClear}" />
                <ToggleSwitch
                    VerticalAlignment="Center"
                    Header="{markup:Localize Key=ScytaleAutoSolve}"
                    IsOn="{x:Bind ViewModel.AutoSolve, Mode=TwoWay}" />
            </StackPanel>

            <!--  Single result (hidden while auto-solving)  -->
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.AutoSolve, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=ScytaleOutputLabel}" />
                <TextBox
                    MinHeight="96"
                    AcceptsReturn="True"
                    FontFamily="{ThemeResource AppMonoFontFamily}"
                    FontSize="18"
                    IsReadOnly="True"
                    IsSpellCheckEnabled="False"
                    Text="{x:Bind ViewModel.OutputText, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!--  Auto-solve candidates — visible only in auto-solve mode  -->
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.AutoSolve, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=ScytaleAutoSolveLabel}" />
                <!--  ListView virtualizes the brute-force rows so only visible ones are realized.  -->
                <ListView
                    MaxHeight="420"
                    ItemsSource="{x:Bind ViewModel.SolveResults, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="tools:ScytaleSolveItem">
                            <Grid
                                Margin="0,2"
                                Padding="8,6"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                ColumnSpacing="12"
                                CornerRadius="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    HorizontalTextAlignment="Right"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Columns}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontFamily="{ThemeResource AppMonoFontFamily}"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind Text}"
                                    TextWrapping="Wrap" />
                                <Button
                                    Grid.Column="2"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{markup:Localize Key=ScytaleCopyCandidate}"
                                    Command="{x:Bind CopyCommand}"
                                    ToolTipService.ToolTip="{markup:Localize Key=ScytaleCopyCandidate}">
                                    <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <!--  Output actions  -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.CopyOutputCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                        <TextBlock Text="{markup:Localize Key=ScytaleCopy}" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.ShareOutputCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE72D;" />
                        <TextBlock Text="{markup:Localize Key=ScytaleShare}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!--  How it works  -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=ScytaleAboutLabel}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{markup:Localize Key=ScytaleAboutNote}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </controls:ToolPage>
</local:ScytaleCipherViewBase>
