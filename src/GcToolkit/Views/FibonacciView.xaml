<local:FibonacciViewBase
    x:Class="GcToolkit.Views.FibonacciView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid MaxWidth="1024" HorizontalAlignment="Center">
        <ScrollViewer
            x:Name="RootScroll"
            Padding="24"
            HorizontalContentAlignment="Center">
            <StackPanel HorizontalAlignment="Stretch" Spacing="16">

                <!--  Header: tool name + favorite toggle  -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock
                            Style="{ThemeResource TitleLargeTextBlockStyle}"
                            Text="{x:Bind ViewModel.ToolName, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.Tooltip, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleButton
                        Grid.Column="1"
                        Width="44"
                        Height="44"
                        Padding="0"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{markup:Localize Key=AddToFavorites}"
                        Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                        IsChecked="{x:Bind ViewModel.IsFavorite, Mode=OneWay}"
                        ToolTipService.ToolTip="{markup:Localize Key=AddToFavorites}">
                        <FontIcon FontSize="18" Glyph="&#xE734;" />
                    </ToggleButton>
                </Grid>

                <!--  Function selection  -->
                <ComboBox
                    HorizontalAlignment="Stretch"
                    Header="{markup:Localize Key=FibonacciFunctionLabel}"
                    SelectedIndex="{x:Bind ViewModel.ModeIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{markup:Localize Key=FibonacciModeCheck}" />
                    <ComboBoxItem Content="{markup:Localize Key=FibonacciModeAtIndex}" />
                    <ComboBoxItem Content="{markup:Localize Key=FibonacciModeRange}" />
                    <ComboBoxItem Content="{markup:Localize Key=FibonacciModeIndexOf}" />
                    <ComboBoxItem Content="{markup:Localize Key=FibonacciModeByDigits}" />
                </ComboBox>

                <!--  Inputs (one set per function)  -->
                <TextBox
                    Header="{markup:Localize Key=FibonacciValueLabel}"
                    InputScope="Number"
                    PlaceholderText="{markup:Localize Key=FibonacciValuePlaceholder}"
                    Text="{x:Bind ViewModel.ValueInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.IsValueInputVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <TextBox
                    Header="{markup:Localize Key=FibonacciIndexLabel}"
                    InputScope="Number"
                    PlaceholderText="{markup:Localize Key=FibonacciIndexPlaceholder}"
                    Text="{x:Bind ViewModel.IndexInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Visibility="{x:Bind ViewModel.IsIndexInputVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.IsRangeInputVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Grid.Column="0"
                        Header="{markup:Localize Key=FibonacciFromLabel}"
                        InputScope="Number"
                        PlaceholderText="{markup:Localize Key=FibonacciIndexPlaceholder}"
                        Text="{x:Bind ViewModel.FromInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox
                        Grid.Column="1"
                        Header="{markup:Localize Key=FibonacciToLabel}"
                        InputScope="Number"
                        PlaceholderText="{markup:Localize Key=FibonacciIndexPlaceholder}"
                        Text="{x:Bind ViewModel.ToInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <TextBox
                    Header="{markup:Localize Key=FibonacciDigitsLabel}"
                    InputScope="Number"
                    PlaceholderText="{markup:Localize Key=FibonacciDigitsPlaceholder}"
                    Text="{x:Bind ViewModel.DigitsInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Visibility="{x:Bind ViewModel.IsDigitsInputVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!--  Display options + clear  -->
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <CheckBox Content="{markup:Localize Key=FibonacciShowPositions}" IsChecked="{x:Bind ViewModel.ShowPositions, Mode=TwoWay}" />
                    <CheckBox Content="{markup:Localize Key=FibonacciShowDigitCounts}" IsChecked="{x:Bind ViewModel.ShowDigitCounts, Mode=TwoWay}" />
                </StackPanel>

                <Button
                    HorizontalAlignment="Left"
                    Command="{x:Bind ViewModel.ClearCommand}"
                    Content="{markup:Localize Key=FibonacciClear}" />

                <!--  Validation errors  -->
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error" />

                <!--  Result  -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="{markup:Localize Key=FibonacciResultLabel}" />
                    <ProgressRing
                        Grid.Column="1"
                        Width="16"
                        Height="16"
                        AutomationProperties.Name="{markup:Localize Key=FibonacciComputing}"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                </Grid>

                <TextBox
                    MaxHeight="420"
                    AcceptsReturn="True"
                    AutomationProperties.Name="{markup:Localize Key=FibonacciResultLabel}"
                    FontFamily="Consolas"
                    IsReadOnly="True"
                    IsSpellCheckEnabled="False"
                    PlaceholderText="{markup:Localize Key=FibonacciResultPlaceholder}"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    Text="{x:Bind ViewModel.OutputText, Mode=OneWay}"
                    TextWrapping="Wrap" />

                <!--  Output actions  -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.CopyOutputCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                            <TextBlock Text="{markup:Localize Key=FibonacciCopy}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ShareOutputCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE72D;" />
                            <TextBlock Text="{markup:Localize Key=FibonacciShare}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--  Zero-based indexing note  -->
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{markup:Localize Key=FibonacciZeroBasedNote}"
                    TextWrapping="Wrap" />

            </StackPanel>
        </ScrollViewer>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="641" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RootScroll.Padding" Value="12" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</local:FibonacciViewBase>
