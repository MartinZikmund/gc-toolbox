<local:ScrabbleScorerViewBase
    x:Class="GcToolkit.Views.ScrabbleScorerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup"
    xmlns:tools="using:GcToolkit.Core.ViewModels.Tools"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <local:ScrabbleScorerViewBase.Resources>
        <!--  One per-word result row  -->
        <DataTemplate x:Key="ScrabbleWordTemplate" x:DataType="tools:ScrabbleWordItem">
            <Border
                Padding="12"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind Word}" />
                        <TextBlock
                            FontFamily="Consolas"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind Breakdown}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        Text="{x:Bind Total}" />

                    <Button
                        Grid.Column="2"
                        Width="40"
                        Height="40"
                        Padding="0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{markup:Localize Key=ScrabbleCopyRow}"
                        Command="{x:Bind CopyCommand}"
                        ToolTipService.ToolTip="{markup:Localize Key=ScrabbleCopyRow}">
                        <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!--  One letter→value reference cell  -->
        <DataTemplate x:Key="ScrabbleReferenceTemplate" x:DataType="tools:ReferenceCell">
            <Border
                MinWidth="44"
                Padding="8,6"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="6">
                <StackPanel>
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="Consolas"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Letter}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind Value}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </local:ScrabbleScorerViewBase.Resources>

    <Grid MaxWidth="1024" HorizontalAlignment="Center">
        <ScrollViewer Padding="24" HorizontalContentAlignment="Center">
            <StackPanel HorizontalAlignment="Stretch" Spacing="16">

                <!--  Header: tool name + favorite toggle  -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock
                            Style="{ThemeResource TitleLargeTextBlockStyle}"
                            Text="{x:Bind ViewModel.ToolName, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.Tooltip, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleButton
                        Grid.Column="1"
                        Width="44"
                        Height="44"
                        Padding="0"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{markup:Localize Key=AddToFavorites}"
                        Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                        IsChecked="{x:Bind ViewModel.IsFavorite, Mode=OneWay}"
                        ToolTipService.ToolTip="{markup:Localize Key=AddToFavorites}">
                        <FontIcon FontSize="18" Glyph="&#xE734;" />
                    </ToggleButton>
                </Grid>

                <!--  Method picker  -->
                <ComboBox
                    HorizontalAlignment="Stretch"
                    DisplayMemberPath="DisplayName"
                    Header="{markup:Localize Key=ScrabbleMethodLabel}"
                    ItemsSource="{x:Bind ViewModel.Systems}"
                    SelectedIndex="{x:Bind ViewModel.SelectedSystemIndex, Mode=TwoWay}" />

                <!--  Custom table editor (custom method only)  -->
                <TextBox
                    FontFamily="Consolas"
                    Header="{markup:Localize Key=ScrabbleCustomTableLabel}"
                    PlaceholderText="{markup:Localize Key=ScrabbleCustomTablePlaceholder}"
                    Text="{x:Bind ViewModel.CustomTableText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.IsCustomSystem, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!--  Input  -->
                <TextBox
                    AcceptsReturn="True"
                    Header="{markup:Localize Key=ScrabbleInputLabel}"
                    PlaceholderText="{markup:Localize Key=ScrabbleInputPlaceholder}"
                    Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />

                <Button
                    HorizontalAlignment="Left"
                    Command="{x:Bind ViewModel.ClearCommand}"
                    Content="{markup:Localize Key=ScrabbleClear}" />

                <!--  Validation / unknown-letter notice  -->
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasWarning, Mode=OneWay}"
                    Message="{x:Bind ViewModel.WarningMessage, Mode=OneWay}"
                    Severity="Warning" />

                <!--  Grand total  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="{markup:Localize Key=ScrabbleTotalLabel}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            Style="{ThemeResource TitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.GrandTotal, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!--  Output actions  -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.CopyTotalCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                            <TextBlock Text="{markup:Localize Key=ScrabbleCopyTotal}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.CopyWordsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                            <TextBlock Text="{markup:Localize Key=ScrabbleCopyWords}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ShareCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE72D;" />
                            <TextBlock Text="{markup:Localize Key=ScrabbleShare}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--  Reductions  -->
                <Expander
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Header="{markup:Localize Key=ScrabbleReductionsLabel}"
                    IsExpanded="True">
                    <Grid ColumnSpacing="24" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{markup:Localize Key=ScrabbleDigitalRootLabel}" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            FontFamily="Consolas"
                            Text="{x:Bind ViewModel.DigitalRootText, Mode=OneWay}" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{markup:Localize Key=ScrabbleDigitSumLabel}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            FontFamily="Consolas"
                            Text="{x:Bind ViewModel.DigitSumText, Mode=OneWay}" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{markup:Localize Key=ScrabbleMod26Label}" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            FontFamily="Consolas"
                            Text="{x:Bind ViewModel.Mod26Text, Mode=OneWay}" />

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{markup:Localize Key=ScrabbleMod10Label}" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            FontFamily="Consolas"
                            Text="{x:Bind ViewModel.Mod10Text, Mode=OneWay}" />

                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{markup:Localize Key=ScrabbleReversedTotalLabel}" />
                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="1"
                            FontFamily="Consolas"
                            Text="{x:Bind ViewModel.ReversedTotalText, Mode=OneWay}" />
                    </Grid>
                </Expander>

                <!--  Per-word results  -->
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=ScrabbleWordResultsLabel}" />
                <ItemsControl ItemTemplate="{StaticResource ScrabbleWordTemplate}" ItemsSource="{x:Bind ViewModel.WordResults}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!--  Value reference panel  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=ScrabbleReferenceLabel}" />
                        <ItemsRepeater ItemTemplate="{StaticResource ScrabbleReferenceTemplate}" ItemsSource="{x:Bind ViewModel.ReferenceCells}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    MinColumnSpacing="8"
                                    MinItemWidth="48"
                                    MinRowSpacing="8" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:ScrabbleScorerViewBase>
