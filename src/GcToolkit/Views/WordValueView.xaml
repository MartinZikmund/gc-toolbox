<local:WordValueViewBase
    x:Class="GcToolkit.Views.WordValueView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup"
    xmlns:tools="using:GcToolkit.Core.ViewModels.Tools"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer x:Name="RootScroll" Padding="24">
        <StackPanel
            MaxWidth="760"
            HorizontalAlignment="Stretch"
            Spacing="16">
            <!--  Header: tool name + favorite toggle  -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock
                        Style="{ThemeResource TitleLargeTextBlockStyle}"
                        Text="{x:Bind ViewModel.ToolName, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.Tooltip, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <ToggleButton
                    Grid.Column="1"
                    Width="44"
                    Height="44"
                    Padding="0"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="{markup:Localize Key=AddToFavorites}"
                    Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                    IsChecked="{x:Bind ViewModel.IsFavorite, Mode=OneWay}"
                    ToolTipService.ToolTip="{markup:Localize Key=AddToFavorites}">
                    <FontIcon FontSize="18" Glyph="&#xE734;" />
                </ToggleButton>
            </Grid>

            <!--  Input  -->
            <TextBox
                MinHeight="96"
                AcceptsReturn="True"
                Header="{markup:Localize Key=WordValueInputLabel}"
                PlaceholderText="{markup:Localize Key=WordValueInputPlaceholder}"
                Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />

            <!--  Options  -->
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Button Command="{x:Bind ViewModel.ClearCommand}" Content="{markup:Localize Key=WordValueClear}" />
                <ToggleSwitch
                    VerticalAlignment="Center"
                    Header="{markup:Localize Key=WordValueCountNumbers}"
                    IsOn="{x:Bind ViewModel.CountNumbers, Mode=TwoWay}" />
            </StackPanel>

            <!--  Summary: total · cross sum · digital root  -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="0"
                        Spacing="2">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=WordValueTotalLabel}" />
                        <TextBlock
                            FontFamily="Consolas"
                            Style="{ThemeResource TitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.LetterTotal, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="1"
                        Spacing="2">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=WordValueCrossSumLabel}" />
                        <TextBlock
                            FontFamily="Consolas"
                            Style="{ThemeResource TitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.LetterCrossSum, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="2"
                        Spacing="2">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=WordValueDigitalRootLabel}" />
                        <TextBlock
                            FontFamily="Consolas"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Style="{ThemeResource TitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.LetterDigitalRoot, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Spacing="2">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=WordValueReductionLabel}" />
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="16"
                            Text="{x:Bind ViewModel.LetterReduction, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Per-word breakdown (beyond parity)  -->
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasOutput, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=WordValueBreakdownLabel}" />
                <Grid Padding="8,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{markup:Localize Key=WordValueWordHeader}" />
                    <TextBlock
                        Grid.Column="1"
                        MinWidth="64"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalTextAlignment="Right"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{markup:Localize Key=WordValueValueHeader}" />
                </Grid>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Words}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="tools:WordValueItem">
                            <Grid
                                Margin="0,2"
                                Padding="8,6"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                ColumnSpacing="12"
                                CornerRadius="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    Text="{x:Bind Word}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Grid.Column="1"
                                    MinWidth="64"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    HorizontalTextAlignment="Right"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Value}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!--  Numbers found in the input (when counting numbers)  -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{x:Bind ViewModel.HasNumbers, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=WordValueNumbersLabel}" />
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="15"
                        Text="{x:Bind ViewModel.NumbersSummary, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{markup:Localize Key=WordValueNumbersTotalLabel}" />
                            <TextBlock
                                FontFamily="Consolas"
                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.NumberTotal, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{markup:Localize Key=WordValueDigitalRootLabel}" />
                            <TextBlock
                                FontFamily="Consolas"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.NumberDigitalRoot, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock
                        FontFamily="Consolas"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.NumberReduction, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  Output actions  -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.CopyOutputCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                        <TextBlock Text="{markup:Localize Key=WordValueCopy}" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.ShareOutputCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE72D;" />
                        <TextBlock Text="{markup:Localize Key=WordValueShare}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!--  How it works  -->
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{markup:Localize Key=WordValueHelpNote}"
                TextWrapping="Wrap" />

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState>
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="RootScroll.Padding" Value="16" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState>
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="640" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="RootScroll.Padding" Value="24" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </StackPanel>
    </ScrollViewer>
</local:WordValueViewBase>
