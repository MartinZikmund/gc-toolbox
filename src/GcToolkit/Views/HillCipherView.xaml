<local:HillCipherViewBase
    x:Class="GcToolkit.Views.HillCipherView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup"
    xmlns:tools="using:GcToolkit.Core.ViewModels.Tools"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <local:HillCipherViewBase.Resources>
        <!--  One editable cell of the numeric key matrix  -->
        <DataTemplate x:Key="HillMatrixCellTemplate" x:DataType="tools:HillMatrixCell">
            <TextBox
                MinWidth="56"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                AutomationProperties.Name="{x:Bind AutomationName}"
                FontFamily="Consolas"
                FontSize="18"
                InputScope="Number"
                IsSpellCheckEnabled="False"
                Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </DataTemplate>
    </local:HillCipherViewBase.Resources>

    <Grid MaxWidth="1024" HorizontalAlignment="Center">
        <ScrollViewer Padding="24" HorizontalContentAlignment="Center">
            <StackPanel HorizontalAlignment="Stretch" Spacing="16">

                <!--  Header: tool name + favorite toggle  -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock
                            Style="{ThemeResource TitleLargeTextBlockStyle}"
                            Text="{x:Bind ViewModel.ToolName, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.Tooltip, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleButton
                        Grid.Column="1"
                        Width="44"
                        Height="44"
                        Padding="0"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{markup:Localize Key=AddToFavorites}"
                        Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                        IsChecked="{x:Bind ViewModel.IsFavorite, Mode=OneWay}"
                        ToolTipService.ToolTip="{markup:Localize Key=AddToFavorites}">
                        <FontIcon FontSize="18" Glyph="&#xE734;" />
                    </ToggleButton>
                </Grid>

                <!--  Direction + matrix size  -->
                <Grid ColumnSpacing="24" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=HillDirection}" />
                        <RadioButtons MaxColumns="2" SelectedIndex="{x:Bind ViewModel.DirectionIndex, Mode=TwoWay}">
                            <RadioButton Content="{markup:Localize Key=HillEncrypt}" />
                            <RadioButton Content="{markup:Localize Key=HillDecrypt}" />
                        </RadioButtons>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=HillMatrixSize}" />
                        <RadioButtons MaxColumns="2" SelectedIndex="{x:Bind ViewModel.SizeIndex, Mode=TwoWay}">
                            <RadioButton Content="{markup:Localize Key=HillSize2}" />
                            <RadioButton Content="{markup:Localize Key=HillSize3}" />
                        </RadioButtons>
                    </StackPanel>
                </Grid>

                <!--  Key type  -->
                <StackPanel Spacing="4">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=HillKeyMode}" />
                    <RadioButtons MaxColumns="2" SelectedIndex="{x:Bind ViewModel.KeyModeIndex, Mode=TwoWay}">
                        <RadioButton Content="{markup:Localize Key=HillKeyNumeric}" />
                        <RadioButton Content="{markup:Localize Key=HillKeyKeyword}" />
                    </RadioButtons>
                </StackPanel>

                <!--  Numeric matrix grid  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.IsNumericMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=HillMatrixLabel}" />
                        <ItemsRepeater
                            HorizontalAlignment="Left"
                            ItemTemplate="{StaticResource HillMatrixCellTemplate}"
                            ItemsSource="{x:Bind ViewModel.MatrixCells}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    MaximumRowsOrColumns="{x:Bind ViewModel.MatrixColumns, Mode=OneWay}"
                                    MinColumnSpacing="8"
                                    MinItemWidth="56"
                                    MinRowSpacing="8"
                                    Orientation="Horizontal" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <!--  Keyword key  -->
                <TextBox
                    Header="{markup:Localize Key=HillKeywordLabel}"
                    PlaceholderText="{markup:Localize Key=HillKeywordPlaceholder}"
                    Text="{x:Bind ViewModel.KeywordText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Visibility="{x:Bind ViewModel.IsKeywordMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!--  Pad character  -->
                <TextBox
                    MaxWidth="160"
                    HorizontalAlignment="Left"
                    Header="{markup:Localize Key=HillPadLabel}"
                    MaxLength="1"
                    Text="{x:Bind ViewModel.PadCharacter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!--  Input  -->
                <TextBox
                    MinHeight="80"
                    AcceptsReturn="True"
                    Header="{markup:Localize Key=HillInputLabel}"
                    PlaceholderText="{markup:Localize Key=HillInputPlaceholder}"
                    Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />

                <!--  Direction swap  -->
                <Button HorizontalAlignment="Left" Command="{x:Bind ViewModel.SwapCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8AB;" />
                        <TextBlock Text="{markup:Localize Key=HillSwap}" />
                    </StackPanel>
                </Button>

                <!--  Result  -->
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=HillOutputLabel}" />
                <TextBox
                    FontFamily="Consolas"
                    FontSize="20"
                    IsReadOnly="True"
                    IsSpellCheckEnabled="False"
                    Text="{x:Bind ViewModel.OutputText, Mode=OneWay}"
                    TextWrapping="Wrap" />

                <!--  Validation / invertibility notice  -->
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasWarning, Mode=OneWay}"
                    Message="{x:Bind ViewModel.WarningMessage, Mode=OneWay}"
                    Severity="Warning" />

                <!--  Output actions  -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.CopyOutputCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                            <TextBlock Text="{markup:Localize Key=HillCopy}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ShareOutputCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE72D;" />
                            <TextBlock Text="{markup:Localize Key=HillShare}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ClearCommand}" Content="{markup:Localize Key=HillClear}" />
                </StackPanel>

                <!--  Key matrix + inverse display  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=HillMatrixLabel}" />
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="16"
                            Text="{x:Bind ViewModel.KeyMatrixDisplay, Mode=OneWay}" />

                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.DeterminantText, Mode=OneWay}" />

                        <TextBlock
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="{markup:Localize Key=HillInverseLabel}"
                            Visibility="{x:Bind ViewModel.HasInverse, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock
                            FontFamily="Consolas"
                            FontSize="16"
                            Text="{x:Bind ViewModel.InverseMatrixDisplay, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasInverse, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </Border>

                <!--  How-it-works hint  -->
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{markup:Localize Key=HillHint}"
                    TextWrapping="Wrap" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:HillCipherViewBase>
