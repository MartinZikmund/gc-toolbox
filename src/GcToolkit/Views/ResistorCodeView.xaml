<local:ResistorCodeViewBase
    x:Class="GcToolkit.Views.ResistorCodeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GcToolkit.Controls"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup"
    xmlns:tools="using:GcToolkit.Core.ViewModels.Tools">

    <controls:ToolPage Tool="{x:Bind ViewModel}">
        <StackPanel Spacing="16">


            <!--  Mode: decode (colours -> value) / encode (value -> colours)  -->
            <RadioButtons
                Header="{markup:Localize Key=ResistorMode}"
                MaxColumns="2"
                SelectedIndex="{x:Bind ViewModel.ModeIndex, Mode=TwoWay}">
                <RadioButton Content="{markup:Localize Key=ResistorModeDecode}" />
                <RadioButton Content="{markup:Localize Key=ResistorModeEncode}" />
            </RadioButtons>

            <!--  Band count  -->
            <RadioButtons
                Header="{markup:Localize Key=ResistorBands}"
                MaxColumns="3"
                SelectedIndex="{x:Bind ViewModel.BandCountIndex, Mode=TwoWay}">
                <RadioButton Content="{markup:Localize Key=ResistorBands4}" />
                <RadioButton Content="{markup:Localize Key=ResistorBands5}" />
                <RadioButton Content="{markup:Localize Key=ResistorBands6}" />
            </RadioButtons>

            <!--  Decode: one colour selector per band  -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsDecodeMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Bands}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="tools:ResistorBandSlot">
                            <ComboBox
                                MinWidth="220"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="{x:Bind RoleLabel}"
                                Header="{x:Bind RoleLabel}"
                                ItemsSource="{x:Bind Options}"
                                SelectedItem="{x:Bind SelectedOption, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="tools:ResistorColorOption">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Border
                                                Width="20"
                                                Height="20"
                                                Background="{x:Bind local:ResistorCodeView.Brush(SwatchHex)}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4" />
                                            <TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!--  Encode: resistance value + tolerance (+ temp. coefficient for 6-band)  -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsEncodeMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBox
                    Header="{markup:Localize Key=ResistorValueLabel}"
                    InputScope="Number"
                    PlaceholderText="{markup:Localize Key=ResistorValuePlaceholder}"
                    Text="{x:Bind ViewModel.ResistanceInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <ComboBox
                    MinWidth="220"
                    HorizontalAlignment="Stretch"
                    Header="{markup:Localize Key=ResistorBandTolerance}"
                    ItemsSource="{x:Bind ViewModel.ToleranceOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedTolerance, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="tools:ResistorColorOption">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border
                                    Width="20"
                                    Height="20"
                                    Background="{x:Bind local:ResistorCodeView.Brush(SwatchHex)}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <ComboBox
                    MinWidth="220"
                    HorizontalAlignment="Stretch"
                    Header="{markup:Localize Key=ResistorBandTempCo}"
                    ItemsSource="{x:Bind ViewModel.TempCoOptions}"
                    SelectedItem="{x:Bind ViewModel.SelectedTempCo, Mode=TwoWay}"
                    Visibility="{x:Bind ViewModel.IsSixBand, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="tools:ResistorColorOption">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border
                                    Width="20"
                                    Height="20"
                                    Background="{x:Bind local:ResistorCodeView.Brush(SwatchHex)}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4" />
                                <TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!--  Visual band preview (the selected/encoded colour bands on a resistor body)  -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{x:Bind ViewModel.HasOutput, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid
                    Height="64"
                    Background="#E8C9A0"
                    CornerRadius="8">
                    <ItemsControl HorizontalAlignment="Center" ItemsSource="{x:Bind ViewModel.ResultBands}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="tools:ResistorColorOption">
                                <Border
                                    Width="14"
                                    Height="64"
                                    AutomationProperties.Name="{x:Bind Name}"
                                    Background="{x:Bind local:ResistorCodeView.Brush(SwatchHex)}"
                                    ToolTipService.ToolTip="{x:Bind Name}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!--  Error  -->
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" />

            <!--  The entered value has no exact band representation — show the closest one  -->
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsApproximate, Mode=OneWay}"
                Message="{x:Bind ViewModel.ApproximateMessage, Mode=OneWay}"
                Severity="Warning" />

            <!--  Result card: resistance, tolerance, temp. coefficient, digits  -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{x:Bind ViewModel.HasOutput, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=ResistorResistanceLabel}" />
                        <TextBlock
                            FontFamily="{ThemeResource AppMonoFontFamily}"
                            Style="{ThemeResource TitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.ResistanceText, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=ResistorBandTolerance}" />
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.ToleranceText, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel Spacing="2" Visibility="{x:Bind ViewModel.HasTempCo, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=ResistorBandTempCo}" />
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.TempCoText, Mode=OneWay}" />
                    </StackPanel>

                    <!--  The raw digit string cache puzzles usually want (brown-black-red -> 102)  -->
                    <StackPanel Spacing="2">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=ResistorDigitsLabel}" />
                        <TextBlock
                            FontFamily="{ThemeResource AppMonoFontFamily}"
                            IsTextSelectionEnabled="True"
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind ViewModel.DigitsText, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  Actions  -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.CopyOutputCommand}" Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                        <TextBlock Text="{markup:Localize Key=ResistorCopy}" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.ShareOutputCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE72D;" />
                        <TextBlock Text="{markup:Localize Key=ResistorShare}" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.ClearCommand}" Content="{markup:Localize Key=ResistorClear}" />
            </StackPanel>

        </StackPanel>
    </controls:ToolPage>
</local:ResistorCodeViewBase>
