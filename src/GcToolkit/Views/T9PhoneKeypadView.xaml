<local:T9PhoneKeypadViewBase
    x:Class="GcToolkit.Views.T9PhoneKeypadView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:alphabets="using:GcToolkit.Core.Alphabets"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup"
    xmlns:tools="using:GcToolkit.Core.ViewModels.Tools"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <local:T9PhoneKeypadViewBase.Resources>
        <Style x:Key="T9KeyButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </local:T9PhoneKeypadViewBase.Resources>

    <Grid MaxWidth="1024" HorizontalAlignment="Center">
        <ScrollViewer Padding="24" HorizontalContentAlignment="Center">
            <StackPanel HorizontalAlignment="Stretch" Spacing="16">

                <!--  Header: tool name + favorite toggle  -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock
                            Style="{ThemeResource TitleLargeTextBlockStyle}"
                            Text="{x:Bind ViewModel.ToolName, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.Tooltip, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleButton
                        Grid.Column="1"
                        Width="44"
                        Height="44"
                        Padding="0"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{markup:Localize Key=AddToFavorites}"
                        Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                        IsChecked="{x:Bind ViewModel.IsFavorite, Mode=OneWay}"
                        ToolTipService.ToolTip="{markup:Localize Key=AddToFavorites}">
                        <FontIcon FontSize="18" Glyph="&#xE734;" />
                    </ToggleButton>
                </Grid>

                <!--  Mode  -->
                <StackPanel Spacing="4">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=T9ModeLabel}" />
                    <RadioButtons MaxColumns="3" SelectedIndex="{x:Bind ViewModel.ModeIndex, Mode=TwoWay}">
                        <RadioButton Content="{markup:Localize Key=T9ModeT9}" />
                        <RadioButton Content="{markup:Localize Key=T9ModeMultitap}" />
                        <RadioButton Content="{markup:Localize Key=T9ModeKeyPosition}" />
                    </RadioButtons>
                </StackPanel>

                <!--  Direction  -->
                <RadioButtons MaxColumns="2" SelectedIndex="{x:Bind ViewModel.DirectionIndex, Mode=TwoWay}">
                    <RadioButton Content="{markup:Localize Key=T9TextToDigits}" />
                    <RadioButton Content="{markup:Localize Key=T9DigitsToText}" />
                </RadioButtons>

                <!--  Input  -->
                <TextBox
                    Header="{markup:Localize Key=T9InputLabel}"
                    PlaceholderText="{x:Bind ViewModel.InputPlaceholder, Mode=OneWay}"
                    Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />

                <Button
                    HorizontalAlignment="Left"
                    Command="{x:Bind ViewModel.ClearCommand}"
                    Content="{markup:Localize Key=T9Clear}" />

                <!--  On-screen keypad  -->
                <StackPanel Spacing="8">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=T9KeypadLabel}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Keypad}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                ItemsStretch="Fill"
                                MaximumRowsOrColumns="3"
                                MinColumnSpacing="8"
                                MinItemWidth="96"
                                MinRowSpacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="alphabets:PhoneKey">
                                <Button
                                    AutomationProperties.Name="{x:Bind Letters}"
                                    Click="OnKeyClick"
                                    Style="{StaticResource T9KeyButtonStyle}"
                                    Tag="{x:Bind}">
                                    <StackPanel HorizontalAlignment="Center" Spacing="2">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontFamily="Consolas"
                                            Style="{ThemeResource SubtitleTextBlockStyle}"
                                            Text="{x:Bind Digit}" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Letters}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!--  Result  -->
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=T9OutputLabel}" />
                <TextBox
                    AutomationProperties.Name="{markup:Localize Key=T9OutputLabel}"
                    FontFamily="Consolas"
                    FontSize="20"
                    IsReadOnly="True"
                    IsSpellCheckEnabled="False"
                    Text="{x:Bind ViewModel.OutputText, Mode=OneWay}"
                    TextWrapping="Wrap" />

                <!--  Validation / truncation notice  -->
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasWarning, Mode=OneWay}"
                    Message="{x:Bind ViewModel.WarningMessage, Mode=OneWay}"
                    Severity="Warning" />

                <!--  Output actions  -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.CopyOutputCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                            <TextBlock Text="{markup:Localize Key=T9Copy}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ShareOutputCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE72D;" />
                            <TextBlock Text="{markup:Localize Key=T9Share}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--  Predictive candidates (T9 decode only)  -->
                <Expander
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Header="{markup:Localize Key=T9CandidatesLabel}"
                    IsExpanded="True"
                    Visibility="{x:Bind ViewModel.ShowCandidates, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Candidates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="tools:T9WordCandidates">
                                <StackPanel Margin="0,4" Spacing="6">
                                    <TextBlock
                                        FontFamily="Consolas"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Digits}" />
                                    <ItemsRepeater ItemsSource="{x:Bind Combinations}">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout
                                                ItemsStretch="None"
                                                MinColumnSpacing="6"
                                                MinItemWidth="84"
                                                MinRowSpacing="6" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border
                                                    Padding="8,4"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    CornerRadius="6">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        FontFamily="Consolas"
                                                        Text="{x:Bind}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:T9PhoneKeypadViewBase>
