<local:QwertyShifterViewBase
    x:Class="GcToolkit.Views.QwertyShifterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup"
    xmlns:tools="using:GcToolkit.Core.ViewModels.Tools"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <local:QwertyShifterViewBase.Resources>
        <!--  One key: plain letter over its shifted substitute  -->
        <DataTemplate x:Key="QwertyKeyTemplate" x:DataType="tools:QwertyKeyboardKey">
            <Border
                MinWidth="34"
                Margin="2"
                Padding="6,4"
                AutomationProperties.Name="{x:Bind Plain}"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                ToolTipService.ToolTip="{x:Bind Shifted}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="Consolas"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind Plain}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="Consolas"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Shifted}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--  One keyboard row  -->
        <DataTemplate x:Key="QwertyRowTemplate">
            <ItemsControl ItemTemplate="{StaticResource QwertyKeyTemplate}" ItemsSource="{Binding}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>

        <!--  One brute-force candidate row  -->
        <DataTemplate x:Key="QwertyBruteForceTemplate" x:DataType="tools:QwertyBruteForceRow">
            <Grid Margin="0,2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    MinWidth="36"
                    Padding="6,2"
                    VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="6">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="Consolas"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind Shift}" />
                </Border>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontFamily="Consolas"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind Text}"
                    TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </local:QwertyShifterViewBase.Resources>

    <Grid MaxWidth="1024" HorizontalAlignment="Center">
        <ScrollViewer Padding="24" HorizontalContentAlignment="Center">
            <StackPanel HorizontalAlignment="Stretch" Spacing="16">

                <!--  Header: tool name + favorite toggle  -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock
                            Style="{ThemeResource TitleLargeTextBlockStyle}"
                            Text="{x:Bind ViewModel.ToolName, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.Tooltip, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleButton
                        Grid.Column="1"
                        Width="44"
                        Height="44"
                        Padding="0"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{markup:Localize Key=AddToFavorites}"
                        Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                        IsChecked="{x:Bind ViewModel.IsFavorite, Mode=OneWay}"
                        ToolTipService.ToolTip="{markup:Localize Key=AddToFavorites}">
                        <FontIcon FontSize="18" Glyph="&#xE734;" />
                    </ToggleButton>
                </Grid>

                <!--  Input  -->
                <TextBox
                    AcceptsReturn="True"
                    Header="{markup:Localize Key=QwertyInputLabel}"
                    PlaceholderText="{markup:Localize Key=QwertyInputPlaceholder}"
                    Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />

                <!--  Direction  -->
                <StackPanel Spacing="4">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=QwertyDirectionLabel}" />
                    <RadioButtons MaxColumns="2" SelectedIndex="{x:Bind ViewModel.DirectionIndex, Mode=TwoWay}">
                        <RadioButton Content="{markup:Localize Key=QwertyDirectionRight}" />
                        <RadioButton Content="{markup:Localize Key=QwertyDirectionLeft}" />
                    </RadioButtons>
                </StackPanel>

                <!--  Shift amount: slider + numeric entry  -->
                <StackPanel Spacing="4">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=QwertyShiftLabel}" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{markup:Localize Key=QwertyShiftLabel}"
                            Maximum="{x:Bind ViewModel.MaxShift, Mode=OneWay}"
                            Minimum="0"
                            Value="{x:Bind ViewModel.Shift, Mode=TwoWay}" />
                        <NumberBox
                            Grid.Column="1"
                            MinWidth="120"
                            AutomationProperties.Name="{markup:Localize Key=QwertyShiftLabel}"
                            Maximum="{x:Bind ViewModel.MaxShift, Mode=OneWay}"
                            Minimum="0"
                            SpinButtonPlacementMode="Inline"
                            Value="{x:Bind ViewModel.Shift, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>

                <!--  Alphabet / layout / model selectors  -->
                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ComboBox
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Header="{markup:Localize Key=QwertyAlphabetLabel}"
                        SelectedIndex="{x:Bind ViewModel.AlphabetIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="{markup:Localize Key=QwertyAlphabetLettersDigits}" />
                        <ComboBoxItem Content="{markup:Localize Key=QwertyAlphabetExtended}" />
                    </ComboBox>

                    <ComboBox
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Header="{markup:Localize Key=QwertyLayoutLabel}"
                        SelectedIndex="{x:Bind ViewModel.LayoutIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="QWERTY" />
                        <ComboBoxItem Content="QWERTZ" />
                        <ComboBoxItem Content="AZERTY" />
                    </ComboBox>

                    <ComboBox
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        Header="{markup:Localize Key=QwertyModelLabel}"
                        SelectedIndex="{x:Bind ViewModel.ModelIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="{markup:Localize Key=QwertyModelLinear}" />
                        <ComboBoxItem Content="{markup:Localize Key=QwertyModelRowBounded}" />
                    </ComboBox>
                </Grid>

                <!--  Toggles + clear  -->
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <ToggleSwitch Header="{markup:Localize Key=QwertyFoldToUpper}" IsOn="{x:Bind ViewModel.FoldToUpper, Mode=TwoWay}" />
                    <ToggleSwitch Header="{markup:Localize Key=QwertyBatchMode}" IsOn="{x:Bind ViewModel.BatchMode, Mode=TwoWay}" />
                    <Button
                        VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.ClearCommand}"
                        Content="{markup:Localize Key=QwertyClear}" />
                </StackPanel>

                <!--  Result  -->
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=QwertyOutputLabel}" />
                <TextBox
                    AcceptsReturn="True"
                    FontFamily="Consolas"
                    FontSize="20"
                    IsReadOnly="True"
                    IsSpellCheckEnabled="False"
                    Text="{x:Bind ViewModel.OutputText, Mode=OneWay}"
                    TextWrapping="Wrap" />

                <!--  Output actions  -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.CopyOutputCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                            <TextBlock Text="{markup:Localize Key=QwertyCopy}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ShareOutputCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE72D;" />
                            <TextBlock Text="{markup:Localize Key=QwertyShare}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--  On-screen keyboard (plain over shifted)  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=QwertyKeyboardLabel}" />
                        <ItemsControl ItemTemplate="{StaticResource QwertyRowTemplate}" ItemsSource="{x:Bind ViewModel.KeyboardRows}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=QwertyKeyboardNote}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  Brute force: every shift of the first line  -->
                <Expander
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Header="{markup:Localize Key=QwertyBruteForceLabel}">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=QwertyBruteForceNote}"
                            TextWrapping="Wrap" />
                        <ItemsControl ItemTemplate="{StaticResource QwertyBruteForceTemplate}" ItemsSource="{x:Bind ViewModel.BruteForceResults}" />
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:QwertyShifterViewBase>
