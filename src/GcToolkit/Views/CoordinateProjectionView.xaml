<local:CoordinateProjectionViewBase
    x:Class="GcToolkit.Views.CoordinateProjectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GcToolkit.Controls"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup">

    <controls:ToolPage Tool="{x:Bind ViewModel}">
        <StackPanel Spacing="16">


            <!--  Start coordinate (free text, any notation)  -->
            <TextBox
                Header="{markup:Localize Key=CoordinateProjectionStartLabel}"
                PlaceholderText="{markup:Localize Key=CoordinateProjectionStartPlaceholder}"
                Text="{x:Bind ViewModel.StartCoordinate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <!--  Angle + distance + unit  -->
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    Grid.Column="0"
                    Header="{markup:Localize Key=CoordinateProjectionAngleLabel}"
                    InputScope="Number"
                    PlaceholderText="{markup:Localize Key=CoordinateProjectionAnglePlaceholder}"
                    Text="{x:Bind ViewModel.AngleDegrees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBox
                    Grid.Column="1"
                    Header="{markup:Localize Key=CoordinateProjectionDistanceLabel}"
                    InputScope="Number"
                    PlaceholderText="{markup:Localize Key=CoordinateProjectionDistancePlaceholder}"
                    Text="{x:Bind ViewModel.Distance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <ComboBox
                    Grid.Column="2"
                    MinWidth="140"
                    VerticalAlignment="Bottom"
                    AutomationProperties.Name="{markup:Localize Key=CoordinateProjectionUnitLabel}"
                    Header="{markup:Localize Key=CoordinateProjectionUnitLabel}"
                    SelectedIndex="{x:Bind ViewModel.DistanceUnitIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{markup:Localize Key=CoordinateProjectionUnitMeter}" />
                    <ComboBoxItem Content="{markup:Localize Key=CoordinateProjectionUnitKilometer}" />
                    <ComboBoxItem Content="{markup:Localize Key=CoordinateProjectionUnitFeet}" />
                    <ComboBoxItem Content="{markup:Localize Key=CoordinateProjectionUnitYard}" />
                    <ComboBoxItem Content="{markup:Localize Key=CoordinateProjectionUnitMile}" />
                </ComboBox>
            </Grid>

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{markup:Localize Key=CoordinateProjectionAngleHint}"
                TextWrapping="Wrap" />

            <!--  Parse / projection error  -->
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" />

            <!--  Result: the projected coordinate in all three angular formats  -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=CoordinateProjectionResultLabel}" />

                    <!--  DDM (geocaching default)  -->
                    <StackPanel Spacing="2">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=CoordinateProjectionFormatDdm}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{markup:Localize Key=CoordinateProjectionFormatDdm}"
                                FontFamily="{ThemeResource AppMonoFontFamily}"
                                FontSize="16"
                                IsReadOnly="True"
                                IsSpellCheckEnabled="False"
                                Text="{x:Bind ViewModel.DegreesDecimalMinutes, Mode=OneWay}" />
                            <Button
                                Grid.Column="1"
                                Width="36"
                                Height="36"
                                Padding="0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{markup:Localize Key=CoordinateProjectionCopy}"
                                Command="{x:Bind ViewModel.CopyTextCommand}"
                                CommandParameter="{x:Bind ViewModel.DegreesDecimalMinutes, Mode=OneWay}"
                                ToolTipService.ToolTip="{markup:Localize Key=CoordinateProjectionCopy}">
                                <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!--  DD  -->
                    <StackPanel Spacing="2">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=CoordinateProjectionFormatDd}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{markup:Localize Key=CoordinateProjectionFormatDd}"
                                FontFamily="{ThemeResource AppMonoFontFamily}"
                                FontSize="16"
                                IsReadOnly="True"
                                IsSpellCheckEnabled="False"
                                Text="{x:Bind ViewModel.DecimalDegrees, Mode=OneWay}" />
                            <Button
                                Grid.Column="1"
                                Width="36"
                                Height="36"
                                Padding="0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{markup:Localize Key=CoordinateProjectionCopy}"
                                Command="{x:Bind ViewModel.CopyTextCommand}"
                                CommandParameter="{x:Bind ViewModel.DecimalDegrees, Mode=OneWay}"
                                ToolTipService.ToolTip="{markup:Localize Key=CoordinateProjectionCopy}">
                                <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!--  DMS  -->
                    <StackPanel Spacing="2">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=CoordinateProjectionFormatDms}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{markup:Localize Key=CoordinateProjectionFormatDms}"
                                FontFamily="{ThemeResource AppMonoFontFamily}"
                                FontSize="16"
                                IsReadOnly="True"
                                IsSpellCheckEnabled="False"
                                Text="{x:Bind ViewModel.DegreesMinutesSeconds, Mode=OneWay}" />
                            <Button
                                Grid.Column="1"
                                Width="36"
                                Height="36"
                                Padding="0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{markup:Localize Key=CoordinateProjectionCopy}"
                                Command="{x:Bind ViewModel.CopyTextCommand}"
                                CommandParameter="{x:Bind ViewModel.DegreesMinutesSeconds, Mode=OneWay}"
                                ToolTipService.ToolTip="{markup:Localize Key=CoordinateProjectionCopy}">
                                <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  Actions  -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.CopyOutputCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                        <TextBlock Text="{markup:Localize Key=CoordinateProjectionCopy}" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.ShareOutputCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE72D;" />
                        <TextBlock Text="{markup:Localize Key=CoordinateProjectionShare}" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.ClearCommand}" Content="{markup:Localize Key=CoordinateProjectionClear}" />
            </StackPanel>

        </StackPanel>
    </controls:ToolPage>
</local:CoordinateProjectionViewBase>
