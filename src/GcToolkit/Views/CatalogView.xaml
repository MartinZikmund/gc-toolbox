                        IsHitTestVisible="False"
                        Opacity="0.35"
                        Stretch="Uniform"
                        Stroke="{ThemeResource BrandPrimaryBrush}"
                        StrokeLineJoin="Round"
                        StrokeThickness="1.5" />
                    <StackPanel Spacing="8">
                        <TextBlock
                            HorizontalAlignment="Center"
                            HorizontalTextAlignment="Center"
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            Text="{x:Bind StateHeadline(ViewModel.IsEmpty), Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            HorizontalTextAlignment="Center"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind StateHint(ViewModel.IsEmpty), Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</local:CatalogViewBase>
