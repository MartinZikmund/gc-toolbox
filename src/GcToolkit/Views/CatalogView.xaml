<local:CatalogViewBase
    x:Class="GcToolkit.Views.CatalogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GcToolkit.Views"
    xmlns:vm="using:GcToolkit.Core.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    NavigationCacheMode="Required">

    <ScrollViewer x:Name="CatalogScroller" Padding="24">
        <!--  Grid wrapper: a MaxWidth panel directly inside a ScrollViewer renders off-centre and jumps while typing (WinUI #4619).  -->
        <Grid>
            <StackPanel
                MaxWidth="960"
                HorizontalAlignment="Stretch"
                Spacing="24">

                <!--  The hub header: what this page is, and how much of it is currently listed.  -->
                <StackPanel Spacing="4">
                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" />
                    <!--
                        Filled from code-behind: the counts are derived from Groups, which is refilled
                        in place on every keystroke and so notifies no binding. Tabular figures keep the
                        digits from jittering as they recount.
                    -->
                    <TextBlock
                        x:Name="ScaleReadout"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Typography.NumeralAlignment="Tabular" />
                </StackPanel>

                <!--  Categorized, search-filtered tool grid  -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CatalogGroup">
                            <StackPanel Margin="0,0,0,32" Spacing="12">
                                <!--  Category header: count tile, name, hairline. The cards below are the loud part.  -->
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Name declared first so a screen reader hears "Ciphers, 12"; Grid.Column keeps the tile on the left.  -->
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Name}" />

                                    <Border
                                        Grid.Column="0"
                                        Height="28"
                                        MinWidth="28"
                                        Padding="8,0"
                                        Background="{ThemeResource BrandPrimarySoftBrush}"
                                        CornerRadius="8">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource BrandOnPrimarySoftBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Tools.Count}"
                                            Typography.NumeralAlignment="Tabular" />
                                    </Border>

                                    <Rectangle
                                        Grid.Column="2"
                                        Height="1"
                                        VerticalAlignment="Center"
                                        Fill="{ThemeResource AppStrokeBrush}" />
                                </Grid>

                                <ItemsRepeater ItemTemplate="{StaticResource ToolCardTemplate}" ItemsSource="{x:Bind Tools}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout
                                            ItemsStretch="Fill"
                                            MinColumnSpacing="8"
                                            MinItemWidth="240"
                                            MinRowSpacing="8" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  Empty catalog and "nothing matched" share one block: HasNoResults is never true while IsEmpty is.  -->
                <StackPanel
                    MaxWidth="420"
                    Margin="0,24,0,48"
                    HorizontalAlignment="Center"
                    Spacing="16"
                    Visibility="{x:Bind StateVisibility(ViewModel.IsEmpty, ViewModel.HasNoResults), Mode=OneWay}">
