<local:AntipodesViewBase
    x:Class="GcToolkit.Views.AntipodesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <local:AntipodesViewBase.Resources>
        <Style x:Key="AntipodeResultCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </local:AntipodesViewBase.Resources>

    <Grid MaxWidth="1024" HorizontalAlignment="Center">
        <ScrollViewer Padding="24" HorizontalContentAlignment="Center">
            <StackPanel HorizontalAlignment="Stretch" Spacing="16">

                <!--  Header: tool name + favorite toggle  -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock
                            Style="{ThemeResource TitleLargeTextBlockStyle}"
                            Text="{x:Bind ViewModel.ToolName, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.Tooltip, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleButton
                        Grid.Column="1"
                        Width="44"
                        Height="44"
                        Padding="0"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{markup:Localize Key=AddToFavorites}"
                        Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                        IsChecked="{x:Bind ViewModel.IsFavorite, Mode=OneWay}"
                        ToolTipService.ToolTip="{markup:Localize Key=AddToFavorites}">
                        <FontIcon FontSize="18" Glyph="&#xE734;" />
                    </ToggleButton>
                </Grid>

                <!--  Input  -->
                <TextBox
                    FontFamily="Consolas"
                    Header="{markup:Localize Key=Antipodes_InputLabel}"
                    PlaceholderText="{markup:Localize Key=Antipodes_InputPlaceholder}"
                    Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />

                <Button
                    HorizontalAlignment="Left"
                    Command="{x:Bind ViewModel.ClearCommand}"
                    Content="{markup:Localize Key=Antipodes_Clear}" />

                <!--  Validation / error notice  -->
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error" />

                <!--  Results (visible once a coordinate parses)  -->
                <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=Antipodes_ResultLabel}" />

                    <!--  DDM  -->
                    <Border Style="{StaticResource AntipodeResultCardStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{markup:Localize Key=Antipodes_FormatDdm}" />
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="20"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind ViewModel.OutputDdm, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Width="40"
                                Height="40"
                                Padding="0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{markup:Localize Key=Antipodes_Copy}"
                                Command="{x:Bind ViewModel.CopyDdmCommand}"
                                ToolTipService.ToolTip="{markup:Localize Key=Antipodes_Copy}">
                                <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                            </Button>
                        </Grid>
                    </Border>

                    <!--  DD  -->
                    <Border Style="{StaticResource AntipodeResultCardStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{markup:Localize Key=Antipodes_FormatDd}" />
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="20"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind ViewModel.OutputDd, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Width="40"
                                Height="40"
                                Padding="0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{markup:Localize Key=Antipodes_Copy}"
                                Command="{x:Bind ViewModel.CopyDdCommand}"
                                ToolTipService.ToolTip="{markup:Localize Key=Antipodes_Copy}">
                                <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                            </Button>
                        </Grid>
                    </Border>

                    <!--  DMS  -->
                    <Border Style="{StaticResource AntipodeResultCardStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{markup:Localize Key=Antipodes_FormatDms}" />
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="20"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind ViewModel.OutputDms, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Width="40"
                                Height="40"
                                Padding="0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{markup:Localize Key=Antipodes_Copy}"
                                Command="{x:Bind ViewModel.CopyDmsCommand}"
                                ToolTipService.ToolTip="{markup:Localize Key=Antipodes_Copy}">
                                <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                            </Button>
                        </Grid>
                    </Border>

                    <!--  Derived facts: distance + ocean note  -->
                    <Border Style="{StaticResource AntipodeResultCardStyle}">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE909;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind ViewModel.DistanceText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{markup:Localize Key=Antipodes_OceanNote}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!--  Share  -->
                    <Button HorizontalAlignment="Left" Command="{x:Bind ViewModel.ShareCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE72D;" />
                            <TextBlock Text="{markup:Localize Key=Antipodes_Share}" />
                        </StackPanel>
                    </Button>

                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:AntipodesViewBase>
