<local:KeyboardCipherViewBase
    x:Class="GcToolkit.Views.KeyboardCipherView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup"
    xmlns:tools="using:GcToolkit.Core.ViewModels.Tools"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid MaxWidth="1024" HorizontalAlignment="Center">
        <ScrollViewer Padding="24" HorizontalContentAlignment="Center">
            <StackPanel HorizontalAlignment="Stretch" Spacing="16">

                <!--  Header: tool name + favorite toggle  -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock
                            Style="{ThemeResource TitleLargeTextBlockStyle}"
                            Text="{x:Bind ViewModel.ToolName, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.Tooltip, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleButton
                        Grid.Column="1"
                        Width="44"
                        Height="44"
                        Padding="0"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{markup:Localize Key=AddToFavorites}"
                        Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                        IsChecked="{x:Bind ViewModel.IsFavorite, Mode=OneWay}"
                        ToolTipService.ToolTip="{markup:Localize Key=AddToFavorites}">
                        <FontIcon FontSize="18" Glyph="&#xE734;" />
                    </ToggleButton>
                </Grid>

                <!--  Direction + layout selector  -->
                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=KeyboardDirectionLabel}" />
                        <RadioButtons MaxColumns="2" SelectedIndex="{x:Bind ViewModel.DirectionIndex, Mode=TwoWay}">
                            <RadioButton Content="{markup:Localize Key=KeyboardEncrypt}" />
                            <RadioButton Content="{markup:Localize Key=KeyboardDecrypt}" />
                        </RadioButtons>
                    </StackPanel>

                    <ComboBox
                        Grid.Column="1"
                        MinWidth="180"
                        VerticalAlignment="Bottom"
                        Header="{markup:Localize Key=KeyboardLayoutLabel}"
                        SelectedIndex="{x:Bind ViewModel.LayoutIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="QWERTY" />
                        <ComboBoxItem Content="AZERTY" />
                        <ComboBoxItem Content="QWERTZ" />
                        <ComboBoxItem Content="Dvorak" />
                        <ComboBoxItem Content="Colemak" />
                        <ComboBoxItem Content="{markup:Localize Key=KeyboardCustomLayout}" />
                    </ComboBox>
                </Grid>

                <!--  Custom layout field (shown only for the custom layout)  -->
                <TextBox
                    FontFamily="Consolas"
                    Header="{markup:Localize Key=KeyboardCustomLayoutLabel}"
                    MaxLength="26"
                    PlaceholderText="{markup:Localize Key=KeyboardCustomLayoutPlaceholder}"
                    Text="{x:Bind ViewModel.CustomLayout, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Visibility="{x:Bind ViewModel.IsCustomLayout, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!--  Input (multi-line / batch)  -->
                <TextBox
                    MinHeight="96"
                    AcceptsReturn="True"
                    Header="{markup:Localize Key=KeyboardInputLabel}"
                    PlaceholderText="{markup:Localize Key=KeyboardInputPlaceholder}"
                    Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.SwapCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8AB;" />
                            <TextBlock Text="{markup:Localize Key=KeyboardSwap}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ClearCommand}" Content="{markup:Localize Key=KeyboardClear}" />
                </StackPanel>

                <!--  Validation notice (e.g. invalid custom layout)  -->
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasWarning, Mode=OneWay}"
                    Message="{x:Bind ViewModel.WarningMessage, Mode=OneWay}"
                    Severity="Warning" />

                <!--  Result  -->
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=KeyboardOutputLabel}" />
                <TextBox
                    MinHeight="96"
                    AcceptsReturn="True"
                    AutomationProperties.Name="{markup:Localize Key=KeyboardOutputLabel}"
                    FontFamily="Consolas"
                    FontSize="18"
                    IsReadOnly="True"
                    IsSpellCheckEnabled="False"
                    Text="{x:Bind ViewModel.OutputText, Mode=OneWay}"
                    TextWrapping="Wrap" />

                <!--  Output actions  -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.CopyOutputCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                            <TextBlock Text="{markup:Localize Key=KeyboardCopy}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ShareOutputCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE72D;" />
                            <TextBlock Text="{markup:Localize Key=KeyboardShare}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--  A-Z <-> layout mapping reference table  -->
                <Expander
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    IsExpanded="True">
                    <Expander.Header>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=KeyboardMappingTitle}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{markup:Localize Key=KeyboardMappingHint}" />
                        </StackPanel>
                    </Expander.Header>
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Mapping}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                ItemsStretch="None"
                                MinColumnSpacing="8"
                                MinItemWidth="64"
                                MinRowSpacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="tools:KeyboardMappingRow">
                                <Border
                                    Padding="8,6"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="6">
                                    <StackPanel HorizontalAlignment="Center" Spacing="2">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontFamily="Consolas"
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Letter}" />
                                        <FontIcon
                                            FontSize="10"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE74B;" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontFamily="Consolas"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Mapped}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Expander>

                <!--  How it works  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=KeyboardAboutTitle}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{markup:Localize Key=KeyboardAboutBody}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:KeyboardCipherViewBase>
