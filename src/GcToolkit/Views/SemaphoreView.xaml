<local:SemaphoreViewBase
    x:Class="GcToolkit.Views.SemaphoreView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GcToolkit.Controls"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup"
    xmlns:vm="using:GcToolkit.Core.ViewModels.Tools"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer x:Name="ContentScroller" Padding="24">
        <Grid>
            <StackPanel
                MaxWidth="760"
                HorizontalAlignment="Stretch"
                Spacing="16">

                <!--  Header: tool name + favorite toggle  -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock
                            Style="{ThemeResource TitleLargeTextBlockStyle}"
                            Text="{x:Bind ViewModel.ToolName, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.Tooltip, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleButton
                        Grid.Column="1"
                        Width="44"
                        Height="44"
                        Padding="0"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{markup:Localize Key=AddToFavorites}"
                        Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                        IsChecked="{x:Bind ViewModel.IsFavorite, Mode=OneWay}"
                        ToolTipService.ToolTip="{markup:Localize Key=AddToFavorites}">
                        <FontIcon FontSize="18" Glyph="&#xE734;" />
                    </ToggleButton>
                </Grid>

                <!--  Input  -->
                <TextBox
                    Header="{markup:Localize Key=SemaphoreInputLabel}"
                    PlaceholderText="{markup:Localize Key=SemaphoreInputPlaceholder}"
                    Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />

                <!--  Actions  -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.ClearCommand}" Content="{markup:Localize Key=SemaphoreClear}" />
                    <Button Command="{x:Bind ViewModel.CopyTextCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                            <TextBlock Text="{markup:Localize Key=SemaphoreCopy}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ShareTextCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE72D;" />
                            <TextBlock Text="{markup:Localize Key=SemaphoreShare}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--  Rendered figure sequence  -->
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=SemaphoreSequenceLabel}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Text="{markup:Localize Key=SemaphoreEmptyHint}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasFigures, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Figures, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            MinColumnSpacing="8"
                            MinItemWidth="76"
                            MinRowSpacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:SemaphoreFigureItem">
                            <StackPanel
                                AutomationProperties.Name="{x:Bind AutomationName}"
                                Spacing="4"
                                ToolTipService.ToolTip="{x:Bind ToolTip}">
                                <controls:SemaphoreFigureControl
                                    Height="64"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Figure="{x:Bind Figure}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Caption}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!--  Unknown-character notice  -->
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasUnknown, Mode=OneWay}"
                    Message="{markup:Localize Key=SemaphoreUnknownNotice}"
                    Severity="Warning" />

                <!--  Tappable chart  -->
                <Border
                    Margin="0,8,0,0"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=SemaphoreChartLabel}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{markup:Localize Key=SemaphoreChartHint}"
                            TextWrapping="Wrap" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Palette}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    ItemsStretch="Fill"
                                    MinColumnSpacing="8"
                                    MinItemWidth="92"
                                    MinRowSpacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:SemaphoreFigureItem">
                                    <Button
                                        Padding="8"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="{x:Bind AutomationName}"
                                        Command="{x:Bind TapCommand}"
                                        ToolTipService.ToolTip="{x:Bind ToolTip}">
                                        <StackPanel Spacing="4">
                                            <controls:SemaphoreFigureControl
                                                Height="64"
                                                AutomationProperties.AccessibilityView="Raw"
                                                Figure="{x:Bind Figure}" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Caption}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <!--  Reference-only special signals (Cancel, Error) — not tappable  -->
                        <TextBlock
                            Margin="0,8,0,0"
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="{markup:Localize Key=SemaphoreSpecialLabel}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.SpecialSignals}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    ItemsStretch="Fill"
                                    MinColumnSpacing="8"
                                    MinItemWidth="92"
                                    MinRowSpacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:SemaphoreFigureItem">
                                    <Border
                                        Padding="8"
                                        AutomationProperties.Name="{x:Bind AutomationName}"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        ToolTipService.ToolTip="{x:Bind ToolTip}">
                                        <StackPanel Spacing="4">
                                            <controls:SemaphoreFigureControl
                                                Height="64"
                                                AutomationProperties.AccessibilityView="Raw"
                                                Figure="{x:Bind Figure}" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Caption}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

            </StackPanel>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="640" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ContentScroller.Padding" Value="24" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Narrow">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ContentScroller.Padding" Value="12" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ScrollViewer>
</local:SemaphoreViewBase>
