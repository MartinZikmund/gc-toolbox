<local:GronsfeldCipherViewBase
    x:Class="GcToolkit.Views.GronsfeldCipherView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ciphers="using:GcToolkit.Core.Ciphers"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="24">
        <Grid>
            <StackPanel
                MaxWidth="760"
                HorizontalAlignment="Stretch"
                Spacing="16">

                <!--  Header: tool name + favorite toggle  -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock
                            Style="{ThemeResource TitleLargeTextBlockStyle}"
                            Text="{x:Bind ViewModel.ToolName, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.Tooltip, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleButton
                        Grid.Column="1"
                        Width="44"
                        Height="44"
                        Padding="0"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{markup:Localize Key=AddToFavorites}"
                        Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                        IsChecked="{x:Bind ViewModel.IsFavorite, Mode=OneWay}"
                        ToolTipService.ToolTip="{markup:Localize Key=AddToFavorites}">
                        <FontIcon FontSize="18" Glyph="&#xE734;" />
                    </ToggleButton>
                </Grid>

                <!--  Numeric key  -->
                <StackPanel Spacing="4">
                    <TextBox
                        FontFamily="Consolas"
                        Header="{markup:Localize Key=GronsfeldKeyLabel}"
                        InputScope="Number"
                        PlaceholderText="{markup:Localize Key=GronsfeldKeyPlaceholder}"
                        Text="{x:Bind ViewModel.Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{markup:Localize Key=GronsfeldKeyError}"
                        Visibility="{x:Bind ViewModel.HasKeyError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>

                <!--  Direction (toggling carries the result into the input for a one-tap round-trip)  -->
                <RadioButtons MaxColumns="2" SelectedIndex="{x:Bind ViewModel.DirectionIndex, Mode=TwoWay}">
                    <RadioButton Content="{markup:Localize Key=GronsfeldEncode}" />
                    <RadioButton Content="{markup:Localize Key=GronsfeldDecode}" />
                </RadioButtons>

                <!--  Input  -->
                <TextBox
                    MinHeight="96"
                    AcceptsReturn="True"
                    Header="{markup:Localize Key=GronsfeldInputLabel}"
                    PlaceholderText="{markup:Localize Key=GronsfeldInputPlaceholder}"
                    Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />

                <Button Command="{x:Bind ViewModel.ClearCommand}" Content="{markup:Localize Key=GronsfeldClear}" />

                <!--  Result  -->
                <StackPanel Spacing="8">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=GronsfeldOutputLabel}" />
                    <TextBox
                        MinHeight="96"
                        AcceptsReturn="True"
                        FontFamily="Consolas"
                        FontSize="18"
                        IsReadOnly="True"
                        IsSpellCheckEnabled="False"
                        Text="{x:Bind ViewModel.OutputText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!--  Output actions  -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.CopyOutputCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                            <TextBlock Text="{markup:Localize Key=GronsfeldCopy}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ShareOutputCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE72D;" />
                            <TextBlock Text="{markup:Localize Key=GronsfeldShare}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--  Digit -> letter reference (0 => A … 9 => J)  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=GronsfeldReferenceLabel}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.DigitReference}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="ciphers:GronsfeldDigitReference">
                                    <StackPanel
                                        Width="36"
                                        Margin="0,0,4,0"
                                        HorizontalAlignment="Center">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontFamily="Consolas"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Digit}" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="16"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Text="{x:Bind Letter}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=GronsfeldReferenceNote}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</local:GronsfeldCipherViewBase>
