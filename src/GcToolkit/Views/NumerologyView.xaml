<local:NumerologyViewBase
    x:Class="GcToolkit.Views.NumerologyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup"
    xmlns:tools="using:GcToolkit.Core.ViewModels.Tools"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <local:NumerologyViewBase.Resources>
        <Style x:Key="NumerologyCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="NumerologyLetterCellStyle" TargetType="Border">
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </local:NumerologyViewBase.Resources>

    <Grid MaxWidth="1024" HorizontalAlignment="Center">
        <ScrollViewer Padding="24" HorizontalContentAlignment="Center">
            <StackPanel HorizontalAlignment="Stretch" Spacing="16">

                <!--  Header: tool name + favorite toggle  -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock
                            Style="{ThemeResource TitleLargeTextBlockStyle}"
                            Text="{x:Bind ViewModel.ToolName, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.Tooltip, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleButton
                        Grid.Column="1"
                        Width="44"
                        Height="44"
                        Padding="0"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{markup:Localize Key=AddToFavorites}"
                        Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                        IsChecked="{x:Bind ViewModel.IsFavorite, Mode=OneWay}"
                        ToolTipService.ToolTip="{markup:Localize Key=AddToFavorites}">
                        <FontIcon FontSize="18" Glyph="&#xE734;" />
                    </ToggleButton>
                </Grid>

                <!--  Input  -->
                <TextBox
                    Header="{markup:Localize Key=NumerologyInputLabel}"
                    PlaceholderText="{markup:Localize Key=NumerologyInputPlaceholder}"
                    Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />

                <!--  Reduction mode + master-number toggle  -->
                <StackPanel Spacing="8">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=NumerologyReductionLabel}" />
                    <RadioButtons MaxColumns="3" SelectedIndex="{x:Bind ViewModel.ReductionModeIndex, Mode=TwoWay}">
                        <RadioButton Content="{markup:Localize Key=NumerologyReductionFull}" />
                        <RadioButton Content="{markup:Localize Key=NumerologyReductionSingle}" />
                        <RadioButton Content="{markup:Localize Key=NumerologyReductionRaw}" />
                    </RadioButtons>
                    <CheckBox Content="{markup:Localize Key=NumerologyPreserveMaster}" IsChecked="{x:Bind ViewModel.PreserveMasterNumbers, Mode=TwoWay}" />
                </StackPanel>

                <!--  Empty / no-letters notice  -->
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.ShowEmptyNotice, Mode=OneWay}"
                    Message="{markup:Localize Key=NumerologyEmptyNotice}"
                    Severity="Informational" />

                <!--  All-systems live results  -->
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=NumerologyAllSystemsLabel}" />
                    <GridView
                        IsItemClickEnabled="False"
                        ItemsSource="{x:Bind ViewModel.Systems}"
                        SelectionMode="None">
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="0,0,12,12" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="tools:NumerologySystemRow">
                                <Border Style="{StaticResource NumerologyCardStyle}">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Name}"
                                            TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Text="{markup:Localize Key=NumerologyTotalLabel}" />
                                            <TextBlock
                                                FontFamily="Consolas"
                                                Style="{ThemeResource BodyTextBlockStyle}"
                                                Text="{x:Bind Total, Mode=OneWay}" />
                                        </StackPanel>
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontSize="28"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Style="{ThemeResource TitleTextBlockStyle}"
                                            Text="{x:Bind Reduced, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <!--  Focused system selector (drives the breakdown)  -->
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=NumerologyBreakdownLabel}" />
                    <RadioButtons MaxColumns="4" SelectedIndex="{x:Bind ViewModel.SelectedSystemIndex, Mode=TwoWay}">
                        <RadioButton Content="{markup:Localize Key=Numerology_System_Pythagorean1To9}" />
                        <RadioButton Content="{markup:Localize Key=Numerology_System_Pythagorean1To0}" />
                        <RadioButton Content="{markup:Localize Key=Numerology_System_Chaldean}" />
                        <RadioButton Content="{markup:Localize Key=Numerology_System_Simple}" />
                    </RadioButtons>

                    <!--  Per-letter breakdown cells  -->
                    <GridView
                        IsItemClickEnabled="False"
                        ItemsSource="{x:Bind ViewModel.Breakdown}"
                        SelectionMode="None">
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="0,0,8,8" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="tools:NumerologyLetterRow">
                                <Border Style="{StaticResource NumerologyLetterCellStyle}">
                                    <StackPanel>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontFamily="Consolas"
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Letter}" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontFamily="Consolas"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Value}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>

                <!--  Per-word / per-line totals  -->
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowWordTotals, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=NumerologyWordTotalsLabel}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.WordTotals}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="tools:NumerologyWordRow">
                                <Grid Margin="0,2" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        FontFamily="Consolas"
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Text="{x:Bind Word}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontFamily="Consolas"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Text="{x:Bind Total}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        FontFamily="Consolas"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Reduced}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!--  Actions  -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.CopyCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                            <TextBlock Text="{markup:Localize Key=NumerologyCopy}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ShareCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE72D;" />
                            <TextBlock Text="{markup:Localize Key=NumerologyShare}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ClearCommand}" Content="{markup:Localize Key=NumerologyClear}" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:NumerologyViewBase>
