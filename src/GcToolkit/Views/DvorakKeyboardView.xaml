<local:DvorakKeyboardViewBase
    x:Class="GcToolkit.Views.DvorakKeyboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup"
    xmlns:tools="using:GcToolkit.Core.ViewModels.Tools"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="24">
        <Grid>
            <StackPanel
                MaxWidth="760"
                HorizontalAlignment="Stretch"
                Spacing="16">

                <!--  Header: tool name + favorite toggle  -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock
                            Style="{ThemeResource TitleLargeTextBlockStyle}"
                            Text="{x:Bind ViewModel.ToolName, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.Tooltip, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleButton
                        Grid.Column="1"
                        Width="44"
                        Height="44"
                        Padding="0"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{markup:Localize Key=AddToFavorites}"
                        Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                        IsChecked="{x:Bind ViewModel.IsFavorite, Mode=OneWay}"
                        ToolTipService.ToolTip="{markup:Localize Key=AddToFavorites}">
                        <FontIcon FontSize="18" Glyph="&#xE734;" />
                    </ToggleButton>
                </Grid>

                <!--  Layout selectors: Input | Swap | Output  -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ComboBox
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Header="{markup:Localize Key=DvorakInputLayout}"
                        ItemsSource="{x:Bind ViewModel.LayoutNames}"
                        SelectedIndex="{x:Bind ViewModel.InputLayoutIndex, Mode=TwoWay}" />

                    <Button
                        Grid.Column="1"
                        Width="40"
                        Height="40"
                        Padding="0"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="{markup:Localize Key=DvorakSwap}"
                        Command="{x:Bind ViewModel.SwapCommand}"
                        ToolTipService.ToolTip="{markup:Localize Key=DvorakSwap}">
                        <FontIcon FontSize="16" Glyph="&#xE8AB;" />
                    </Button>

                    <ComboBox
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        Header="{markup:Localize Key=DvorakOutputLayout}"
                        ItemsSource="{x:Bind ViewModel.LayoutNames}"
                        SelectedIndex="{x:Bind ViewModel.OutputLayoutIndex, Mode=TwoWay}" />
                </Grid>

                <!--  Input  -->
                <TextBox
                    MinHeight="96"
                    AcceptsReturn="True"
                    Header="{markup:Localize Key=DvorakInputLabel}"
                    IsSpellCheckEnabled="False"
                    PlaceholderText="{markup:Localize Key=DvorakInputPlaceholder}"
                    Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Command="{x:Bind ViewModel.ClearCommand}" Content="{markup:Localize Key=DvorakClear}" />
                    <ToggleSwitch
                        VerticalAlignment="Center"
                        Header="{markup:Localize Key=DvorakShowAllDirections}"
                        IsOn="{x:Bind ViewModel.ShowAllDirections, Mode=TwoWay}" />
                </StackPanel>

                <!--  Single result (hidden while showing all directions)  -->
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowAllDirections, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=DvorakOutputLabel}" />
                    <TextBox
                        MinHeight="96"
                        AcceptsReturn="True"
                        FontFamily="Consolas"
                        FontSize="18"
                        IsReadOnly="True"
                        IsSpellCheckEnabled="False"
                        Text="{x:Bind ViewModel.OutputText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.IsIdentity, Mode=OneWay}"
                        Message="{markup:Localize Key=DvorakIdentityNote}"
                        Severity="Informational" />
                </StackPanel>

                <!--  All directions (brute-force list) — visible only in "try all directions" mode  -->
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowAllDirections, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=DvorakAllDirectionsLabel}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Candidates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="tools:DvorakCandidateItem">
                                <Grid
                                    Margin="0,2"
                                    Padding="8,6"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    ColumnSpacing="12"
                                    CornerRadius="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Pairing}" />
                                        <TextBox
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontFamily="Consolas"
                                            IsReadOnly="True"
                                            IsSpellCheckEnabled="False"
                                            Text="{x:Bind Text}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Width="36"
                                        Height="36"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{markup:Localize Key=DvorakCopyCandidate}"
                                        Command="{x:Bind CopyCommand}"
                                        ToolTipService.ToolTip="{markup:Localize Key=DvorakCopyCandidate}">
                                        <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!--  Output actions  -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.CopyOutputCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                            <TextBlock Text="{markup:Localize Key=DvorakCopy}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ShareOutputCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE72D;" />
                            <TextBlock Text="{markup:Localize Key=DvorakShare}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--  How it works  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=DvorakHowLabel}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{markup:Localize Key=DvorakHowNote}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=DvorakHistoryNote}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</local:DvorakKeyboardViewBase>
