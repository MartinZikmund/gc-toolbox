<local:CoordinateAveragingViewBase
    x:Class="GcToolkit.Views.CoordinateAveragingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GcToolkit.Controls"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup"
    xmlns:tools="using:GcToolkit.Core.ViewModels.Tools">

    <controls:ToolPage
        ContentWidth="Wide"
        CopyCommand="{x:Bind ViewModel.CopyOutputCommand}"
        ShareCommand="{x:Bind ViewModel.ShareOutputCommand}"
        Tool="{x:Bind ViewModel}">

        <controls:ToolPage.Actions>
            <Button Command="{x:Bind ViewModel.ClearCommand}" Content="{markup:Localize Key=CoordinateAveragingClear}" />
        </controls:ToolPage.Actions>

        <StackPanel Spacing="16">

            <!--  One reading per line, notations may be mixed  -->
            <TextBox
                MinHeight="160"
                AcceptsReturn="True"
                FontFamily="{ThemeResource AppMonoFontFamily}"
                Header="{markup:Localize Key=CoordinateAveragingInputLabel}"
                IsSpellCheckEnabled="False"
                PlaceholderText="{markup:Localize Key=CoordinateAveragingInputPlaceholder}"
                Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="NoWrap" />

            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Text="{markup:Localize Key=CoordinateAveragingInputHint}"
                TextWrapping="Wrap" />

            <!--  Unreadable lines are named, never silently dropped  -->
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasParseErrors, Mode=OneWay}"
                Message="{x:Bind ViewModel.ParseErrorMessage, Mode=OneWay}"
                Severity="Warning" />

            <!--  The fix  -->
            <Border Style="{StaticResource ToolReadoutSurfaceStyle}" Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="16">
                    <TextBlock
                        Foreground="{ThemeResource ReadoutForegroundBrush}"
                        Opacity="0.7"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.ReadingCountText, Mode=OneWay}" />

                    <StackPanel Spacing="4">
                        <TextBlock
                            Foreground="{ThemeResource ReadoutForegroundBrush}"
                            Opacity="0.7"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=CoordinateAveragingBestEstimate}" />
                        <TextBlock
                            AutomationProperties.Name="{markup:Localize Key=CoordinateAveragingBestEstimate}"
                            FontSize="22"
                            Style="{StaticResource ToolReadoutTextStyle}"
                            Text="{x:Bind ViewModel.BestEstimateText, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource ReadoutForegroundBrush}"
                            Opacity="0.6"
                            Style="{StaticResource MonoTextBlockStyle}"
                            Text="{x:Bind ViewModel.BestEstimateDecimalText, Mode=OneWay}" />
                    </StackPanel>

                    <Rectangle
                        Height="1"
                        Fill="{ThemeResource ReadoutForegroundBrush}"
                        Opacity="0.2" />

                    <!--  Shown so a puzzle that expects the naive mean still works  -->
                    <StackPanel Spacing="4">
                        <TextBlock
                            Foreground="{ThemeResource ReadoutForegroundBrush}"
                            Opacity="0.7"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=CoordinateAveragingArithmetic}" />
                        <TextBlock
                            AutomationProperties.Name="{markup:Localize Key=CoordinateAveragingArithmetic}"
                            Style="{StaticResource ToolReadoutTextStyle}"
                            Text="{x:Bind ViewModel.ArithmeticText, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  How much to trust the fix  -->
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasResult, Mode=OneWay}"
                Message="{x:Bind ViewModel.QualityMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.QualitySeverity, Mode=OneWay}" />

            <!--  Readings that straddle the antimeridian pull the arithmetic mean off the planet  -->
            <InfoBar
                Title="{markup:Localize Key=CoordinateAveragingDivergenceTitle}"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasDivergence, Mode=OneWay}"
                Message="{markup:Localize Key=CoordinateAveragingDivergenceNote}"
                Severity="Warning" />

            <!--  Spread  -->
            <Border
                Padding="16"
                Background="{ThemeResource AppSurfaceBrush}"
                BorderBrush="{ThemeResource AppStrokeBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=CoordinateAveragingFarthest}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontSize="18"
                            Foreground="{ThemeResource AccentFoundTextBrush}"
                            Style="{StaticResource MonoTextBlockStyle}"
                            Text="{x:Bind ViewModel.MaxDistanceText, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=CoordinateAveragingMeanDistance}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontSize="18"
                            Style="{StaticResource MonoTextBlockStyle}"
                            Text="{x:Bind ViewModel.MeanDistanceText, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Every reading, with its offset from the fix — the outliers show up here  -->
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=CoordinateAveragingReadings}" />

                <Grid Padding="8,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{markup:Localize Key=CoordinateAveragingColumnReading}" />
                    <TextBlock
                        Grid.Column="1"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{markup:Localize Key=CoordinateAveragingColumnCoordinate}" />
                    <TextBlock
                        Grid.Column="2"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{markup:Localize Key=CoordinateAveragingColumnDistance}" />
                    <TextBlock
                        Grid.Column="3"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{markup:Localize Key=CoordinateAveragingColumnBearing}" />
                </Grid>

                <ItemsControl ItemsSource="{x:Bind ViewModel.Readings, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="tools:CoordinatePointRow">
                            <Grid
                                Margin="0,2"
                                Padding="8,6"
                                Background="{ThemeResource AppSurfaceBrush}"
                                ColumnSpacing="12"
                                CornerRadius="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource MonoTextBlockStyle}"
                                    Text="{x:Bind Number}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource MonoTextBlockStyle}"
                                    Text="{x:Bind Coordinate}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource MonoTextBlockStyle}"
                                    Text="{x:Bind Distance}" />
                                <TextBlock
                                    Grid.Column="3"
                                    Style="{StaticResource MonoTextBlockStyle}"
                                    Text="{x:Bind Bearing}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
    </controls:ToolPage>
</local:CoordinateAveragingViewBase>
