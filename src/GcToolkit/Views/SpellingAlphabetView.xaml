<local:SpellingAlphabetViewBase
    x:Class="GcToolkit.Views.SpellingAlphabetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup"
    xmlns:tools="using:GcToolkit.Core.ViewModels.Tools"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="24">
        <Grid>
            <StackPanel
                MaxWidth="760"
                HorizontalAlignment="Stretch"
                Spacing="16">

                <!--  Header: tool name + favorite toggle  -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock
                            Style="{ThemeResource TitleLargeTextBlockStyle}"
                            Text="{x:Bind ViewModel.ToolName, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.Tooltip, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleButton
                        Grid.Column="1"
                        Width="44"
                        Height="44"
                        Padding="0"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{markup:Localize Key=AddToFavorites}"
                        Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                        IsChecked="{x:Bind ViewModel.IsFavorite, Mode=OneWay}"
                        ToolTipService.ToolTip="{markup:Localize Key=AddToFavorites}">
                        <FontIcon FontSize="18" Glyph="&#xE734;" />
                    </ToggleButton>
                </Grid>

                <!--  Variant selector  -->
                <ComboBox
                    HorizontalAlignment="Stretch"
                    Header="{markup:Localize Key=SpellingAlphabetVariantLabel}"
                    ItemsSource="{x:Bind ViewModel.Variants}"
                    SelectedItem="{x:Bind ViewModel.SelectedVariant, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="tools:SpellingAlphabetVariantOption">
                            <TextBlock Text="{x:Bind DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!--  Direction + auto-detect  -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <RadioButtons
                        Grid.Column="0"
                        IsEnabled="{x:Bind ViewModel.AutoDetectDirection, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}"
                        MaxColumns="2"
                        SelectedIndex="{x:Bind ViewModel.DirectionIndex, Mode=TwoWay}">
                        <RadioButton Content="{markup:Localize Key=SpellingAlphabetEncode}" />
                        <RadioButton Content="{markup:Localize Key=SpellingAlphabetDecode}" />
                    </RadioButtons>

                    <ToggleSwitch
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Header="{markup:Localize Key=SpellingAlphabetAutoDetect}"
                        IsOn="{x:Bind ViewModel.AutoDetectDirection, Mode=TwoWay}" />
                </Grid>

                <!--  Input  -->
                <TextBox
                    MinHeight="96"
                    AcceptsReturn="True"
                    Header="{markup:Localize Key=SpellingAlphabetInputLabel}"
                    PlaceholderText="{markup:Localize Key=SpellingAlphabetInputPlaceholder}"
                    Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Command="{x:Bind ViewModel.ClearCommand}" Content="{markup:Localize Key=SpellingAlphabetClear}" />
                    <Button Command="{x:Bind ViewModel.SwapCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE8AB;" />
                            <TextBlock Text="{markup:Localize Key=SpellingAlphabetSwap}" />
                        </StackPanel>
                    </Button>
                    <ToggleSwitch
                        VerticalAlignment="Center"
                        Header="{markup:Localize Key=SpellingAlphabetShowAllVariants}"
                        IsOn="{x:Bind ViewModel.ShowAllVariants, Mode=TwoWay}" />
                </StackPanel>

                <!--  Result  -->
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=SpellingAlphabetOutputLabel}" />
                <TextBox
                    MinHeight="72"
                    AcceptsReturn="True"
                    AutomationProperties.Name="{markup:Localize Key=SpellingAlphabetOutputLabel}"
                    FontSize="16"
                    IsReadOnly="True"
                    IsSpellCheckEnabled="False"
                    Text="{x:Bind ViewModel.OutputText, Mode=OneWay}"
                    TextWrapping="Wrap" />

                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasUnknown, Mode=OneWay}"
                    Message="{x:Bind ViewModel.UnknownNotice, Mode=OneWay}"
                    Severity="Warning" />

                <!--  Output actions  -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.CopyOutputCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                            <TextBlock Text="{markup:Localize Key=SpellingAlphabetCopy}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ShareOutputCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE72D;" />
                            <TextBlock Text="{markup:Localize Key=SpellingAlphabetShare}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--  Multi-variant brute force (beyond parity) — visible only when toggled on  -->
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowAllVariants, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=SpellingAlphabetAllVariantsLabel}" />
                    <!--  ListView virtualizes the brute-force rows so only visible ones are realized.  -->
                    <ListView
                        MaxHeight="420"
                        ItemsSource="{x:Bind ViewModel.VariantGuesses, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="tools:SpellingAlphabetGuess">
                                <Grid
                                    Margin="0,2"
                                    Padding="8,6"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    ColumnSpacing="12"
                                    CornerRadius="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        Text="{x:Bind VariantName}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind Text}"
                                        TextWrapping="Wrap" />
                                    <Button
                                        Grid.Column="2"
                                        Width="36"
                                        Height="36"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{markup:Localize Key=SpellingAlphabetCopy}"
                                        Command="{x:Bind CopyCommand}"
                                        ToolTipService.ToolTip="{markup:Localize Key=SpellingAlphabetCopy}">
                                        <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <!--  Code-word chart for the selected variant (tap a letter to type it)  -->
                <Expander
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    IsExpanded="True">
                    <Expander.Header>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=SpellingAlphabetChartTitle}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{markup:Localize Key=SpellingAlphabetChartHint}" />
                        </StackPanel>
                    </Expander.Header>
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Chart, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                ItemsStretch="Fill"
                                MinColumnSpacing="8"
                                MinItemWidth="150"
                                MinRowSpacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="tools:SpellingAlphabetChartItem">
                                <Button
                                    Padding="10,8"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    AutomationProperties.Name="{x:Bind Caption}"
                                    Command="{x:Bind AppendCommand}"
                                    ToolTipService.ToolTip="{x:Bind Caption}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock
                                            MinWidth="20"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Letter}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{ThemeResource BodyTextBlockStyle}"
                                            Text="{x:Bind Word}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Expander>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</local:SpellingAlphabetViewBase>
