<local:BaconCipherViewBase
    x:Class="GcToolkit.Views.BaconCipherView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ciphers="using:GcToolkit.Core.Ciphers"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer x:Name="PageRoot" Padding="24">
        <Grid>
            <StackPanel
                MaxWidth="1024"
                HorizontalAlignment="Stretch"
                Spacing="16">

                <!--  Header: tool name + favorite toggle  -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock
                            Style="{ThemeResource TitleLargeTextBlockStyle}"
                            Text="{x:Bind ViewModel.ToolName, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.Tooltip, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleButton
                        Grid.Column="1"
                        Width="44"
                        Height="44"
                        Padding="0"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{markup:Localize Key=AddToFavorites}"
                        Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                        IsChecked="{x:Bind ViewModel.IsFavorite, Mode=OneWay}"
                        ToolTipService.ToolTip="{markup:Localize Key=AddToFavorites}">
                        <FontIcon FontSize="18" Glyph="&#xE734;" />
                    </ToggleButton>
                </Grid>

                <!--  Version (Standard / V2 distinct)  -->
                <RadioButtons
                    Header="{markup:Localize Key=BaconVersion}"
                    MaxColumns="2"
                    SelectedIndex="{x:Bind ViewModel.VersionIndex, Mode=TwoWay}">
                    <RadioButton Content="{markup:Localize Key=BaconVersionStandard}" />
                    <RadioButton Content="{markup:Localize Key=BaconVersionDistinct}" />
                </RadioButtons>

                <!--  Direction  -->
                <RadioButtons MaxColumns="2" SelectedIndex="{x:Bind ViewModel.DirectionIndex, Mode=TwoWay}">
                    <RadioButton Content="{markup:Localize Key=BaconEncrypt}" />
                    <RadioButton Content="{markup:Localize Key=BaconDecrypt}" />
                </RadioButtons>

                <!--  Symbols: swap toggle + optional custom pair  -->
                <Grid ColumnSpacing="12" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Grid.Column="0"
                        Width="96"
                        Header="{markup:Localize Key=BaconFirstSymbol}"
                        IsSpellCheckEnabled="False"
                        MaxLength="1"
                        Text="{x:Bind ViewModel.FirstSymbol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox
                        Grid.Column="1"
                        Width="96"
                        Header="{markup:Localize Key=BaconSecondSymbol}"
                        IsSpellCheckEnabled="False"
                        MaxLength="1"
                        Text="{x:Bind ViewModel.SecondSymbol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ToggleSwitch
                        Grid.Column="2"
                        VerticalAlignment="Bottom"
                        Header="{markup:Localize Key=BaconSwapSymbols}"
                        IsOn="{x:Bind ViewModel.SwapSymbols, Mode=TwoWay}" />
                </Grid>

                <!--  Input  -->
                <TextBox
                    MinHeight="96"
                    AcceptsReturn="True"
                    Header="{markup:Localize Key=BaconInputLabel}"
                    PlaceholderText="{markup:Localize Key=BaconInputPlaceholder}"
                    Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />

                <Button Command="{x:Bind ViewModel.ClearCommand}" Content="{markup:Localize Key=BaconClear}" />

                <!--  Result  -->
                <StackPanel Spacing="8">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=BaconOutputLabel}" />
                    <TextBox
                        MinHeight="96"
                        AcceptsReturn="True"
                        FontFamily="Consolas"
                        FontSize="18"
                        IsReadOnly="True"
                        IsSpellCheckEnabled="False"
                        Text="{x:Bind ViewModel.OutputText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasDecodeWarning, Mode=OneWay}"
                        Message="{markup:Localize Key=BaconDecodeWarning}"
                        Severity="Warning" />
                </StackPanel>

                <!--  Output actions  -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.CopyOutputCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                            <TextBlock Text="{markup:Localize Key=BaconCopy}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ShareOutputCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE72D;" />
                            <TextBlock Text="{markup:Localize Key=BaconShare}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--  Reference chart for the active version  -->
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=BaconTableLabel}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.ReferenceTable}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VariableSizedWrapGrid
                                        ItemHeight="56"
                                        ItemWidth="92"
                                        Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="ciphers:BaconTableRow">
                                    <Button
                                        MinWidth="0"
                                        MinHeight="0"
                                        Margin="4"
                                        Padding="8,6"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Center"
                                        AutomationProperties.Name="{x:Bind AutomationName}"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.AppendFromTableCommand, ElementName=PageRoot}"
                                        CommandParameter="{x:Bind}"
                                        CornerRadius="6"
                                        ToolTipService.ToolTip="{x:Bind AutomationName}">
                                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind Letter}" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontFamily="Consolas"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Text="{x:Bind Code}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=BaconTableNote}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</local:BaconCipherViewBase>
