<local:SegmentDisplayViewBase
    x:Class="GcToolkit.Views.SegmentDisplayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:alphabets="using:GcToolkit.Core.Alphabets"
    xmlns:controls="using:GcToolkit.Controls"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <local:SegmentDisplayViewBase.Resources>
        <!--  One rendered character of the result/input strip  -->
        <DataTemplate x:Key="SegmentGlyphTemplate" x:DataType="alphabets:SegmentGlyph">
            <Border
                Width="58"
                Height="92"
                AutomationProperties.Name="{x:Bind Character}"
                ToolTipService.ToolTip="{x:Bind Binary}">
                <controls:SegmentDisplayPresenter Glyph="{x:Bind}" />
            </Border>
        </DataTemplate>
    </local:SegmentDisplayViewBase.Resources>

    <ScrollViewer Padding="24">
        <StackPanel
            MaxWidth="760"
            HorizontalAlignment="Stretch"
            Spacing="16">

            <!--  Header: tool name + favorite toggle  -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock
                        Style="{ThemeResource TitleLargeTextBlockStyle}"
                        Text="{x:Bind ViewModel.ToolName, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.Tooltip, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <ToggleButton
                    Grid.Column="1"
                    Width="44"
                    Height="44"
                    Padding="0"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="{markup:Localize Key=AddToFavorites}"
                    Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                    IsChecked="{x:Bind ViewModel.IsFavorite, Mode=OneWay}"
                    ToolTipService.ToolTip="{markup:Localize Key=AddToFavorites}">
                    <FontIcon FontSize="18" Glyph="&#xE734;" />
                </ToggleButton>
            </Grid>

            <!--  Display family picker  -->
            <ComboBox
                Header="{markup:Localize Key=SegmentDisplayType}"
                ItemsSource="{x:Bind ViewModel.DisplayTypeOptions}"
                SelectedIndex="{x:Bind ViewModel.DisplayTypeIndex, Mode=TwoWay}" />

            <!--  Direction + swap  -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <RadioButtons
                    Grid.Column="0"
                    MaxColumns="2"
                    SelectedIndex="{x:Bind ViewModel.DirectionIndex, Mode=TwoWay}">
                    <RadioButton Content="{markup:Localize Key=SegmentTextToDisplay}" />
                    <RadioButton Content="{markup:Localize Key=SegmentDisplayToText}" />
                </RadioButtons>
                <Button
                    Grid.Column="1"
                    Height="44"
                    VerticalAlignment="Bottom"
                    AutomationProperties.Name="{markup:Localize Key=SegmentSwap}"
                    Command="{x:Bind ViewModel.SwapDirectionCommand}"
                    ToolTipService.ToolTip="{markup:Localize Key=SegmentSwap}">
                    <FontIcon FontSize="16" Glyph="&#xE8AB;" />
                </Button>
            </Grid>

            <!--  Notation picker (decode side only) + toggles  -->
            <ComboBox
                Header="{markup:Localize Key=SegmentNotation}"
                ItemsSource="{x:Bind ViewModel.NotationOptions}"
                SelectedIndex="{x:Bind ViewModel.NotationIndex, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.IsDecoding, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

            <StackPanel Orientation="Horizontal" Spacing="16">
                <ToggleSwitch
                    Header="{markup:Localize Key=SegmentInvert}"
                    IsOn="{x:Bind ViewModel.Invert, Mode=TwoWay}"
                    OffContent="{markup:Localize Key=SegmentAnode}"
                    OnContent="{markup:Localize Key=SegmentCathode}" />
                <ToggleSwitch
                    Header="{markup:Localize Key=SegmentBitOrder}"
                    IsOn="{x:Bind ViewModel.ReverseBits, Mode=TwoWay}"
                    OffContent="{markup:Localize Key=SegmentBitNormal}"
                    OnContent="{markup:Localize Key=SegmentBitReversed}" />
            </StackPanel>

            <!--  Input  -->
            <TextBox
                MinHeight="80"
                AcceptsReturn="True"
                FontFamily="Consolas"
                Header="{markup:Localize Key=SegmentInputLabel}"
                PlaceholderText="{markup:Localize Key=SegmentInputPlaceholder}"
                Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />

            <Button Command="{x:Bind ViewModel.ClearCommand}" Content="{markup:Localize Key=SegmentClear}" />

            <!--  Validation warning  -->
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasWarning, Mode=OneWay}"
                Message="{x:Bind ViewModel.WarningMessage, Mode=OneWay}"
                Severity="Warning" />

            <!--  Live glyph preview  -->
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasGlyphs, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=SegmentPreviewLabel}" />
                <Border
                    Padding="16"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="8">
                    <ItemsRepeater ItemTemplate="{StaticResource SegmentGlyphTemplate}" ItemsSource="{x:Bind ViewModel.Glyphs}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                ItemsStretch="None"
                                MinColumnSpacing="10"
                                MinItemWidth="58"
                                MinRowSpacing="10" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </Border>
            </StackPanel>

            <!--  Result text  -->
            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=SegmentOutputLabel}" />
            <TextBox
                MinHeight="64"
                AcceptsReturn="True"
                AutomationProperties.Name="{markup:Localize Key=SegmentOutputLabel}"
                FontFamily="Consolas"
                FontSize="16"
                IsReadOnly="True"
                IsSpellCheckEnabled="False"
                Text="{x:Bind ViewModel.OutputText, Mode=OneWay}"
                TextWrapping="Wrap" />

            <!--  Output actions  -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.CopyOutputCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                        <TextBlock Text="{markup:Localize Key=SegmentCopy}" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.ShareOutputCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE72D;" />
                        <TextBlock Text="{markup:Localize Key=SegmentShare}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!--  Clickable reference chart — click a glyph to "type" it  -->
            <Expander
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsExpanded="True">
                <Expander.Header>
                    <StackPanel Spacing="2">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=SegmentChartTitle}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{markup:Localize Key=SegmentChartHint}" />
                    </StackPanel>
                </Expander.Header>
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Chart}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="None"
                            MinColumnSpacing="8"
                            MinItemWidth="72"
                            MinRowSpacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="alphabets:SegmentGlyph">
                            <Button
                                Padding="6,8"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                AutomationProperties.Name="{x:Bind Character}"
                                Click="OnChartItemClick"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="{x:Bind Binary}">
                                <StackPanel HorizontalAlignment="Center" Spacing="6">
                                    <controls:SegmentDisplayPresenter
                                        Width="34"
                                        Height="54"
                                        Glyph="{x:Bind}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Character}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Expander>

            <!--  How it works  -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=SegmentAboutTitle}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Text="{markup:Localize Key=SegmentAboutBody}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</local:SegmentDisplayViewBase>
