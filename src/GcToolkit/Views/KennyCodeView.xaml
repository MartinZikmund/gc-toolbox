<local:KennyCodeViewBase
    x:Class="GcToolkit.Views.KennyCodeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GcToolkit.Controls"
    xmlns:local="using:GcToolkit.Views"
    xmlns:markup="using:GcToolkit.Markup"
    xmlns:tools="using:GcToolkit.Core.ViewModels.Tools"
    x:Name="PageRoot">

    <controls:ToolPage Tool="{x:Bind ViewModel}">
        <StackPanel Spacing="16">


            <!--  Direction  -->
            <RadioButtons MaxColumns="2" SelectedIndex="{x:Bind ViewModel.DirectionIndex, Mode=TwoWay}">
                <RadioButton Content="{markup:Localize Key=KennyCodeEncode}" />
                <RadioButton Content="{markup:Localize Key=KennyCodeDecode}" />
            </RadioButtons>

            <!--  Input  -->
            <TextBox
                MinHeight="96"
                AcceptsReturn="True"
                Header="{markup:Localize Key=KennyCodeInputLabel}"
                PlaceholderText="{markup:Localize Key=KennyCodeInputPlaceholder}"
                Text="{x:Bind ViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />

            <Button Command="{x:Bind ViewModel.ClearCommand}" Content="{markup:Localize Key=KennyCodeClear}" />

            <!--  Encode options (hidden while decoding)  -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsEncoding, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <RadioButtons
                    Header="{markup:Localize Key=KennyCodeSeparator}"
                    MaxColumns="3"
                    SelectedIndex="{x:Bind ViewModel.SeparatorIndex, Mode=TwoWay}">
                    <RadioButton Content="{markup:Localize Key=KennyCodeSeparatorNone}" />
                    <RadioButton Content="{markup:Localize Key=KennyCodeSeparatorSpace}" />
                    <RadioButton Content="{markup:Localize Key=KennyCodeSeparatorComma}" />
                </RadioButtons>
                <StackPanel Orientation="Horizontal" Spacing="24">
                    <ToggleSwitch Header="{markup:Localize Key=KennyCodeUpperCase}" IsOn="{x:Bind ViewModel.UpperCase, Mode=TwoWay}" />
                    <ToggleSwitch Header="{markup:Localize Key=KennyCodePreserveStructure}" IsOn="{x:Bind ViewModel.PreserveStructure, Mode=TwoWay}" />
                </StackPanel>
            </StackPanel>

            <!--  Result  -->
            <StackPanel Spacing="8">
                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=KennyCodeOutputLabel}" />
                <TextBox
                    MinHeight="96"
                    AcceptsReturn="True"
                    FontFamily="{ThemeResource AppMonoFontFamily}"
                    FontSize="18"
                    IsReadOnly="True"
                    IsSpellCheckEnabled="False"
                    Text="{x:Bind ViewModel.OutputText, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasWarning, Mode=OneWay}"
                    Message="{x:Bind ViewModel.WarningMessage, Mode=OneWay}"
                    Severity="Warning" />
            </StackPanel>

            <!--  Output actions  -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.CopyOutputCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                        <TextBlock Text="{markup:Localize Key=KennyCodeCopy}" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.ShareOutputCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE72D;" />
                        <TextBlock Text="{markup:Localize Key=KennyCodeShare}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!--  Substitution chart (Original ↔ Substitution) — always visible  -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{markup:Localize Key=KennyCodeTableLabel}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.ReferenceTable}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VariableSizedWrapGrid
                                    ItemHeight="56"
                                    ItemWidth="72"
                                    Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="tools:KennyCodeTableRow">
                                <Button
                                    MinWidth="0"
                                    MinHeight="0"
                                    Margin="4"
                                    Padding="8,6"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Center"
                                    AutomationProperties.Name="{x:Bind AutomationName}"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderThickness="0"
                                    Command="{Binding DataContext.AppendFromTableCommand, ElementName=PageRoot}"
                                    CommandParameter="{x:Bind}"
                                    CornerRadius="6"
                                    ToolTipService.ToolTip="{x:Bind AutomationName}">
                                    <StackPanel HorizontalAlignment="Center" Spacing="2">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind Letter}" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontFamily="{ThemeResource AppMonoFontFamily}"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Text="{x:Bind Trigram}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{markup:Localize Key=KennyCodeTableNote}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </controls:ToolPage>
</local:KennyCodeViewBase>
