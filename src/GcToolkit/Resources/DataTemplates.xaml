<ResourceDictionary
    x:Class="GcToolkit.Resources.DataTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:GcToolkit.ViewModels">

    <!-- Shared tool card used by Home (favorites/recents) and the Catalog. -->
    <DataTemplate x:Key="ToolCardTemplate" x:DataType="vm:ToolListItem">
        <Grid MinHeight="64">
            <!-- Open affordance fills the card; right padding leaves room for the star. -->
            <Button
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalAlignment="Stretch"
                Padding="12,12,48,12"
                AutomationProperties.Name="{x:Bind Name}"
                Command="{x:Bind OpenCommand}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Grid.Column="0"
                        FontSize="20"
                        Glyph="{x:Bind IconKey}"
                        Visibility="{x:Bind HasIcon, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Name}"
                        TextWrapping="Wrap" />
                </Grid>
            </Button>

            <!-- Favorite toggle overlay. -->
            <ToggleButton
                Width="40"
                Height="40"
                Margin="0,4,4,0"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderThickness="0"
                AutomationProperties.Name="{x:Bind FavoriteToggleLabel, Mode=OneWay}"
                Command="{x:Bind ToggleFavoriteCommand}"
                IsChecked="{x:Bind IsFavorite, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind FavoriteToggleLabel, Mode=OneWay}">
                <FontIcon FontSize="16" Glyph="{x:Bind StarGlyph, Mode=OneWay}" />
            </ToggleButton>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
