<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Bundled because Consolas ships with Windows only: without it the five non-WinUI heads
        silently fall back to a proportional face and every readout jitters. The
        '#Cascadia Mono' fragment is name ID 1 of the .ttf and must match exactly — a wrong
        name fails silently into a fallback face, and would still look correct on Windows,
        where Cascadia Mono also happens to be installed system-wide.
    -->
    <FontFamily x:Key="AppMonoFontFamily">ms-appx:///Assets/Fonts/CascadiaMono.ttf#Cascadia Mono</FontFamily>

    <!--
        Cascadia Mono is monospaced, so its digits are already equal-width; NumeralAlignment
        states the intent and covers any fallback face that is not.
    -->
    <Style
        x:Key="MonoTextBlockStyle"
        BasedOn="{StaticResource BodyTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppMonoFontFamily}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!--  Text on the result surface, which is dark in both themes — hence a fixed foreground.  -->
    <Style
        x:Key="ReadoutTextBlockStyle"
        BasedOn="{StaticResource MonoTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{ThemeResource ReadoutForegroundBrush}" />
        <Setter Property="LineHeight" Value="24" />
    </Style>

    <!--  Coordinates get read digit-by-digit against a GPS, so open the tracking a touch.  -->
    <Style
        x:Key="CoordinateTextBlockStyle"
        BasedOn="{StaticResource MonoTextBlockStyle}"
        TargetType="TextBlock">
        <Setter Property="CharacterSpacing" Value="20" />
    </Style>

    <!--
        TextBox rejects Typography attached properties; the monospaced face alone is what
        stops its digits shifting as the user types.
    -->
    <Style x:Key="MonoTextBoxStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource AppMonoFontFamily}" />
    </Style>

</ResourceDictionary>
