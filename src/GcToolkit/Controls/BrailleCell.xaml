<UserControl
    x:Class="GcToolkit.Controls.BrailleCell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!--  Hollow outline for an empty dot position (always drawn so gaps stay visible).  -->
        <Style x:Key="BrailleDotOutline" TargetType="Ellipse">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Stroke" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="Fill" Value="Transparent" />
        </Style>
        <!--  Solid ink for a raised dot, layered over its outline; toggled from code-behind.  -->
        <Style x:Key="BrailleDotFill" TargetType="Ellipse">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Fill" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </UserControl.Resources>

    <Grid
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        ColumnSpacing="5"
        RowSpacing="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Outlines: dots 1-2-3 down the left column, 4-5-6 down the right.  -->
        <Ellipse
            Grid.Row="0"
            Grid.Column="0"
            Style="{StaticResource BrailleDotOutline}" />
        <Ellipse
            Grid.Row="1"
            Grid.Column="0"
            Style="{StaticResource BrailleDotOutline}" />
        <Ellipse
            Grid.Row="2"
            Grid.Column="0"
            Style="{StaticResource BrailleDotOutline}" />
        <Ellipse
            Grid.Row="0"
            Grid.Column="1"
            Style="{StaticResource BrailleDotOutline}" />
        <Ellipse
            Grid.Row="1"
            Grid.Column="1"
            Style="{StaticResource BrailleDotOutline}" />
        <Ellipse
            Grid.Row="2"
            Grid.Column="1"
            Style="{StaticResource BrailleDotOutline}" />

        <!--  Fills overlay the outlines; their visibility follows the Dot1–Dot6 properties.  -->
        <Ellipse
            x:Name="Fill1"
            Grid.Row="0"
            Grid.Column="0"
            Style="{StaticResource BrailleDotFill}" />
        <Ellipse
            x:Name="Fill2"
            Grid.Row="1"
            Grid.Column="0"
            Style="{StaticResource BrailleDotFill}" />
        <Ellipse
            x:Name="Fill3"
            Grid.Row="2"
            Grid.Column="0"
            Style="{StaticResource BrailleDotFill}" />
        <Ellipse
            x:Name="Fill4"
            Grid.Row="0"
            Grid.Column="1"
            Style="{StaticResource BrailleDotFill}" />
        <Ellipse
            x:Name="Fill5"
            Grid.Row="1"
            Grid.Column="1"
            Style="{StaticResource BrailleDotFill}" />
        <Ellipse
            x:Name="Fill6"
            Grid.Row="2"
            Grid.Column="1"
            Style="{StaticResource BrailleDotFill}" />
    </Grid>
</UserControl>
