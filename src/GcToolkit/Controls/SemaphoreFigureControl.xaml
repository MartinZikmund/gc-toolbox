<UserControl
    x:Class="GcToolkit.Controls.SemaphoreFigureControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">

    <!--  Viewer-facing stick figure on a 100×100 design canvas; the arm groups pivot at the shoulders  -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="100" Height="100">

            <!--  Head  -->
            <Ellipse
                Canvas.Left="42.5"
                Canvas.Top="3"
                Width="15"
                Height="15"
                Fill="{ThemeResource TextFillColorPrimaryBrush}" />

            <!--  Torso  -->
            <Line
                Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                StrokeEndLineCap="Round"
                StrokeStartLineCap="Round"
                StrokeThickness="5"
                X1="50"
                X2="50"
                Y1="20"
                Y2="58" />

            <!--  Legs  -->
            <Line
                Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                StrokeEndLineCap="Round"
                StrokeStartLineCap="Round"
                StrokeThickness="5"
                X1="50"
                X2="40"
                Y1="56"
                Y2="84" />
            <Line
                Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                StrokeEndLineCap="Round"
                StrokeStartLineCap="Round"
                StrokeThickness="5"
                X1="50"
                X2="60"
                Y1="56"
                Y2="84" />

            <!--  Signaller's right arm (viewer's left); angle 0 = down, positive = clockwise  -->
            <Canvas Canvas.Left="46" Canvas.Top="26">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="RightArmRotation" />
                </Canvas.RenderTransform>
                <Line
                    Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                    StrokeEndLineCap="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="3.5"
                    X1="0"
                    X2="0"
                    Y1="0"
                    Y2="34" />
                <Polygon Fill="#E81123" Points="0,18 16,18 0,34" />
                <Polygon Fill="#FFD800" Points="16,18 16,34 0,34" />
            </Canvas>

            <!--  Signaller's left arm (viewer's right); flag mirrored to the other side of the pole  -->
            <Canvas Canvas.Left="54" Canvas.Top="26">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="LeftArmRotation" />
                </Canvas.RenderTransform>
                <Line
                    Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                    StrokeEndLineCap="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="3.5"
                    X1="0"
                    X2="0"
                    Y1="0"
                    Y2="34" />
                <Polygon Fill="#E81123" Points="0,18 -16,18 0,34" />
                <Polygon Fill="#FFD800" Points="-16,18 -16,34 0,34" />
            </Canvas>
        </Canvas>
    </Viewbox>
</UserControl>
