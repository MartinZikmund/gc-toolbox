<Project Sdk="Uno.Sdk">

    <PropertyGroup>
        <TargetFrameworks Condition="'$(SingleTargetFramework)' == ''">
            net10.0;
            net10.0-android;
            net10.0-ios;
            net10.0-windows10.0.26100;
            net10.0-desktop;
            net10.0-browserwasm;
        </TargetFrameworks>
        <TargetFrameworks Condition="'$(SingleTargetFramework)' != ''">$(SingleTargetFramework)</TargetFrameworks>

        <UnoSingleProject>true</UnoSingleProject>
        <OutputType>Library</OutputType>
        <!-- Ensures the .xr.xml files are generated in a proper layout folder -->
        <GenerateLibraryLayout>true</GenerateLibraryLayout>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- The 1,000,000 verified decimals of π ship inside the assembly so the Pi tool works fully offline. -->
        <Content Remove="Numbers\Pi\PiDecimals.txt" />
        <None Remove="Numbers\Pi\PiDecimals.txt" />
        <EmbeddedResource Include="Numbers\Pi\PiDecimals.txt" LogicalName="GcToolkit.Core.Numbers.Pi.PiDecimals.txt" />
        <!-- 1,000,000 decimals of e, gzip-compressed, for the Euler's number tool -->
        <EmbeddedResource Include="Numbers\EulerNumberDecimals.gz" LogicalName="GcToolkit.Core.Numbers.EulerNumberDecimals.gz" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MZikmund.Toolkit.WinUI" />
        <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
        <PackageReference Include="CommunityToolkit.WinUI.Converters" />
        <PackageReference Include="sqlite-net-e" />
        <PackageReference Include="SourceGear.sqlite3" />
    </ItemGroup>

</Project>
