<Project Sdk="Uno.Sdk">

    <PropertyGroup>
        <TargetFrameworks Condition="'$(SingleTargetFramework)' == ''">
            net10.0;
            net10.0-android;
            net10.0-ios;
            net10.0-windows10.0.26100;
            net10.0-desktop;
            net10.0-browserwasm;
        </TargetFrameworks>
        <TargetFrameworks Condition="'$(SingleTargetFramework)' != ''">$(SingleTargetFramework)</TargetFrameworks>

        <UnoSingleProject>true</UnoSingleProject>
        <OutputType>Library</OutputType>
        <!-- Ensures the .xr.xml files are generated in a proper layout folder -->
        <GenerateLibraryLayout>true</GenerateLibraryLayout>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- The 1,000,000 verified decimals of π ship inside the assembly so the Pi tool works fully offline. -->
        <Content Remove="Numbers\Pi\PiDecimals.txt" />
        <None Remove="Numbers\Pi\PiDecimals.txt" />
        <EmbeddedResource Include="Numbers\Pi\PiDecimals.txt" LogicalName="GcToolkit.Core.Numbers.Pi.PiDecimals.txt" />
        <!-- 1,000,000 decimals of e, gzip-compressed, for the Euler's number tool -->
        <EmbeddedResource Include="Numbers\EulerNumberDecimals.gz" LogicalName="GcToolkit.Core.Numbers.EulerNumberDecimals.gz" />
        <!-- Offline φ digits for the Golden ratio tool (1,000,000 decimals, gzipped) -->
        <EmbeddedResource Include="Numbers\GoldenRatio\GoldenRatioDigits.gz" LogicalName="GcToolkit.Core.Numbers.GoldenRatio.GoldenRatioDigits.gz" />
        <!-- Frequency-ordered English word list (gzipped) so the vanity-code decoder resolves 34448 -> DIGIT/EIGHT/FIGHT offline.
             WithCulture=false: a ".en." segment would make MSBuild treat this as a satellite resource. -->
        <EmbeddedResource Include="Ciphers\PhoneKeypadWords-en.gz" LogicalName="GcToolkit.Core.Ciphers.PhoneKeypadWords-en.gz" WithCulture="false" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MZikmund.Toolkit.WinUI" />
        <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
        <PackageReference Include="CommunityToolkit.WinUI.Converters" />
        <PackageReference Include="sqlite-net-e" />
        <PackageReference Include="SourceGear.sqlite3" />
    </ItemGroup>

    <!-- Same NU1605 pin as the head: Uno.Extensions.Hosting.WinUI resolves a newer BuildTools than the
         WindowsAppSDK graph picks here, and a transitive reference cannot be raised by CPM alone. -->
    <ItemGroup Condition="'$(IsWinAppSdk)' == 'true'">
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools" PrivateAssets="all" />
    </ItemGroup>

</Project>
