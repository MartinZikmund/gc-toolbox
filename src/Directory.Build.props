<Project>
    <!-- Local single-target builds: drop a gitignored `crosstargeting-override.props`
         next to this file setting <SingleTargetFramework> to one TFM to build/restore
         only that platform (no other platform's workload needed). The property is
         opt-in — only the cross-targeted Uno projects read it, so non-Uno single-target
         projects are unaffected. Imported early so csprojs see it. See AGENTS.md. -->
    <Import Project="$(MSBuildThisFileDirectory)crosstargeting-override.props"
            Condition="Exists('$(MSBuildThisFileDirectory)crosstargeting-override.props')" />

    <PropertyGroup>
        <Copyright>Martin Zikmund 2026</Copyright>
		<Author>Martin Zikmund</Author>

        <LangVersion>preview</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <WarningsAsErrors>True</WarningsAsErrors>

        <!-- Uno's XAML source generator stamps [UnconditionalSuppressMessage(IL2026/IL2111)]
             on nearly every generated member; on trimming builds (notably iOS Release, where
             ILLink runs at build time) the trimmer flags the redundant ones as IL2121
             "unused suppression" — thousands of them, all generated code we don't control.
             Mute the noise; genuine trim warnings (IL2026/IL2122) still surface. Remove once
             fixed upstream: https://github.com/unoplatform/uno/issues/23453 -->
        <NoWarn>$(NoWarn);IL2121</NoWarn>

        <UnoFeatures>
            SkiaRenderer;
            Hosting;
            Logging;
            Mvvm;
            Configuration;
            HttpRefit;
            Serialization;
            Localization;
        </UnoFeatures>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Nerdbank.GitVersioning" PrivateAssets="All" />
    </ItemGroup>

    <!-- AppChannel: Dev (default, local + main) or Prod (release/v* CI builds).
         Drives per-platform identity, display name, icon, and the in-app DEV banner.
         See docs/versioning.md for the full model. -->
    <PropertyGroup>
        <AppChannel Condition="'$(AppChannel)' == ''">Dev</AppChannel>
        <DefineConstants Condition="'$(AppChannel)' == 'Dev'">$(DefineConstants);APP_CHANNEL_DEV</DefineConstants>
    </PropertyGroup>
</Project>
