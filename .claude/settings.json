{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/format-on-edit.sh",
            "timeout": 60,
            "statusMessage": "Formatting C#/XAML…"
          }
        ]
      }
    ]
  }
}
